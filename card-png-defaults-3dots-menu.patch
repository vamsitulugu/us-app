 public/dashboard-widgets.js       |  42 +++++++++++++++++++++++++++---
 public/dashboard.js               |   6 ++---
 public/images/dashboard/hug.png   | Bin 0 -> 837064 bytes
 public/images/dashboard/hug.svg   |  18 -------------
 public/images/dashboard/miss.png  | Bin 0 -> 997582 bytes
 public/images/dashboard/miss.svg  |  17 ------------
 public/images/dashboard/touch.png | Bin 0 -> 847776 bytes
