 public/index.html                 |   8 +++---
 10 files changed, 63 insertions(+), 63 deletions(-)
 create mode 100644 public/images/dashboard/hug.png
 delete mode 100644 public/images/dashboard/hug.svg
 create mode 100644 public/images/dashboard/miss.png
 delete mode 100644 public/images/dashboard/miss.svg
 create mode 100644 public/images/dashboard/touch.png
 delete mode 100644 public/images/dashboard/touch.svg

diff --git a/public/dashboard-widgets.css b/public/dashboard-widgets.css
index ed4b166..bedab3e 100644
--- a/public/dashboard-widgets.css
+++ b/public/dashboard-widgets.css
@@ -33,6 +33,24 @@
 }
 .dh-edit:active { transform: scale(.9); }
 .dh-edit svg { width: 18px; height: 18px; }
+
+/* ── 3-dots menu ── */
+.dh-menu-pop {
+  position: absolute; top: 52px; right: 10px; z-index: 4;
+  min-width: 176px; padding: 6px; display: flex; flex-direction: column; gap: 2px;
+  border-radius: 14px; border: 1px solid rgba(255, 255, 255, .22);
+  background: rgba(30, 6, 22, .86);
+  -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
+  box-shadow: 0 10px 28px rgba(0, 0, 0, .45);
+}
+.dh-menu-item {
+  border: 0; background: none; text-align: left; cursor: pointer;
+  padding: 11px 12px; border-radius: 9px;
+  font: 600 13px var(--ff-sans); color: #fff;
+  -webkit-tap-highlight-color: transparent;
+}
+.dh-menu-item:active { background: rgba(255, 255, 255, .14); }
+.dh-menu-item:disabled { opacity: .38; pointer-events: none; }
 .dh-cap { max-width: calc(100% - 64px); }
 
 /* ── Events row ── */
diff --git a/public/dashboard-widgets.js b/public/dashboard-widgets.js
index cf36754..d265585 100644
--- a/public/dashboard-widgets.js
+++ b/public/dashboard-widgets.js
@@ -3,6 +3,7 @@
    DashWidgets.render()   events row · mood card · custom card photos
    DashWidgets.openMood() full-screen mood calendar (also logs today's mood)
    DashWidgets.openPhotos() 16:9 photo editor for the Hug/Touch/Miss card
+                          (opened from the card's 3-dots menu: set own image / use default)
 
    Data it reads/writes on the global state S (synced by the app):
      S.anniversary, S.myBday, S.ptBday, S.events, S.milestones   (read)
@@ -395,9 +396,9 @@ const DashWidgets = (() => {
   /* ───────────────────────── PHOTO EDITOR ───────────────────────── */
   const SLOTS = [
     ['idle', 'Idle', '/images/dashboard/idle.svg'],
-    ['hug', 'Hug', '/images/dashboard/hug.svg'],
-    ['touch', 'Touch', '/images/dashboard/touch.svg'],
-    ['miss', 'Miss You', '/images/dashboard/miss.svg'],
+    ['hug', 'Hug', '/images/dashboard/hug.png'],
+    ['touch', 'Touch', '/images/dashboard/touch.png'],
+    ['miss', 'Miss You', '/images/dashboard/miss.png'],
   ];
   const OUT_W = 1280, OUT_H = 720, MAX_Z = 4;
   let photoOv = null, ph = null;
@@ -707,7 +708,7 @@ const DashWidgets = (() => {
 
   function init() {
     hookLegacy();
-    const edit = $('dhEditBtn'); if (edit) edit.onclick = () => openPhotos(photoSlotForCard());
+    const edit = $('dhEditBtn'); if (edit) edit.onclick = e => { e.stopPropagation(); openMenu(); };
     const mood = $('dwMood');
     if (mood) { mood.onclick = openMood; mood.onkeydown = e => { if (e.target === mood && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openMood(); } }; }
     const ml = $('dwMoodLink'); if (ml) ml.onclick = openMood;
@@ -719,6 +720,39 @@ const DashWidgets = (() => {
     return on ? on.dataset.k : 'idle';
   }
 
+  /* ── 3-dots menu on the card: set own photo / use default ── */
+  let menuEl = null;
+  function closeMenu() {
+    if (menuEl) { menuEl.remove(); menuEl = null; }
+    const b = $('dhEditBtn'); if (b) b.setAttribute('aria-expanded', 'false');
+  }
+  function openMenu() {
+    if (!stateOK()) return;
+    const btn = $('dhEditBtn'), card = $('dhCard');
+    if (!btn || !card) return;
+    if (menuEl) { closeMenu(); return; }
+    const k = photoSlotForCard();
+    const hasCustom = !!(S.dashImgs && S.dashImgs[k]);
+    const menu = el('div', 'dh-menu-pop'); menu.setAttribute('role', 'menu');
+    const item = (label, fn, disabled) => {
+      const b = el('button', 'dh-menu-item', label); b.type = 'button'; b.setAttribute('role', 'menuitem');
+      if (disabled) b.disabled = true;
+      b.onclick = e => { e.stopPropagation(); closeMenu(); fn(); };
+      return b;
+    };
+    menu.append(
+      item('Set my own image', () => openPhotos(k)),
+      item('Use default image', () => { slot = k; resetSlot(); }, !hasCustom)
+    );
+    card.append(menu);
+    menuEl = menu;
+    btn.setAttribute('aria-expanded', 'true');
+  }
+  document.addEventListener('click', e => {
+    if (menuEl && !menuEl.contains(e.target) && e.target.closest && !e.target.closest('#dhEditBtn')) closeMenu();
+  });
+  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
+
   return { render, init, openMood, openPhotos };
 })();
 
diff --git a/public/dashboard.js b/public/dashboard.js
index 1233236..f42790f 100644
--- a/public/dashboard.js
+++ b/public/dashboard.js
@@ -5,9 +5,9 @@
                        sendHug / sendTouch / sendMissYou and the incoming
                        checks, then shows the matching image on the card.
 
-   Card images: /images/dashboard/{idle,hug,touch,miss}.svg (16:9).
-   To use generated artwork, replace those files or change the <img src>
-   values in the #dhCard markup in index.html.
+   Card images: /images/dashboard/idle.svg and {hug,touch,miss}.png (16:9).
+   These are the defaults. Each person can set their own picture for a card
+   from the 3-dots menu (see dashboard-widgets.js), or switch back to default.
 
    Needs globals from the main app: S, scheduleSave, setAvImg/setAvText.
    ══════════════════════════════════════════════════════════════ */
