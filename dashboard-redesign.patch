+++ b/public/dashboard-home.css
@@ -0,0 +1,121 @@
+/* ═══ Dashboard (Home) — structure from the travel-app reference, colours from the app theme ═══
+   Everything uses the app's CSS variables (--accent, --g1/--g2, --border, --white, --text2…),
+   so it follows whichever theme/accent the user picks. Scoped to #page-dashboard. */
+.main:has(#page-dashboard.active) .topbar { display: none; }
+.content:has(#page-dashboard.active) { padding: 0; overflow-x: hidden; }
+#page-dashboard.active { display: flex; flex-direction: column; min-height: 100%; }
+
+/* top "hero" area — accent glow fading into the app background */
+.dx-hero {
+  position: relative;
+  padding: calc(env(safe-area-inset-top, 0px) + 14px) 18px 50px;
+  background:
+    radial-gradient(110% 70% at 100% -10%, var(--accent-glow) 0%, transparent 62%),
+    linear-gradient(180deg, var(--accent-glow) 0%, transparent 100%);
+}
+.dx-hero-in, .dx-sheet-in { max-width: 520px; margin: 0 auto; }
+
+/* top row: logo (left) · profile image (right) */
+.dx-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
+.dx-logo { height: 40px; width: auto; display: block; filter: drop-shadow(0 0 8px var(--accent-glow)); }
+.dx-avbtn { border: 0; background: none; padding: 0; cursor: pointer; border-radius: 50%; }
+.dx-av {
+  width: 42px; height: 42px; border-radius: 50%; position: relative; overflow: hidden;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 15px; font-weight: 600; color: var(--white);
+  background: linear-gradient(135deg, var(--accent), var(--accent-d));
+  border: 2px solid var(--border2); box-shadow: 0 4px 14px var(--accent-glow);
+}
+
+.dx-greet { font-size: 14px; font-weight: 500; color: var(--text2); margin-bottom: 8px; }
+.dx-quote {
+  font-family: var(--ff-sans, Inter, system-ui, sans-serif);
+  font-size: clamp(25px, 7vw, 32px); font-weight: 600; line-height: 1.2; letter-spacing: -.5px;
+  color: var(--white); margin: 0 0 20px; text-wrap: balance;
+}
+.dx-quote em { font-family: var(--ff-serif, Georgia, serif); font-style: italic; font-weight: 400; color: var(--accent-l); }
+
+/* search + menu */
+.dx-searchrow { display: flex; gap: 10px; align-items: center; }
+.dx-search {
+  flex: 1; min-width: 0; height: 50px; border-radius: 999px; cursor: pointer; text-align: left;
+  display: flex; align-items: center; gap: 10px; padding: 0 18px;
+  background: var(--g2); border: 1px solid var(--border2); color: var(--text2);
+  font: inherit; font-size: 14px;
+  backdrop-filter: var(--blur-sm); -webkit-backdrop-filter: var(--blur-sm);
+}
+.dx-search svg, .dx-menu svg { width: 20px; height: 20px; flex-shrink: 0; }
+.dx-search span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.dx-menu {
+  display: none; width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0; cursor: pointer;
+  align-items: center; justify-content: center;
+  background: var(--g2); border: 1px solid var(--border2); color: var(--white);
+  backdrop-filter: var(--blur-sm); -webkit-backdrop-filter: var(--blur-sm);
+}
+@media (max-width: 700px) { .dx-menu { display: flex; } }
+
+/* shortcut buttons */
+.dx-chips {
+  display: flex; gap: 10px; margin: 18px -18px 0; padding: 4px 18px 6px;
+  overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity;
+}
+.dx-chips::-webkit-scrollbar { display: none; }
+.dx-chip {
+  flex: 0 0 auto; width: 68px; height: 74px; border-radius: 18px; cursor: pointer; scroll-snap-align: start;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
+  background: var(--g2); border: 1px solid var(--border2); color: var(--text);
+  font: inherit; font-size: 11.5px; font-weight: 500; transition: transform .15s ease, background .2s;
+}
+.dx-chip:active { transform: scale(.94); background: var(--g3); }
+.dx-chip svg { width: 22px; height: 22px; color: var(--accent-l); }
+
+/* bottom sheet */
+.dx-sheet {
+  position: relative; flex: 1; margin-top: -28px;
+  border-radius: 28px 28px 0 0; padding: 22px 18px calc(110px + env(safe-area-inset-bottom, 0px));
+  background: linear-gradient(180deg, #181818, #0d0d0d);
+  border: 1px solid var(--border); border-bottom: 0;
+  box-shadow: 0 -10px 34px rgba(0, 0, 0, .45);
+}
+.dx-sheet::before { content: ''; display: block; width: 40px; height: 4px; border-radius: 4px; background: var(--border2); margin: -8px auto 16px; }
+.dx-sec { margin-bottom: 14px; }
+.dx-sec h3 { margin: 0; font-size: 18px; font-weight: 600; color: var(--white); font-family: var(--ff-sans, Inter, system-ui, sans-serif); }
+.dx-sec p { margin: 3px 0 0; font-size: 12.5px; color: var(--text3); }
+
+/* 16:9 image card */
+.dx-stage {
+  position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 22px; overflow: hidden;
+  background: linear-gradient(135deg, var(--accent-glow), var(--accent2-glow));
+  border: 1px solid var(--border2); box-shadow: 0 14px 34px rgba(0, 0, 0, .45);
+}
+.dx-slide {
+  position: absolute; inset: 0; opacity: 0; transform: scale(1.04); pointer-events: none;
+  transition: opacity .45s ease, transform .6s ease; display: flex; align-items: center; justify-content: center;
+}
+.dx-slide.on { opacity: 1; transform: scale(1); }
+.dx-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+.dx-slide .dx-ph { font-size: 64px; filter: drop-shadow(0 6px 10px rgba(0, 0, 0, .35)); }
+.dx-slide img:not([hidden]) ~ .dx-ph { display: none; }
+.dx-tag {
+  position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px;
+  background: rgba(0, 0, 0, .5); color: #fff; font-size: 12.5px; font-weight: 600;
+  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
+}
+
+/* 3 buttons */
+.dx-acts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; }
+.dx-act {
+  height: 62px; border-radius: 18px; cursor: pointer; font: inherit; font-size: 13px; font-weight: 600;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
+  background: var(--g1); border: 1px solid var(--border2); color: var(--text);
+  transition: transform .15s ease, background .2s, box-shadow .2s;
+}
+.dx-act .dx-ico { font-size: 22px; line-height: 1; }
+.dx-act:active { transform: scale(.95); }
+.dx-act.on {
+  background: linear-gradient(135deg, var(--accent), var(--accent-d)); border-color: transparent; color: #fff;
+  box-shadow: 0 8px 20px var(--accent-glow);
+}
+.dx-act.cc-sent { animation: dxPop .6s ease; }
+@keyframes dxPop { 0% { transform: scale(1); } 30% { transform: scale(1.09); } 100% { transform: scale(1); } }
+@media (prefers-reduced-motion: reduce) { .dx-slide, .dx-act { transition: none; animation: none; } }
diff --git a/public/dashboard-home.js b/public/dashboard-home.js
new file mode 100644
index 0000000..b04f0a5
--- /dev/null
+++ b/public/dashboard-home.js
@@ -0,0 +1,69 @@
+/* Dashboard (Home) redesign — hero greeting/quote + love-image card.
+   Tap Hug / Miss You / Touch -> existing ConnCard send logic runs AND the
+   matching image shows. Images go in /public/images/dashboard/{hug,miss,touch}.png */
+(function () {
+  const QUOTES = [
+    ['Distance means so little when ', 'someone', ' means so much'],
+    ['Every day with you is my ', 'favorite', ' day'],
+    ['Miles apart, but always ', 'close', ' at heart'],
+    ['Wherever you are, my ', 'heart', ' is home'],
+    ['Two hearts, one ', 'story', ''],
+    ['Love grows ', 'stronger', ' across every mile'],
+    ['You are my favorite ', 'notification', ''],
+    ['Together is a ', 'feeling', ', not a place'],
+    ['Close your eyes, I am ', 'right here', ''],
+    ['Every moment with you is a ', 'memory', ' in the making']
+  ];
+  const SEND = { hug: 'sendHug', miss: 'sendMissYou', touch: 'sendTouch' };
+
+  function greeting() {
+    const h = new Date().getHours();
+    return h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
+  }
+
+  function renderDashHero() {
+    const g = document.getElementById('dxGreet');
+    const q = document.getElementById('dxQuote');
+    if (!g || !q) return;
+    const name = (window.S && S.myName) ? S.myName : 'love';
+    g.textContent = greeting() + ', ' + name + ' 💕';
+    if (typeof setAvImg === 'function' && window.S) { try { setAvImg('dxAv', S.myAvatar || ''); } catch (_) {} }
+    const day = Math.floor(Date.now() / 86400000);
+    const [pre, accent, post] = QUOTES[day % QUOTES.length];
+    q.textContent = '';
+    q.append(document.createTextNode(pre));
+    const em = document.createElement('em'); em.textContent = accent; q.append(em);
+    if (post) q.append(document.createTextNode(post));
+  }
+
+  function show(type) {
+    document.querySelectorAll('#dxStage .dx-slide').forEach(s => s.classList.toggle('on', s.dataset.type === type));
+    document.querySelectorAll('#dxActs .dx-act').forEach(b => {
+      const on = b.dataset.type === type;
+      b.classList.toggle('on', on);
+      b.setAttribute('aria-pressed', on ? 'true' : 'false');
+    });
+  }
+
+  function tap(type) {
+    show(type);
+    try {
+      if (typeof ConnCard !== 'undefined' && ConnCard[SEND[type]]) ConnCard[SEND[type]]();
+    } catch (e) { console.warn('[dash] send failed', e); }
+  }
+
+  // image fallback: if the PNG isn't there yet, keep the emoji placeholder
+  function wireImages() {
+    document.querySelectorAll('#dxStage .dx-slide img').forEach(img => {
+      img.addEventListener('error', () => { img.hidden = true; });
+      img.addEventListener('load', () => { img.hidden = false; });
+    });
+  }
+
+  window.renderDashHero = renderDashHero;
+  window.DashLove = { tap, show };
+
+  function init() { wireImages(); renderDashHero(); show('hug'); }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
+  else init();
+})();
