new file mode 100644
index 0000000..5b88005
--- /dev/null
+++ b/public/dashboard.css
@@ -0,0 +1,288 @@
+/* ══════════════════════════════════════════════════════════════
+   DASHBOARD — layout + styles for #page-dashboard
+   Colours come only from the app theme variables (--accent*, --ff-*).
+   Mobile (<=700px): full-bleed gradient hero + rounded bottom sheet.
+   Laptop (>=701px): one rounded panel; two columns from 1000px.
+   ══════════════════════════════════════════════════════════════ */
+
+/* The dashboard is full-bleed: drop the global top bar and page padding. */
+.main:has(#page-dashboard.active) > .topbar { display: none; }
+.content:has(#page-dashboard.active) {
+  padding: 0 !important;
+  display: flex;
+  flex-direction: column;
+}
+#page-dashboard.active { display: flex; flex-direction: column; flex: 1 0 auto; }
+
+.dh {
+  --pad: 18px;
+  position: relative;
+  flex: 1;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: auto auto 1fr;
+  grid-template-areas: "top" "intro" "sheet";
+  width: 100%;
+  min-width: 0;
+}
+
+/* Gradient backdrop behind the header + intro (and, on laptop, everything) */
+.dh-bg {
+  grid-row: 1 / 3;
+  grid-column: 1;
+  z-index: 0;
+  background:
+    radial-gradient(90% 60% at 85% 0%, rgba(255, 107, 93, .38), transparent 62%),
+    linear-gradient(170deg, var(--accent) 0%, var(--accent-d) 62%, #4a0610 100%);
+}
+
+/* ── Header: logo left, profile right ── */
+.dh-top {
+  grid-area: top;
+  z-index: 1;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: calc(env(safe-area-inset-top, 0px) + 14px) var(--pad) 6px;
+}
+.dh-brand { display: flex; align-items: center; gap: 9px; min-width: 0; }
+.dh-brand img { width: 38px; height: 38px; border-radius: 11px; display: block; flex-shrink: 0; }
+.dh-brand span {
+  font-family: var(--ff-serif);
+  font-size: 20px;
+  color: #fff;
+  letter-spacing: -.3px;
+  white-space: nowrap;
+}
+.dh-profile {
+  position: relative;
+  width: 44px; height: 44px;
+  border-radius: 50%;
+  overflow: hidden;
+  padding: 0;
+  flex-shrink: 0;
+  display: flex; align-items: center; justify-content: center;
+  background: rgba(255, 255, 255, .16);
+  border: 2px solid rgba(255, 255, 255, .55);
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* ── Intro: greeting, quote, search, shortcuts ── */
+.dh-intro {
+  grid-area: intro;
+  z-index: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  padding: 10px var(--pad) 50px;
+  min-width: 0;
+}
+.dh-greet { margin: 0; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, .88); }
+.dh-quote {
+  margin: 0;
+  font-family: var(--ff-sans);
+  font-size: clamp(27px, 7.4vw, 34px);
+  font-weight: 650;
+  line-height: 1.16;
+  letter-spacing: -.6px;
+  color: #fff;
+  text-wrap: balance;
+}
+.dh-quote em { font-family: var(--ff-serif); font-style: italic; font-weight: 400; color: #ffc4b8; }
+
+.dh-search-row { display: flex; gap: 10px; }
+.dh-search, .dh-menu {
+  height: 52px;
+  border-radius: 26px;
+  border: 1px solid rgba(255, 255, 255, .28);
+  background: rgba(255, 255, 255, .15);
+  -webkit-backdrop-filter: blur(16px) saturate(160%);
+  backdrop-filter: blur(16px) saturate(160%);
+  color: #fff;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+.dh-search {
+  flex: 1; min-width: 0;
+  display: flex; align-items: center; gap: 10px;
+  padding: 0 18px;
+  font: 500 14px var(--ff-sans);
+  color: rgba(255, 255, 255, .82);
+  text-align: left;
+}
+.dh-search span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.dh-menu { width: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
+.dh svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
+
+.dh-chips {
+  display: flex;
+  gap: 10px;
+  overflow-x: auto;
+  margin: 0 calc(var(--pad) * -1);
+  padding: 2px var(--pad) 2px;
+  scroll-snap-type: x proximity;
+  scroll-padding: 0 var(--pad);
+  scrollbar-width: none;
+}
+.dh-chips::-webkit-scrollbar { display: none; }
+.dh-chip {
+  flex: 0 0 auto;
+  width: 74px; height: 78px;
+  scroll-snap-align: start;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
+  border-radius: 20px;
+  border: 1px solid rgba(255, 255, 255, .24);
+  background: rgba(255, 255, 255, .13);
+  -webkit-backdrop-filter: blur(14px);
+  backdrop-filter: blur(14px);
+  color: #fff;
+  font: 600 11px var(--ff-sans);
+  letter-spacing: -.1px;
+  white-space: nowrap;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform .18s ease, background .18s ease;
+}
+.dh-chip svg { width: 23px; height: 23px; }
+.dh-chip:active { transform: scale(.94); }
+.dh-chip.is-primary { background: #fff; border-color: #fff; color: var(--accent-d); }
+
+/* ── Sheet with the love card ── */
+.dh-sheet {
+  grid-area: sheet;
+  z-index: 2;
+  margin-top: -30px;
+  padding: 22px var(--pad) calc(112px + env(safe-area-inset-bottom, 0px));
+  border-radius: 30px 30px 0 0;
+  background: rgba(16, 11, 20, .94);
+  -webkit-backdrop-filter: blur(22px);
+  backdrop-filter: blur(22px);
+  border-top: 1px solid rgba(255, 255, 255, .13);
+  box-shadow: 0 -14px 40px rgba(0, 0, 0, .35);
+}
+.dh-sheet-title { margin: 0 0 14px; font-size: 17px; font-weight: 600; color: var(--white); }
+
+/* ── 16:9 card ── */
+.dh-card {
+  position: relative;
+  aspect-ratio: 16 / 9;
+  width: 100%;
+  border-radius: 24px;
+  overflow: hidden;
+  isolation: isolate;
+  background: #1a0b10;
+  border: 1px solid rgba(255, 255, 255, .14);
+  box-shadow: 0 18px 40px rgba(0, 0, 0, .45);
+}
+.dh-img {
+  position: absolute; inset: 0;
+  width: 100%; height: 100%;
+  object-fit: cover;
+  opacity: 0;
+  transform: scale(1.05);
+  transition: opacity .5s ease, transform .9s ease;
+}
+.dh-img.is-on { opacity: 1; transform: scale(1); }
+.dh-shade {
+  position: absolute; inset: 0;
+  pointer-events: none;
+  background:
+    linear-gradient(to top, rgba(0, 0, 0, .74) 0%, rgba(0, 0, 0, .22) 40%, transparent 64%),
+    linear-gradient(to bottom, rgba(0, 0, 0, .32), transparent 26%);
+}
+.dh-cap {
+  position: absolute; top: 12px; left: 12px;
+  max-width: calc(100% - 24px);
+  padding: 7px 12px;
+  border-radius: 99px;
+  background: rgba(0, 0, 0, .34);
+  border: 1px solid rgba(255, 255, 255, .2);
+  -webkit-backdrop-filter: blur(10px);
+  backdrop-filter: blur(10px);
+  color: #fff;
+  font: 600 12px var(--ff-sans);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+.dh-actions {
+  position: absolute; left: 12px; right: 12px; bottom: 12px;
+  display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
+}
+.dh-act {
+  height: 46px;
+  min-width: 0;
+  display: flex; align-items: center; justify-content: center; gap: 6px;
+  border-radius: 16px;
+  border: 1px solid rgba(255, 255, 255, .3);
+  background: rgba(255, 255, 255, .17);
+  -webkit-backdrop-filter: blur(14px) saturate(160%);
+  backdrop-filter: blur(14px) saturate(160%);
+  color: #fff;
+  font: 600 13px var(--ff-sans);
+  white-space: nowrap;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform .15s ease, background .2s ease, color .2s ease;
+}
+.dh-act:active, .dh-act.is-sent { transform: scale(.94); }
+.dh-act.is-active { background: #fff; border-color: #fff; color: var(--accent-d); }
+
+/* ── Small phones ── */
+@media (max-width: 360px) {
+  .dh { --pad: 14px; }
+  .dh-act { font-size: 12px; gap: 4px; }
+  .dh-brand span { font-size: 18px; }
+}
+
+/* ── Laptop / tablet: one rounded panel ── */
+@media (min-width: 701px) {
+  .dh { --pad: 28px; max-width: 1180px; margin: 0 auto; padding: 22px 24px 24px; grid-template-rows: auto auto 1fr; }
+  .dh-bg { grid-row: 1 / -1; border-radius: 34px; }
+  .dh-top { padding: 22px var(--pad) 0; }
+  .dh-intro { padding-bottom: 28px; }
+  .dh-menu { display: none; }              /* sidebar is always visible here */
+  .dh-quote { font-size: clamp(30px, 3.4vw, 46px); }
+  .dh-chips { margin: 0; padding: 2px 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; }
+  .dh-chip { width: auto; height: 84px; }
+  .dh-sheet {
+    margin: 0 var(--pad) var(--pad);
+    padding: 20px;
+    border-radius: 28px;
+    background: rgba(10, 5, 12, .42);
+    border: 1px solid rgba(255, 255, 255, .16);
+    box-shadow: none;
+  }
+  .dh-act { height: 50px; font-size: 14px; }
+}
+
+@media (min-width: 861px) {
+  .dh-chips { grid-template-columns: repeat(6, minmax(0, 1fr)); }
+}
+
+@media (min-width: 1000px) {
+  .dh {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
+    grid-template-areas: "top top" "intro sheet";
+    grid-template-rows: auto 1fr;
+    column-gap: 12px;
+  }
+  .dh-bg { grid-column: 1 / -1; }
+  .dh-intro { align-self: center; padding: 0 var(--pad) 36px; max-width: 520px; }
+  .dh-sheet { align-self: center; margin: 0 var(--pad) 36px 0; }
+}
+
+/* ── Short phones (e.g. 360x640, iPhone SE): keep the card above the bottom nav ── */
+@media (max-width: 700px) and (max-height: 700px) {
+  .dh-top { padding-top: calc(env(safe-area-inset-top, 0px) + 8px); }
+  .dh-intro { gap: 10px; padding-bottom: 40px; }
+  .dh-quote { font-size: 24px; }
+  .dh-search, .dh-menu { height: 46px; }
+  .dh-chip { height: 62px; gap: 5px; }
+  .dh-chip svg { width: 20px; height: 20px; }
+  .dh-sheet { padding-top: 16px; }
+  .dh-sheet-title { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .dh-img, .dh-chip, .dh-act { transition: none; }
+}
diff --git a/public/dashboard.js b/public/dashboard.js
new file mode 100644
index 0000000..17b71d9
--- /dev/null
+++ b/public/dashboard.js
@@ -0,0 +1,177 @@
+/* ══════════════════════════════════════════════════════════════
+   DASHBOARD — behaviour for #page-dashboard (markup is in index.html)
+   Dashboard.render()  greeting, daily quote, profile avatar, love card
+   ConnCard            Hug / Touch / Miss You buttons. Wraps the app's
+                       sendHug / sendTouch / sendMissYou and the incoming
+                       checks, then shows the matching image on the card.
+
+   Card images: /images/dashboard/{idle,hug,touch,miss}.svg (16:9).
+   To use generated artwork, replace those files or change the <img src>
+   values in the #dhCard markup in index.html.
+
+   Needs globals from the main app: S, scheduleSave, setAvImg/setAvText.
+   ══════════════════════════════════════════════════════════════ */
+'use strict';
+
+const Dashboard = (() => {
+  // [before, highlighted word, after] — one per day, no network.
+  const QUOTES = [
+    ['Distance means so little when someone means ', 'everything', '.'],
+    ['Every day with you is my favourite ', 'memory', '.'],
+    ['Home is wherever I am with ', 'you', '.'],
+    ['Miles apart, but always ', 'together', '.'],
+    ['You are my today and all of my ', 'tomorrows', '.'],
+    ['Love grows stronger with every ', 'heartbeat', '.'],
+    ['Two hearts, one ', 'story', '.'],
+  ];
+
+  function greeting() {
+    const h = new Date().getHours();
+    return h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : h < 21 ? 'Good evening' : 'Good night';
+  }
+
+  function renderHero() {
+    const g = document.getElementById('dhGreet');
+    if (g) {
+      const name = window.S && S.myName ? ', ' + S.myName : '';
+      g.textContent = greeting() + name + ' 👋';
+    }
+    const q = document.getElementById('dhQuote');
+    if (q) {
+      const day = Math.floor(Date.now() / 86400000);
+      const [before, word, after] = QUOTES[day % QUOTES.length];
+      const em = document.createElement('em');
+      em.textContent = word;
+      q.replaceChildren(before, em, after);
+    }
+    if (typeof setAvImg === 'function') setAvImg('dashAv', window.S && S.myAvatar);
+  }
+
+  function render() { renderHero(); ConnCard.render(); }
+  return { render };
+})();
+
+const ConnCard = (() => {
+  // img = which card image to show; btn = button element id
+  const KINDS = {
+    hug:     { fn: 'sendHug',     check: 'checkIncomingHug',     btn: 'ccHugBtn',   img: 'hug',   label: 'Hug',      emoji: '🤗' },
+    touch:   { fn: 'sendTouch',   check: 'checkIncomingTouch',   btn: 'ccTouchBtn', img: 'touch', label: 'Touch',    emoji: '❤️' },
+    missyou: { fn: 'sendMissYou', check: 'checkIncomingMissYou', btn: 'ccMissBtn',  img: 'miss',  label: 'Miss You', emoji: '🥺' },
+  };
+
+  // How each incoming check tells that something NEW arrived from the partner.
+  const INCOMING = {
+    touch:   { snap: () => S.touch && S.touch.ts,        hit: b => S.touch && S.touch.from !== S.role && S.touch.ts !== b },
+    missyou: { snap: () => S.missYou && S.missYou.ts,    hit: b => S.missYou && S.missYou.from !== S.role && S.missYou.ts !== b },
+    hug:     { snap: () => S.hug && S.hug.acceptedTs,    hit: b => S.hug && S.hug.status === 'accepted' && S.hug.acceptedTs !== b },
+  };
+
+  const originals = {};   // kind -> app's original send function
+  const checks = {};      // kind -> app's original incoming check
+
+  function fmtAgo(ts) {
+    if (!ts) return '';
+    const s = Math.floor((Date.now() - ts) / 1000);
+    if (s < 10) return 'just now';
+    if (s < 60) return s + 's ago';
+    const m = Math.floor(s / 60);
+    if (m < 60) return m + 'm ago';
+    const h = Math.floor(m / 60);
+    return h < 24 ? h + 'h ago' : Math.floor(h / 24) + 'd ago';
+  }
+
+  function send(kind) {
+    const k = KINDS[kind];
+    const fn = originals[kind] || (typeof window[k.fn] === 'function' && !window[k.fn]._ccWrapped ? window[k.fn] : null);
+    if (!fn || !window.S) return;                        // app not ready yet
+    fn();
+    S.lastInteraction = { type: kind, from: S.role, ts: Date.now() };
+    const btn = document.getElementById(k.btn);
+    if (btn) {
+      btn.classList.add('is-sent');
+      setTimeout(() => btn.classList.remove('is-sent'), 650);
+    }
+    scheduleSave();
+    render();
+  }
+
+  function received(kind) {
+    S.lastInteraction = { type: kind, from: S.role === 'user1' ? 'user2' : 'user1', ts: Date.now() };
+    S.lastReceivedInteraction = { type: kind, ts: Date.now() };
+    render();
+  }
+
+  function render() {
+    if (!window.S) return;
+    const li = S.lastInteraction;
+    const k = li && KINDS[li.type];
+
+    const showImg = k ? k.img : 'idle';
+    document.querySelectorAll('#dhCard .dh-img').forEach(el => el.classList.toggle('is-on', el.dataset.k === showImg));
+
+    const cap = document.getElementById('dhCaption');
+    if (cap) {
+      cap.textContent = k
+        ? `${k.emoji} ${k.label} ${li.from === S.role ? 'sent' : 'received'} · ${fmtAgo(li.ts)}`
+        : 'Send some love 💕';
+    }
+    Object.entries(KINDS).forEach(([kind, def]) => {
+      document.getElementById(def.btn)?.classList.toggle('is-active', !!k && li.type === kind);
+    });
+  }
+
+  // The app defines sendHug etc. later in index.html, so wrap them once they exist.
+  function hook() {
+    Object.entries(KINDS).forEach(([kind, def]) => {
+      if (typeof window[def.fn] === 'function' && !window[def.fn]._ccWrapped) {
+        originals[kind] = window[def.fn];
+        window[def.fn] = () => send(kind);
+        window[def.fn]._ccWrapped = true;
+      }
+      if (typeof window[def.check] === 'function' && !window[def.check]._ccWrapped) {
+        checks[kind] = window[def.check];
+        const inc = INCOMING[kind];
+        window[def.check] = function () {
+          const before = inc.snap();
+          checks[kind]();
+          if (inc.hit(before)) received(kind);
+        };
+        window[def.check]._ccWrapped = true;
+      }
+    });
+  }
+
+  function init() {
+    let tries = 0;
+    const iv = setInterval(() => {
+      hook();
+      render();
+      const ready = Object.keys(KINDS).every(kind => originals[kind] && checks[kind]);
+      if (ready || ++tries > 30) clearInterval(iv);
+    }, 300);
+    // keep the "2m ago" caption fresh while the tab is open
+    setInterval(() => { if (!document.hidden) render(); }, 30000);
+  }
+
+  return {
+    sendHug: () => send('hug'),
+    sendTouch: () => send('touch'),
+    sendMissYou: () => send('missyou'),
+    render,
+    init,
+  };
+})();
+
+// top-level const is not a window property; index.html's renderDashboard() looks it up there
+window.Dashboard = Dashboard;
+window.ConnCard = ConnCard;
+
+(function autoInit() {
+  const start = () => {
+    if (typeof window.S === 'undefined') return setTimeout(start, 400);
+    Dashboard.render();
+    ConnCard.init();
+  };
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(start, 600));
+  else setTimeout(start, 600);
+})();
