new file mode 100644
index 0000000..ea6d5eb
--- /dev/null
+++ b/public/dashboard-home.css
@@ -0,0 +1,114 @@
+/* ═══ Dashboard (Home) redesign — blue hero + white sheet ═══
+   Scoped to #page-dashboard. Legacy widgets live (hidden) in #dashLegacy. */
+.main:has(#page-dashboard.active) .topbar { display: none; }
+.content:has(#page-dashboard.active) { padding: 0; overflow-x: hidden; }
+
+#page-dashboard.active { display: flex; flex-direction: column; min-height: 100%; background: #fff; }
+
+.dx-hero {
+  position: relative;
+  padding: calc(env(safe-area-inset-top, 0px) + 22px) 18px 52px;
+  background:
+    radial-gradient(120% 60% at 85% -10%, rgba(255,255,255,.35) 0%, transparent 60%),
+    radial-gradient(90% 50% at 0% 100%, rgba(255,255,255,.22) 0%, transparent 65%),
+    linear-gradient(180deg, #2b84f2 0%, #4a9dfb 55%, #86c0ff 100%);
+  color: #fff;
+}
+.dx-hero-in, .dx-sheet-in { max-width: 520px; margin: 0 auto; }
+
+.dx-greet { font-size: 14px; font-weight: 500; opacity: .95; margin-bottom: 8px; }
+.dx-quote {
+  font-family: var(--ff-sans, Inter, system-ui, sans-serif);
+  font-size: clamp(26px, 7.2vw, 34px);
+  font-weight: 600; line-height: 1.18; letter-spacing: -.5px;
+  margin: 0 0 20px; text-wrap: balance;
+}
+.dx-quote em {
+  font-family: var(--ff-serif, Georgia, serif);
+  font-style: italic; font-weight: 400; color: #ffe66d;
+}
+
+.dx-searchrow { display: flex; gap: 10px; align-items: center; }
+.dx-search {
+  flex: 1; min-width: 0; height: 50px; border: 0; border-radius: 999px;
+  background: #fff; color: #7b8aa0; font: inherit; font-size: 14px;
+  display: flex; align-items: center; gap: 10px; padding: 0 18px; cursor: pointer;
+  box-shadow: 0 6px 18px rgba(20,80,170,.18); text-align: left;
+}
+.dx-search svg, .dx-menu svg { width: 20px; height: 20px; flex-shrink: 0; }
+.dx-search span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.dx-menu {
+  width: 50px; height: 50px; border-radius: 50%; border: 0; cursor: pointer;
+  background: #fff; color: #2b84f2; display: none; align-items: center; justify-content: center;
+  box-shadow: 0 6px 18px rgba(20,80,170,.18); flex-shrink: 0;
+}
+@media (max-width: 700px) { .dx-menu { display: flex; } }
+
+/* quick shortcuts */
+.dx-chips {
+  display: flex; gap: 10px; margin: 18px -18px 0; padding: 4px 18px 6px;
+  overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity;
+}
+.dx-chips::-webkit-scrollbar { display: none; }
+.dx-chip {
+  flex: 0 0 auto; width: 68px; height: 74px; border: 0; border-radius: 18px; cursor: pointer;
+  background: rgba(255,255,255,.92); color: #1b3a63; font: inherit; font-size: 11.5px; font-weight: 500;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
+  box-shadow: 0 6px 16px rgba(20,80,170,.14); scroll-snap-align: start;
+  transition: transform .15s ease;
+}
+.dx-chip:active { transform: scale(.94); }
+.dx-chip svg { width: 22px; height: 22px; color: #2b84f2; }
+
+/* white sheet */
+.dx-sheet {
+  position: relative; flex: 1; margin-top: -28px; background: #fff;
+  border-radius: 28px 28px 0 0; padding: 22px 18px calc(110px + env(safe-area-inset-bottom, 0px));
+  box-shadow: 0 -8px 30px rgba(20,80,170,.10);
+}
+.dx-sheet::before {
+  content: ''; display: block; width: 40px; height: 4px; border-radius: 4px;
+  background: #d9e3f1; margin: -8px auto 16px;
+}
+.dx-sec { margin-bottom: 14px; }
+.dx-sec h3 { margin: 0; font-size: 18px; font-weight: 600; color: #0f2540; font-family: var(--ff-sans, Inter, system-ui, sans-serif); }
+.dx-sec p { margin: 3px 0 0; font-size: 12.5px; color: #6b7f99; }
+
+.dx-stage {
+  position: relative; width: 100%; aspect-ratio: 4 / 4.4; max-height: 56vh;
+  border-radius: 26px; overflow: hidden; background: #e8f2ff;
+  box-shadow: 0 14px 34px rgba(30,100,200,.18);
+}
+.dx-slide {
+  position: absolute; inset: 0; opacity: 0; transform: scale(1.04);
+  transition: opacity .45s ease, transform .6s ease; pointer-events: none;
+  display: flex; align-items: center; justify-content: center;
+  background: linear-gradient(160deg, #cfe5ff, #eaf4ff);
+}
+.dx-slide.on { opacity: 1; transform: scale(1); }
+.dx-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+.dx-slide .dx-ph { font-size: 76px; filter: drop-shadow(0 6px 10px rgba(30,100,200,.25)); }
+.dx-slide img:not([hidden]) ~ .dx-ph { display: none; }
+.dx-tag {
+  position: absolute; left: 14px; bottom: 14px; padding: 8px 14px; border-radius: 999px;
+  background: rgba(255,255,255,.9); color: #0f2540; font-size: 13px; font-weight: 600;
+  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
+}
+
+.dx-acts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; }
+.dx-act {
+  height: 62px; border-radius: 20px; border: 1.5px solid #dbe8fb; background: #f5f9ff; color: #1b3a63;
+  font: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
+  transition: transform .15s ease, background .2s, color .2s, box-shadow .2s;
+  -webkit-tap-highlight-color: transparent;
+}
+.dx-act .dx-ico { font-size: 22px; line-height: 1; }
+.dx-act:active { transform: scale(.95); }
+.dx-act.on {
+  background: linear-gradient(135deg, #3b92fb, #1f6fe0); border-color: transparent; color: #fff;
+  box-shadow: 0 8px 20px rgba(31,111,224,.35);
+}
+.dx-act.cc-sent { animation: dxPop .6s ease; }
+@keyframes dxPop { 0% { transform: scale(1); } 30% { transform: scale(1.09); } 100% { transform: scale(1); } }
+@media (prefers-reduced-motion: reduce) { .dx-slide, .dx-act { transition: none; animation: none; } }
