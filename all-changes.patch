-          <div class="gcard-emoji">${g.emoji}</div>
+        <div class="gcard-art has-img" style="background:${g.grad}">
+          <img class="gcard-img" src="/images/games/${g.id}.webp" alt="${g.title}" loading="lazy" draggable="false" onerror="this.remove();this.parentNode&&this.parentNode.classList.remove('has-img')">
           <div class="gcard-badges">${g.badge==='new'?'<span class="gbadge new">New</span>':''}${g.badge==='trend'?'<span class="gbadge trend">🔥 Trending</span>':''}</div>
           <div class="gfav ${isFav?'on':''}" onclick="event.stopPropagation();Hub.toggleFav('${g.id}',this)">${isFav?'❤️':'🤍'}</div>
           ${live?`<div class="gcard-live"><span class="dot" style="width:5px;height:5px;border-radius:50%;background:#7cffcf;animation:blk 1.2s infinite"></span>${esc(ID.partnerName)} is playing</div>`:''}
