diff --git a/public/bars-fix.css b/public/bars-fix.css
new file mode 100644
index 0000000..f0b363a
--- /dev/null
+++ b/public/bars-fix.css
@@ -0,0 +1,19 @@
+/* Bars fix (mobile / APK)
+   1) Dark theme, Home page: the strip behind the phone status bar (time, signal,
+      battery) now uses the hero colour, exactly like the light theme. On every other
+      page it stays the normal dark page colour.
+   2) A small black strip sits behind the phone's gesture / navigation area, under the
+      floating bottom nav. It is exactly as tall as the system inset (0 in a normal
+      browser, so nothing shows there) and never blocks taps. */
+html[data-theme="dark"] body:has(#page-dashboard.active)::before { background: #6B093A; }
+
+body::after {
+  content: '';
+  position: fixed; left: 0; right: 0; bottom: 0;
+  width: calc(100% - 24px); max-width: 440px; margin: 0 auto;   /* same width as the bottom nav */
+  height: env(safe-area-inset-bottom, 0px);
+  border-radius: 999px;                                          /* curved ends, like the bottom nav */
+  background: #000;
+  pointer-events: none;
+  z-index: 2147482000;
+}
diff --git a/public/dashboard-burgundy.css b/public/dashboard-burgundy.css
index 7de67f1..184bcb9 100644
--- a/public/dashboard-burgundy.css
+++ b/public/dashboard-burgundy.css
@@ -55,3 +55,7 @@ html[data-theme] .dw-ev.is-today .dw-ev-d { color: var(--dh-burgundy) !important
 /* ── Home bottom page groups: 4 per row ── */
 .dw-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
 @media (min-width: 701px) { .dw-grid { grid-template-columns: repeat(4, minmax(88px, 112px)) !important; } }
+
+/* Home page groups with 5 buttons (Us, Explore Together): 5 in one row */
+.dw-grid.dw-grid-5 { grid-template-columns: repeat(5, minmax(0, 1fr)) !important; }
+@media (min-width: 701px) { .dw-grid.dw-grid-5 { grid-template-columns: repeat(5, minmax(88px, 112px)) !important; } }
