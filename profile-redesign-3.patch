diff --git a/public/profile.css b/public/profile.css
new file mode 100644
index 0000000..932f39d
--- /dev/null
+++ b/public/profile.css
@@ -0,0 +1,366 @@
+/* ══════════════════════════════════════════════════════════════
+   PROFILE PAGE — styles for #page-profile  (logic: /profile.js)
+   Native-app layout: full-bleed header, tappable tiles, list rows,
+   bottom-sheet editors. Colours come only from the app theme
+   variables (--accent*, --border*, --text*, --ff-*).
+   ══════════════════════════════════════════════════════════════ */
+
+/* Own header instead of the global top bar; page padding handled here */
+.main:has(#page-profile.active) > .topbar { display: none; }
+.content:has(#page-profile.active) { padding-top: 0 !important; }
+
+.pf {
+  --pf-card: linear-gradient(180deg, #181818, #0d0d0d);
+  --pf-tint: rgba(193, 18, 31, .16);
+  width: 100%;
+  padding-bottom: 24px;
+}
+.pf-view[hidden] { display: none; }
+.pf-i { width: 20px; height: 20px; flex-shrink: 0; }
+
+/* ── Header ── */
+.pf-bar {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: max(14px, env(safe-area-inset-top)) 2px 12px;
+}
+.pf-bar h1 {
+  flex: 1;
+  min-width: 0;
+  margin: 0;
+  font-family: var(--ff-sans);
+  font-size: 20px;
+  font-weight: 600;
+  color: var(--white);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.pf-brand { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
+.pf-brand img { width: 34px; height: 34px; border-radius: 10px; }
+.pf-icon-btn {
+  width: 40px;
+  height: 40px;
+  display: grid;
+  place-items: center;
+  flex-shrink: 0;
+  border-radius: 50%;
+  border: 1px solid var(--border);
+  background: rgba(255, 255, 255, .04);
+  color: var(--white);
+  cursor: pointer;
+  transition: var(--t);
+}
+.pf-icon-btn:active { transform: scale(.92); background: var(--g2); }
+.pf-body { padding: 4px 2px 0; display: flex; flex-direction: column; gap: 14px; }
+
+/* ── Shared card / tappable surfaces ── */
+.pf-card {
+  background: var(--pf-card);
+  border: 1px solid var(--border);
+  border-radius: 18px;
+  padding: 14px 16px;
+  box-shadow: 0 10px 30px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .03);
+}
+.pf-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
+.pf-card-head h2 { margin: 0; font-size: 14px; font-weight: 600; color: var(--white); font-family: var(--ff-sans); }
+.pf-link-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  background: none;
+  border: 0;
+  padding: 4px 0 4px 8px;
+  color: var(--text2);
+  font: inherit;
+  font-size: 12px;
+  cursor: pointer;
+}
+.pf-link-btn .pf-i { width: 14px; height: 14px; }
+.pf-chip {
+  width: 38px;
+  height: 38px;
+  display: grid;
+  place-items: center;
+  flex-shrink: 0;
+  border-radius: 11px;
+  background: var(--pf-tint);
+  color: var(--accent-l);
+}
+
+/* ── Hero (couple) ── */
+.pf-hero {
+  position: relative;
+  overflow: hidden;
+  padding: 18px 14px 14px;
+  border-radius: 22px;
+  border: 1px solid rgba(193, 18, 31, .35);
+  background:
+    radial-gradient(120% 90% at 50% 0%, rgba(193, 18, 31, .30), transparent 70%),
+    linear-gradient(180deg, #1a0e10, #0d0809);
+  box-shadow: 0 14px 40px rgba(0, 0, 0, .45);
+}
+.pf-couple { display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 4px; }
+.pf-person { display: flex; flex-direction: column; align-items: center; min-width: 0; }
+.pf-av-wrap { position: relative; width: 84px; height: 84px; }
+.pf-av {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  padding: 0;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  border-radius: 50%;
+  border: 3px solid var(--accent);
+  box-shadow: 0 0 0 3px rgba(193, 18, 31, .2), 0 8px 24px rgba(0, 0, 0, .5);
+  cursor: pointer;
+  color: var(--white);
+  transition: var(--t-spring);
+}
+.pf-av:active { transform: scale(.95); }
+.pf-cam {
+  position: absolute;
+  right: -2px;
+  bottom: 2px;
+  width: 26px;
+  height: 26px;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: #111;
+  border: 2px solid var(--accent);
+  color: var(--white);
+  pointer-events: none;
+}
+.pf-cam .pf-i { width: 12px; height: 12px; }
+.pf-name {
+  margin-top: 8px;
+  max-width: 100%;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--white);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.pf-presence { min-height: 16px; display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text2); }
+.pf-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text3); }
+.pf-dot.on { background: var(--green); box-shadow: 0 0 6px var(--green); }
+.pf-mid { display: flex; flex-direction: column; align-items: center; padding-top: 14px; min-width: 112px; }
+.pf-heart-link { position: relative; display: grid; place-items: center; width: 100%; height: 56px; color: var(--accent); }
+.pf-heart-link::before {
+  content: '';
+  position: absolute;
+  left: -10px;
+  right: -10px;
+  top: 50%;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255, 59, 48, .6), transparent);
+}
+.pf-heart-link .pf-i { position: relative; width: 48px; height: 48px; fill: rgba(193, 18, 31, .25); filter: drop-shadow(0 0 10px rgba(255, 59, 48, .6)); background: #120a0b; border-radius: 50%; padding: 6px; box-sizing: content-box; }
+.pf-since-l { margin-top: 6px; font-size: 11px; color: var(--text2); }
+.pf-since-d {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  margin-top: 2px;
+  padding: 2px 4px;
+  background: none;
+  border: 0;
+  color: var(--white);
+  font: inherit;
+  font-size: 14px;
+  font-weight: 600;
+  cursor: pointer;
+}
+.pf-since-d .pf-i { width: 13px; height: 13px; color: var(--accent-l); }
+.pf-span { margin-top: 12px; text-align: center; font-size: 12.5px; color: var(--text2); }
+
+/* ── Quick action buttons ── */
+.pf-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.pf-act {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  padding: 14px 6px 12px;
+  border-radius: 16px;
+  border: 1px solid var(--border);
+  background: var(--pf-card);
+  color: var(--white);
+  font: inherit;
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: var(--t);
+}
+.pf-act:active { transform: scale(.96); }
+.pf-act.is-primary { background: linear-gradient(180deg, var(--accent), var(--accent-d)); border-color: transparent; box-shadow: 0 6px 18px var(--accent-glow); }
+
+/* ── Stat tiles ── */
+.pf-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.pf-stat {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px;
+  text-align: left;
+  border-radius: 16px;
+  border: 1px solid var(--border);
+  background: var(--pf-card);
+  color: var(--white);
+  font: inherit;
+  cursor: pointer;
+  transition: var(--t);
+}
+.pf-stat:active { transform: scale(.97); }
+.pf-stat-n { display: block; font-size: 20px; font-weight: 700; line-height: 1.1; }
+.pf-stat-l { display: block; margin-top: 2px; font-size: 12px; color: var(--text2); }
+
+/* ── Next important date ── */
+.pf-next { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 14px; background: rgba(193, 18, 31, .10); border: 1px solid rgba(193, 18, 31, .25); cursor: pointer; }
+.pf-next-t { flex: 1; min-width: 0; }
+.pf-next-t b { display: block; font-size: 14px; color: var(--white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.pf-next-t span { font-size: 12px; color: var(--text2); }
+.pf-days { min-width: 58px; padding: 6px 8px; text-align: center; border-radius: 12px; background: linear-gradient(180deg, var(--accent), var(--accent-d)); color: var(--white); }
+.pf-days b { display: block; font-size: 18px; line-height: 1.1; }
+.pf-days span { font-size: 10px; opacity: .9; }
+.pf-empty { margin: 0; padding: 6px 0; font-size: 13px; color: var(--text2); }
+
+/* ── Our story preview ── */
+.pf-story { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }
+.pf-story-t { flex: 1; min-width: 0; }
+.pf-story-t b { display: flex; align-items: center; justify-content: space-between; font-size: 15px; color: var(--white); }
+.pf-story-t p {
+  margin: 4px 0 0;
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--text2);
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+/* ── Grouped list rows (settings + detail lists) ── */
+.pf-group { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+.pf-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); align-items: start; gap: 14px; }
+.pf-cols > .pf-full { grid-column: 1 / -1; }
+.pf-group-t { margin: 0 4px; font-size: 12px; font-weight: 600; letter-spacing: .6px; text-transform: uppercase; color: var(--text2); }
+.pf-list { background: var(--pf-card); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; }
+.pf-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: 100%;
+  padding: 12px 14px;
+  text-align: left;
+  background: none;
+  border: 0;
+  border-bottom: 1px solid var(--border);
+  color: var(--white);
+  font: inherit;
+  cursor: pointer;
+  transition: background .15s;
+}
+.pf-row:last-child { border-bottom: 0; }
+.pf-row:active { background: var(--g2); }
+.pf-row.is-static { cursor: default; }
+.pf-row-t { flex: 1; min-width: 0; }
+.pf-row-t b { display: block; font-size: 14px; font-weight: 500; }
+.pf-row-t span { display: block; margin-top: 1px; font-size: 12px; color: var(--text2); overflow: hidden; text-overflow: ellipsis; }
+.pf-row-v { max-width: 48%; font-size: 13px; color: var(--text2); text-align: right; }
+.pf-row .pf-chev { width: 16px; height: 16px; color: var(--text3); }
+.pf-row.is-danger { color: var(--red); }
+.pf-row.is-danger .pf-chip { background: var(--red-bg); color: var(--red); }
+
+/* ── Partner screen ── */
+.pf-pcard { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; align-items: center; }
+.pf-pcard .pf-av-wrap { width: 92px; height: 92px; grid-row: 1 / 3; }
+.pf-pname { margin: 0; font-size: 22px; font-weight: 600; color: var(--white); font-family: var(--ff-sans); }
+.pf-pill { display: inline-flex; align-items: center; gap: 6px; width: fit-content; padding: 4px 10px; border-radius: 999px; font-size: 12px; background: var(--g2); color: var(--text2); }
+.pf-pill.ok { background: var(--green-bg); color: var(--green); }
+.pf-pbtns { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
+.pf-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 12px;
+  border-radius: 14px;
+  border: 1px solid var(--border2);
+  background: rgba(255, 255, 255, .05);
+  color: var(--white);
+  font: inherit;
+  font-size: 14px;
+  font-weight: 500;
+  cursor: pointer;
+}
+.pf-btn:active { transform: scale(.97); }
+.pf-btn.is-primary { background: linear-gradient(180deg, var(--accent), var(--accent-d)); border-color: transparent; }
+.pf-btn[hidden] { display: none; }
+.pf-hint { margin: 0 0 10px; font-size: 12.5px; line-height: 1.6; color: var(--text2); }
+
+/* ── Milestones ── */
+.pf-tl { position: relative; padding-left: 24px; }
+.pf-tl::before { content: ''; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: linear-gradient(180deg, var(--accent), rgba(193, 18, 31, .06)); }
+.pf-year { position: relative; margin: 18px 0 10px; font-size: 14px; font-weight: 600; color: var(--white); }
+.pf-year:first-child { margin-top: 0; }
+.pf-year::before { content: ''; position: absolute; left: -24px; top: 3px; width: 10px; height: 10px; border-radius: 50%; background: #fff; border: 3px solid var(--accent); box-sizing: content-box; margin-left: -3px; }
+.pf-ms { position: relative; display: flex; gap: 12px; align-items: flex-start; margin-bottom: 10px; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--border); background: var(--pf-card); }
+.pf-ms-e { font-size: 22px; line-height: 1.2; }
+.pf-ms-t { flex: 1; min-width: 0; }
+.pf-ms-t b { display: block; font-size: 14px; color: var(--white); }
+.pf-ms-t small { display: block; margin-top: 2px; font-size: 11px; color: var(--text3); }
+.pf-ms-t p { margin: 6px 0 0; font-size: 13px; line-height: 1.5; color: var(--text2); }
+.pf-del { width: 34px; height: 34px; display: grid; place-items: center; flex-shrink: 0; border: 0; border-radius: 10px; background: none; color: var(--text3); cursor: pointer; }
+.pf-del:active { background: var(--red-bg); color: var(--red); }
+.pf-del .pf-i { width: 17px; height: 17px; }
+
+/* ── Love languages ── */
+.pf-opt { display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 14px; background: none; border: 0; border-bottom: 1px solid var(--border); color: var(--white); font: inherit; font-size: 14px; text-align: left; cursor: pointer; }
+.pf-opt:last-child { border-bottom: 0; }
+.pf-opt .pf-radio { margin-left: auto; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border2); display: grid; place-items: center; }
+.pf-opt.is-on { background: rgba(193, 18, 31, .12); }
+.pf-opt.is-on .pf-radio { border-color: var(--accent); background: var(--accent); }
+.pf-opt.is-on .pf-radio::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #fff; }
+.pf-tip { display: flex; gap: 10px; padding: 12px 14px; border-radius: 14px; font-size: 13px; line-height: 1.6; color: var(--text2); background: rgba(193, 18, 31, .10); border: 1px solid rgba(193, 18, 31, .22); }
+
+/* ── Story editor ── */
+.pf-ta { width: 100%; min-height: 110px; resize: vertical; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--border2); background: rgba(255, 255, 255, .04); color: var(--white); font: inherit; font-size: 14px; line-height: 1.5; }
+
+/* ── Bottom sheet (reuses the app's .modal-bg / .modal) ── */
+.modal-bg.pf-sheet-bg { align-items: flex-end; padding: 0; }
+.pf-sheet-bg .modal.pf-sheet {
+  max-width: 560px;
+  border-radius: 24px 24px 0 0;
+  padding: 10px 18px max(18px, env(safe-area-inset-bottom));
+  animation: pfSheetUp .28s cubic-bezier(.2, .8, .2, 1);
+}
+.pf-grab { width: 40px; height: 4px; margin: 0 auto 14px; border-radius: 4px; background: var(--border2); }
+@keyframes pfSheetUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
+
+/* ── Tablet / laptop ── */
+@media (min-width: 700px) {
+  .modal-bg.pf-sheet-bg { align-items: center; padding: 16px; }
+  .pf-sheet-bg .modal.pf-sheet { max-width: 480px; border-radius: 22px; padding: 22px; }
+  .pf-grab { display: none; }
+  .pf-av-wrap { width: 104px; height: 104px; }
+  .pf-couple { max-width: 720px; margin: 0 auto; }
+  .pf-mid { min-width: 200px; }
+  .pf-hero { padding: 26px 20px 20px; }
+  .pf-stats { grid-template-columns: repeat(4, 1fr); }
+}
+@media (min-width: 1000px) {
+  .pf-main-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
+  .pf-main-grid > .pf-hero, .pf-main-grid > .pf-actions, .pf-main-grid > .pf-stats { grid-column: 1 / -1; }
+  .pf-stat { padding: 16px; }
+}
+
+@media (max-width: 380px) {
+  .pf-av-wrap { width: 72px; height: 72px; }
+  .pf-mid { min-width: 96px; }
+  .pf-stat-n { font-size: 18px; }
+}
