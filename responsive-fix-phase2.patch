From c8c898478e94b8f6965551c3b1504a7bb5d807f3 Mon Sep 17 00:00:00 2001
From: Vamsi <dev@local>
Date: Mon, 10 Aug 2026 12:25:24 +0000
Subject: [PATCH 2/2] Phase 2: verify stylesheet load order across all pages,
 fix toast/snackbar overflow (mmToast/colToast/mpToast/dgToast/pmToast) that
 had no max-width + nowrap on dynamic messages

---
 css-src/responsive-fix.css | 17 +++++++++++++++++
 public/responsive-fix.css  | 17 +++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/css-src/responsive-fix.css b/css-src/responsive-fix.css
index da9c8c1..e6389de 100644
--- a/css-src/responsive-fix.css
+++ b/css-src/responsive-fix.css
@@ -249,6 +249,23 @@ button, input, select, textarea {
   flex-wrap: wrap;
 }
 
+/* Toast/snackbar notifications (mmToast, colToast, mpToast, dgToast,
+   pmToast, and any future id ending in "Toast"). These are centered
+   with left:50%/translateX(-50%) and were authored with
+   white-space:nowrap and no max-width -- fine for short static
+   text, but any longer dynamic message (API error text, a long
+   filename, etc.) grows past both screen edges on narrow phones
+   since translateX(-50%) only centers, it doesn't clamp width.
+   !important is required here because 2 of the 5 occurrences are
+   inline style="" attributes, which otherwise beat this stylesheet
+   regardless of load order. */
+[id$="Toast"] {
+  max-width: calc(100vw - 48px) !important;
+  white-space: normal !important;
+  text-align: center;
+  overflow-wrap: break-word;
+}
+
 /* Small-phone breakpoint tuning (320-375px): tighten button/action
    row gaps slightly so multi-button rows (common in card headers
    and modals) stay on one line instead of wrapping mid-row. Only
