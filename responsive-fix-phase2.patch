From 89b33fb24758e06f1de8d1234016a05355f9f646 Mon Sep 17 00:00:00 2001
From: Vamsi <dev@local>
Date: Mon, 10 Aug 2026 12:21:01 +0000
Subject: [PATCH 1/2] Harden global responsive-fix.css (grid/row/col
 shrink-safety, fixed-grid mobile fallback, header/action-row wrap) and
 include it on daily-routine, movie, and both home.html/home pages that were
 missing it

---
 css-src/responsive-fix.css | 55 ++++++++++++++++++++++++++++++++++++++
 public/daily-routine.html  |  1 +
 public/home.html           |  1 +
 public/home/home.html      |  1 +
 public/movie.html          |  1 +
 public/responsive-fix.css  | 55 ++++++++++++++++++++++++++++++++++++++
 6 files changed, 114 insertions(+)

diff --git a/css-src/responsive-fix.css b/css-src/responsive-fix.css
index 7ef9b7c..da9c8c1 100644
--- a/css-src/responsive-fix.css
+++ b/css-src/responsive-fix.css
@@ -194,6 +194,61 @@ button, input, select, textarea {
   max-width: 100%;
 }
 
+/* Broaden flex/grid "shrink to fit" coverage. The rule above only
+   caught classes literally containing "-row"/"-grid"/"-flex". Many
+   pages use names like .two-col, .dr-row2, .al-two-col, .mp-row2,
+   .rank-row, .detail-grid, .kpi-grid, .photo-col-grid, .movie-grid
+   which either don't match that pattern or benefit from the same
+   shrink-safety on their direct children so long labels/numbers/
+   long names inside a two-column stat/form row wrap instead of
+   forcing the row (and the page) wider than the viewport. */
+[class*="row"] > *, [class*="grid"] > *, [class*="flex"] > *,
+[class*="col"] > *, [class*="Grid"] > *, [class*="Row"] > * {
+  min-width: 0;
+}
+
+/* Fixed multi-column grids that were authored with a hard column
+   count (e.g. "repeat(4,1fr)", "repeat(3,1fr)") for a wide desktop
+   baseline can still make each column too narrow for its content
+   on phones below ~480px if the surrounding media query didn't
+   collapse it. As a safety net (not a redesign), let any grid
+   still using 3+ hard-coded equal columns fall back to 2 columns
+   on very small phones so content stays legible; pages that already
+   define their own <480px override keep using that instead because
+   this rule has low specificity and loads before page-authored
+   breakpoints later in the cascade only if such a rule doesn't
+   already exist -- authored overrides win either way since this is
+   a single low-specificity fallback, not !important. */
+@media (max-width: 480px) {
+  [style*="grid-template-columns: repeat(3"],
+  [style*="grid-template-columns: repeat(4"],
+  [style*="grid-template-columns: repeat(5"] {
+    grid-template-columns: repeat(2, 1fr) !important;
+  }
+}
+
+/* Headers/navbars: long titles or long partner names must not push
+   icon buttons off-screen. Generic, low-specificity guard for the
+   common header/topbar/navbar child pattern. */
+.topbar > *, .header > *, .navbar > *, [class*="-header"] > *,
+[class*="-topbar"] > *, [class*="-nav"] > * {
+  min-width: 0;
+}
+.topbar *[class*="title"], .header *[class*="title"],
+.navbar *[class*="title"], [class*="-header"] *[class*="title"] {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Button/action groups: allow wrapping instead of overlap/clipping
+   when 3+ inline buttons don't fit a narrow row, unless the page
+   explicitly opted into single-line + scroll via overflow-x. */
+.btn-row, .actions, .card-actions, [class*="-actions"],
+[class*="-btn-row"], [class*="-button-row"] {
+  flex-wrap: wrap;
+}
+
 /* Small-phone breakpoint tuning (320-375px): tighten button/action
    row gaps slightly so multi-button rows (common in card headers
    and modals) stay on one line instead of wrapping mid-row. Only
diff --git a/public/daily-routine.html b/public/daily-routine.html
index 4c5705b..2c380fd 100644
--- a/public/daily-routine.html
+++ b/public/daily-routine.html
@@ -158,6 +158,7 @@ button{font-family:inherit}
 
 .dr-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(12px);background:rgba(10,10,25,0.95);border:1px solid var(--border2);color:#fff;font-size:12px;padding:10px 16px;border-radius:12px;z-index:200;opacity:0;pointer-events:none;transition:var(--t)}
 </style>
+  <link rel="stylesheet" href="/responsive-fix.css">
 </head>
 <body>
 
