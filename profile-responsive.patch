diff --git a/public/profile.css b/public/profile.css
index 4319ea8..b406153 100644
--- a/public/profile.css
+++ b/public/profile.css
@@ -12,10 +12,16 @@
 .pf {
   --pf-card: linear-gradient(180deg, #181818, #0d0d0d);
   --pf-tint: rgba(193, 18, 31, .16);
-  max-width: 560px;
-  margin: 0 auto;
+  /* Full width like every other page: the .content wrapper already provides
+     the side padding, so the page just fills it (no fixed phone-width column). */
+  width: 100%;
+  max-width: none;
+  margin: 0;
   padding-bottom: 24px;
+  box-sizing: border-box;
+  overflow-wrap: anywhere;
 }
+.pf *, .pf *::before, .pf *::after { box-sizing: border-box; }
 .pf-view[hidden] { display: none; }
 .pf-i { width: 20px; height: 20px; flex-shrink: 0; }
 
@@ -186,7 +192,7 @@
 .pf-span { margin-top: 12px; text-align: center; font-size: 12.5px; color: var(--text2); }
 
 /* ── Quick action buttons ── */
-.pf-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.pf-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
 .pf-act {
   display: flex;
   flex-direction: column;
@@ -207,7 +213,7 @@
 .pf-act.is-primary { background: linear-gradient(180deg, var(--accent), var(--accent-d)); border-color: transparent; box-shadow: 0 6px 18px var(--accent-glow); }
 
 /* ── Stat tiles ── */
-.pf-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.pf-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
 .pf-stat {
   display: flex;
   align-items: center;
@@ -346,8 +352,133 @@
 .pf-grab { width: 40px; height: 4px; margin: 0 auto 14px; border-radius: 4px; background: var(--border2); }
 @keyframes pfSheetUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
 
+/* ══════════════════════════════════════════════════════════════
+   RESPONSIVE — phones → tablets → laptops → large monitors.
+   Breakpoints match the rest of the app (700px = mobile nav).
+   ══════════════════════════════════════════════════════════════ */
+
+/* Never let a flex/grid child force horizontal scroll */
+.pf-stat > span, .pf-row-t, .pf-next-t, .pf-story-t, .pf-ms-t { min-width: 0; }
+.pf-stat-l { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pf-act { min-width: 0; text-align: center; }
+
+/* Small phones */
 @media (max-width: 380px) {
   .pf-av-wrap { width: 72px; height: 72px; }
   .pf-mid { min-width: 96px; }
   .pf-stat-n { font-size: 18px; }
+  .pf-stat { gap: 8px; padding: 10px; }
+  .pf-stat .pf-chip { width: 32px; height: 32px; border-radius: 9px; }
+  .pf-act { font-size: 11px; padding: 12px 4px 10px; }
+  .pf-card { padding: 12px; }
+  .pf-pcard { grid-template-columns: 1fr; justify-items: center; text-align: center; }
+  .pf-pcard .pf-av-wrap { grid-row: auto; }
+}
+
+/* Phones in landscape / very short screens */
+@media (max-height: 520px) and (orientation: landscape) {
+  .pf-av-wrap { width: 64px; height: 64px; }
+  .pf-hero { padding: 12px 12px 10px; }
+  .pf-heart-link { height: 44px; }
+  .pf-bar { padding-top: max(6px, env(safe-area-inset-top)); padding-bottom: 6px; }
+}
+
+/* Notched phones in landscape: keep content out of the cut-outs */
+@supports (padding: max(0px)) {
+  .pf { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
+}
+
+/* ── Tablets & large phones (≥ 701px) ── */
+@media (min-width: 701px) {
+  .pf-bar h1 { font-size: 22px; }
+  .pf-body { gap: 16px; padding-top: 6px; }
+  .pf-hero { padding: 26px 24px 20px; border-radius: 26px; }
+  .pf-couple { gap: 12px; }
+  .pf-av-wrap { width: 112px; height: 112px; }
+  .pf-cam { width: 30px; height: 30px; right: 2px; bottom: 4px; }
+  .pf-cam .pf-i { width: 14px; height: 14px; }
+  .pf-name { font-size: 17px; margin-top: 10px; }
+  .pf-mid { min-width: 160px; padding-top: 22px; }
+  .pf-heart-link { height: 64px; }
+  .pf-heart-link::before { left: -40px; right: -40px; }
+  .pf-since-d { font-size: 15px; }
+  .pf-span { font-size: 13.5px; }
+  .pf-card { padding: 16px 20px; }
+  .pf-act { flex-direction: row; justify-content: center; gap: 10px; padding: 16px 10px; font-size: 14px; }
+  .pf-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+  .pf-stat { padding: 14px; }
+  .pf-stat-n { font-size: 22px; }
+  .pf-row { padding: 14px 18px; }
+  .pf-row-t b { font-size: 15px; }
+  .pf-opt { padding: 14px 18px; }
+  .modal-bg.pf-sheet-bg { align-items: center; padding: 20px; }
+  .pf-sheet-bg .modal.pf-sheet { width: 100%; border-radius: 24px; padding: 18px 22px 22px; }
+  .pf-grab { display: none; }
+}
+
+/* ── Laptops & desktops (≥ 1024px): use the extra width ── */
+@media (min-width: 1024px) {
+  /* Home: hero + buttons + stats full width, then date & story side by side */
+  .pf-view[data-view="main"] .pf-body {
+    display: grid;
+    grid-template-columns: repeat(12, minmax(0, 1fr));
+    gap: 18px;
+  }
+  .pf-view[data-view="main"] .pf-hero,
+  .pf-view[data-view="main"] .pf-actions,
+  .pf-view[data-view="main"] .pf-stats { grid-column: 1 / -1; }
+  .pf-view[data-view="main"] .pf-body > .pf-card:not(.pf-story) { grid-column: span 7; }
+  .pf-view[data-view="main"] .pf-body > .pf-story { grid-column: span 5; align-self: stretch; }
+  .pf-view[data-view="main"] .pf-story-t p { -webkit-line-clamp: 5; }
+  .pf-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+  .pf-av-wrap { width: 128px; height: 128px; }
+  .pf-mid { min-width: 220px; }
+  .pf-name { font-size: 18px; }
+
+  /* Partner: details card + list, connection beside them */
+  .pf-view[data-view="partner"] .pf-body {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 18px;
+    align-items: start;
+  }
+  .pf-view[data-view="partner"] .pf-body > #pfRemove { grid-column: 1 / -1; }
+
+  /* Settings & love languages: group blocks flow into two columns */
+  .pf-view[data-view="settings"] .pf-body,
+  .pf-view[data-view="love"] .pf-body {
+    display: block;
+    column-count: 2;
+    column-gap: 22px;
+  }
+  .pf-view[data-view="settings"] .pf-list,
+  .pf-view[data-view="love"] .pf-list { break-inside: avoid; margin-bottom: 18px; }
+  .pf-view[data-view="settings"] .pf-group-t,
+  .pf-view[data-view="love"] .pf-group-t { break-after: avoid; margin: 0 4px 10px; }
+  .pf-view[data-view="love"] .pf-tip { break-inside: avoid; }
+
+  /* Milestones: timeline cards in two columns */
+  .pf-view[data-view="milestones"] .pf-ms { max-width: none; }
+
+  /* Story: two editors side by side */
+  .pf-view[data-view="story"] .pf-body {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 18px;
+    align-items: start;
+  }
+  .pf-view[data-view="story"] .pf-body > .btn { grid-column: 1 / -1; justify-self: start; min-width: 200px; }
+  .pf-ta { min-height: 180px; }
+}
+
+/* ── Large monitors (≥ 1440px) ── */
+@media (min-width: 1440px) {
+  .pf-av-wrap { width: 144px; height: 144px; }
+  .pf-hero { padding: 32px 32px 26px; }
+  .pf-name { font-size: 20px; }
+  .pf-stat-n { font-size: 26px; }
+  .pf-stat-l { font-size: 13px; }
+  .pf-act { font-size: 15px; }
+  .pf-view[data-view="settings"] .pf-body,
+  .pf-view[data-view="love"] .pf-body { column-count: 3; }
 }
