+  'use strict';
+  const MX = window.MX;
+
+  /* ═══════════════════════════════════════════════════════
+     OFFLINE DOWNLOADS
+  ═══════════════════════════════════════════════════════ */
+  const CACHE_NAME = 'mx-music-v1';
