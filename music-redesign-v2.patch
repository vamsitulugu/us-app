@@ -0,0 +1,476 @@
+/* ═══════════════════════════════════════════════════════════════
+   MUSIC — design system + every screen of the redesigned Music page.
+
+   Theming: the parent app posts --accent / --accent2 / --accent-d /
+   --accent-glow into :root (see index.html syncThemeToFrame). Everything
+   below derives from those, so the page follows the app theme. The defaults
+   are the burgundy theme (theme-burgundy.css).
+
+   Legacy tokens (--white, --text2, --g1, --border, --ff-*, --t, --green…) are
+   kept because the import / lyrics-admin / couple-karaoke scripts, which this
+   redesign leaves in place, style themselves with them.
+═══════════════════════════════════════════════════════════════ */
+:root{
+  --h:215;
+  --accent:#C1121F; --accent-d:#8B0000; --accent-l:#FF6B5D; --accent-glow:rgba(255,59,48,.35);
+  --accent2:#E0355B; --accent2-d:#A3123A; --accent2-glow:rgba(224,53,91,.32);
+
+  --ff-serif:'DM Serif Display',Georgia,serif;
+  --ff-sans:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
+
+  --mx-bg:#07030a;
+  --mx-surface:#12080f;
+  --mx-card:rgba(255,255,255,.05);
+  --mx-card2:rgba(255,255,255,.09);
+  --mx-line:rgba(255,255,255,.09);
+  --mx-line2:rgba(255,255,255,.16);
+  --mx-text:#fff;
+  --mx-text2:rgba(255,255,255,.68);
+  --mx-text3:rgba(255,255,255,.44);
+  --mx-red:var(--accent2);
+  --mx-red-d:var(--accent);
+  --mx-glow:var(--accent-glow);
+  --mx-ok:#34d399; --mx-warn:#fbbf24; --mx-bad:#f87171;
+  --mx-r:16px; --mx-rs:12px;
+  --mx-ease:cubic-bezier(.32,.72,0,1);
+  --mx-mini:0px;                     /* set by JS to the mini player height when visible */
+  --sab:env(safe-area-inset-bottom,0px); --sat:env(safe-area-inset-top,0px);
+
+  /* legacy tokens for kept scripts */
+  --white:#fff; --text:rgba(255,255,255,.92); --text2:rgba(255,255,255,.62); --text3:rgba(255,255,255,.4);
+  --g1:rgba(255,255,255,.05); --g2:rgba(255,255,255,.09); --g3:rgba(255,255,255,.13);
+  --border:rgba(255,255,255,.1); --border2:rgba(255,255,255,.18);
+  --green:#34d399; --red:#f87171; --yellow:#fbbf24;
+  --t:all .22s cubic-bezier(.4,0,.2,1);
+}
+*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
+html,body{height:100%}
+html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
+body{
+  font-family:var(--ff-sans);color:var(--mx-text);line-height:1.45;overflow:hidden;
+  overscroll-behavior:none;-webkit-font-smoothing:antialiased;
+  background:
+    radial-gradient(120% 55% at 50% -8%,rgba(139,0,0,.42),transparent 62%),
+    radial-gradient(90% 40% at 100% 100%,rgba(139,0,0,.22),transparent 70%),
+    var(--mx-bg);
+}
+@supports (background:color-mix(in srgb,red 10%,blue)){
+  body{background:
+    radial-gradient(120% 55% at 50% -8%,color-mix(in srgb,var(--mx-red-d) 42%,transparent),transparent 62%),
+    radial-gradient(90% 40% at 100% 100%,color-mix(in srgb,var(--mx-red-d) 22%,transparent),transparent 70%),
+    var(--mx-bg);}
+}
+button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-appearance:none;appearance:none}
+input,select,textarea{font:inherit;color:inherit}
+svg.i{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none;pointer-events:none}
+svg.i.fill{fill:currentColor}
+.hidden{display:none!important}
+.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+.ellip{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+audio{display:none}
+
+/* ── App shell / screens ─────────────────────────────────────── */
+#app{position:fixed;inset:0;overflow:hidden}
+.screen{
+  position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;
+  padding-bottom:calc(var(--mx-mini) + 28px + var(--sab));
+  display:none;background:transparent;z-index:1;
+}
+.screen.active{display:block}
+.screen.pushed{z-index:2;background-color:var(--mx-bg);
+  background-image:radial-gradient(120% 40% at 50% -6%,rgba(139,0,0,.34),transparent 60%)}
+.screen.enter{animation:mxIn .32s var(--mx-ease)}
+.screen.leave{animation:mxOut .24s var(--mx-ease) forwards}
+@keyframes mxIn{from{transform:translateX(26px);opacity:0}to{transform:none;opacity:1}}
+@keyframes mxOut{to{transform:translateX(26px);opacity:0}}
+.wrap{max-width:640px;margin:0 auto;padding:0 16px}
+
+/* ── Header ──────────────────────────────────────────────────── */
+.hdr{display:flex;align-items:center;gap:12px;padding:calc(14px + var(--sat)) 16px 12px;max-width:640px;margin:0 auto}
+.hdr.sticky{position:sticky;top:0;z-index:20;background:linear-gradient(var(--mx-bg) 70%,transparent);max-width:none;padding-left:max(16px,calc((100% - 640px)/2 + 16px));padding-right:max(16px,calc((100% - 640px)/2 + 16px))}
+.hdr-brand{display:flex;align-items:center;gap:11px;flex:1;min-width:0}
+.hdr-logo{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;flex:none;
+  background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));box-shadow:0 6px 20px var(--mx-glow)}
+.hdr-logo svg{width:22px;height:22px}
+.hdr-title{font-size:19px;font-weight:700;letter-spacing:-.2px}
+.hdr-sub{font-size:11.5px;color:var(--mx-text3);margin-top:1px}
+.hdr-sub .i{width:11px;height:11px;color:var(--mx-red);fill:currentColor;vertical-align:-1px}
+.hdr h1{flex:1;min-width:0;font-size:19px;font-weight:700}
+.hdr-actions{display:flex;gap:8px;margin-left:auto}
+.icon-btn{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;flex:none;
+  background:var(--mx-card);border:1px solid var(--mx-line);transition:transform .15s,background .15s}
+.icon-btn:active{transform:scale(.92);background:var(--mx-card2)}
+.icon-btn.bare{background:none;border-color:transparent}
+.icon-btn.primary{background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));border-color:transparent;box-shadow:0 4px 16px var(--mx-glow)}
+.icon-btn.sm{width:34px;height:34px}.icon-btn.sm svg{width:17px;height:17px}
+
+/* ── Tabs / pills ────────────────────────────────────────────── */
+.tabs{display:flex;gap:8px;padding:2px 16px 14px;max-width:640px;margin:0 auto;overflow-x:auto;scrollbar-width:none}
+.tabs::-webkit-scrollbar{display:none}
+.tab{flex:1 0 auto;min-width:84px;text-align:center;padding:11px 14px;border-radius:12px;font-size:13.5px;font-weight:600;
+  color:var(--mx-text2);background:var(--mx-card);border:1px solid var(--mx-line);white-space:nowrap;transition:.2s}
+.tab.active{color:#fff;background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));border-color:transparent;box-shadow:0 6px 18px var(--mx-glow)}
+.tabs.compact .tab{flex:1 1 auto;min-width:0;padding:9px 10px;font-size:13px}
+.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 16px 12px;max-width:640px;margin:0 auto;scrollbar-width:none}
+.chips::-webkit-scrollbar{display:none}
+.chip{flex:none;padding:8px 15px;border-radius:999px;font-size:12.5px;font-weight:600;color:var(--mx-text2);
+  background:var(--mx-card);border:1px solid var(--mx-line);white-space:nowrap}
+.chip.active{color:#fff;background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));border-color:transparent}
+
+/* ── Sections ────────────────────────────────────────────────── */
+.section{max-width:640px;margin:0 auto;padding:6px 16px 8px}
+.section-h{display:flex;align-items:center;justify-content:space-between;margin:14px 0 10px}
+.section-h h2{font-size:17px;font-weight:700;letter-spacing:-.15px}
+.link{font-size:12.5px;font-weight:600;color:var(--mx-text2);display:flex;align-items:center;gap:2px;padding:6px 0}
+.link .i{width:15px;height:15px}
+.hscroll{display:flex;gap:12px;overflow-x:auto;padding:2px 16px 8px;margin:0 -16px;scroll-snap-type:x proximity;scrollbar-width:none}
+.hscroll::-webkit-scrollbar{display:none}
+.hscroll>*{scroll-snap-align:start;flex:none}
+
+/* ── Hero ────────────────────────────────────────────────────── */
+.hero{position:relative;overflow:hidden;border-radius:22px;padding:22px 20px;min-height:132px;margin:2px 0 14px;
+  background:linear-gradient(110deg,rgba(0,0,0,.55),rgba(0,0,0,.1)),linear-gradient(135deg,var(--mx-red-d),#2a0610 70%);
+  border:1px solid var(--mx-line2);display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
+.hero::after{content:"";position:absolute;right:-30px;top:-40px;width:200px;height:200px;border-radius:50%;
+  background:radial-gradient(circle,var(--mx-glow),transparent 68%);pointer-events:none}
+.hero h2{font-family:var(--ff-serif);font-weight:400;font-size:25px;line-height:1.12;position:relative;z-index:1}
+.hero p{font-size:12.5px;color:var(--mx-text2);margin-top:7px;max-width:230px;position:relative;z-index:1}
+.hero-play{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;flex:none;position:relative;z-index:1;
+  background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));box-shadow:0 8px 24px var(--mx-glow)}
+.hero-play svg{width:22px;height:22px;margin-left:2px}
+.hero-art{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.35;filter:saturate(1.2)}
+
+/* ── Quick tiles ─────────────────────────────────────────────── */
+.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:6px}
+.tile{display:flex;flex-direction:column;align-items:center;gap:8px;padding:13px 4px 11px;border-radius:16px;
+  background:var(--mx-card);border:1px solid var(--mx-line);font-size:11.5px;font-weight:600;color:var(--mx-text2);text-align:center;transition:transform .15s}
+.tile:active{transform:scale(.95)}
+.tile-ico{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;
+  background:rgba(255,255,255,.06);border:1px solid var(--mx-line)}
+.tile-ico svg{width:22px;height:22px;color:var(--mx-red)}
+.tile .n{font-size:10px;color:var(--mx-text3);font-weight:500;margin-top:-5px}
+.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
+.quick .tile-ico{background:rgba(255,255,255,.05)}
+.quick .tile.accent .tile-ico{background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));border-color:transparent}
+.quick .tile.accent svg{color:#fff}
+
+/* ── Cover art ───────────────────────────────────────────────── */
+.cover{position:relative;overflow:hidden;flex:none;border-radius:12px;display:grid;place-items:center;
+  background:linear-gradient(135deg,var(--mx-red-d),#240510);color:rgba(255,255,255,.7)}
+.cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
+.cover svg{width:44%;height:44%;opacity:.8}
+.cover.s{width:44px;height:44px;border-radius:10px}
+.cover.m{width:52px;height:52px}
+.cover.l{width:72px;height:72px;border-radius:14px}
+.cover.fill{width:100%;aspect-ratio:1;border-radius:inherit}
+
+/* ── Track rows ──────────────────────────────────────────────── */
+.list{display:flex;flex-direction:column}
+.trk{display:flex;align-items:center;gap:12px;padding:9px 6px 9px 4px;border-radius:12px;position:relative;cursor:pointer;
+  border-bottom:1px solid rgba(255,255,255,.04);transition:background .15s}
+.trk:active{background:var(--mx-card)}
+.trk.current{background:linear-gradient(90deg,rgba(255,255,255,.07),rgba(255,255,255,.02));border-bottom-color:transparent}
+.trk.current::before{content:"";position:absolute;left:-2px;top:14%;bottom:14%;width:3px;border-radius:3px;background:var(--mx-red)}
+.trk.unavailable{opacity:.45}
+.trk-main{flex:1;min-width:0}
+.trk-title{font-size:14.5px;font-weight:600}
+.trk.current .trk-title{color:var(--mx-red)}
+.trk-sub{font-size:12px;color:var(--mx-text3);margin-top:2px;display:flex;align-items:center;gap:6px}
