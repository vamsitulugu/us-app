+  -webkit-mask-image:linear-gradient(transparent,#000 8%,#000 90%,transparent);mask-image:linear-gradient(transparent,#000 8%,#000 90%,transparent)}
+.sing-dock{position:relative;padding:8px 18px calc(16px + var(--sab));max-width:520px;width:100%;margin:0 auto}
+.wave{display:block;width:100%;height:46px;border-radius:12px;background:var(--mx-card);margin-bottom:10px}
+.sing-ctrls{display:flex;align-items:center;justify-content:center;gap:14px}
+.rec-btn{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--mx-red),var(--mx-red-d));box-shadow:0 10px 30px var(--mx-glow)}
+.rec-btn svg{width:30px;height:30px}
+.rec-btn.live{animation:pulse 1.2s infinite}
+@keyframes pulse{0%{box-shadow:0 0 0 0 var(--mx-glow)}70%{box-shadow:0 0 0 20px transparent}100%{box-shadow:0 0 0 0 transparent}}
+.sing-timer{text-align:center;font-size:13px;color:var(--mx-text2);margin-bottom:8px;font-variant-numeric:tabular-nums}
+.count{position:absolute;inset:0;z-index:5;display:none;place-items:center;background:rgba(0,0,0,.72);font-size:110px;font-weight:800}
+.count.show{display:grid}
+.fx-row{display:flex;align-items:center;gap:12px;padding:8px 2px;font-size:13px}
+.fx-row span{width:84px;color:var(--mx-text2)}.fx-row output{width:38px;text-align:right;font-size:12px;color:var(--mx-text3)}
+.presets{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
+
+/* ── Recordings ──────────────────────────────────────────────── */
+.rec-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
+.rec-row{display:flex;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid rgba(255,255,255,.04)}
+.rec-ico{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;flex:none;background:rgba(255,255,255,.07);color:var(--mx-red);border:1px solid var(--mx-line)}
+.rec-ico.video{color:#a78bfa}
+.rec-main{flex:1;min-width:0}
+.rec-t{font-size:14.5px;font-weight:600}
+.rec-s{font-size:12px;color:var(--mx-text3);margin-top:2px}
+.rec-play{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--mx-card2);border:1px solid var(--mx-line2)}
+.rec-play svg{width:17px;height:17px}
+#recorder{align-items:center;padding:0}
+#recorder .sheet{border-radius:0;max-height:none;height:100%;max-width:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:20px;background:var(--mx-bg)}
+.rec-stage{width:min(88vw,380px);aspect-ratio:3/4;border-radius:22px;overflow:hidden;background:var(--mx-card);border:1px solid var(--mx-line2);display:grid;place-items:center;position:relative}
+.rec-stage video{width:100%;height:100%;object-fit:cover}
+.rec-stage.audio{aspect-ratio:auto;height:150px}
+.rec-timer{font-size:34px;font-weight:700;font-variant-numeric:tabular-nums}
+.rec-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--mx-bad);margin-right:8px;animation:blink 1s infinite}
+@keyframes blink{50%{opacity:.25}}
+.sel-bar{position:fixed;left:12px;right:12px;bottom:calc(14px + var(--sab));z-index:70;max-width:560px;margin:0 auto;display:flex;gap:10px;align-items:center;
+  padding:10px 14px;border-radius:16px;background:rgba(32,14,24,.97);border:1px solid var(--mx-line2)}
+.sel-bar span{flex:1;font-size:13.5px;font-weight:600}
+.check{width:24px;height:24px;border-radius:50%;border:2px solid var(--mx-line2);display:grid;place-items:center;flex:none}
+.check.on{background:var(--mx-red);border-color:var(--mx-red)}.check svg{width:14px;height:14px;stroke-width:3}
+
+/* ── Progress overlay (uploads, downloads) ───────────────────── */
+.bar{height:6px;border-radius:6px;background:rgba(255,255,255,.12);overflow:hidden}
+.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--mx-red-d),var(--mx-red));transition:width .2s}
+
+/* the couple-karaoke FAB is replaced by the in-app "Sing Together" entry points */
+.ck-fab{display:none!important}
+
+@media(min-width:700px){
+  .hero{min-height:150px}
+  .mix{width:150px}
+}
+@media(max-height:640px){
+  .pl-art{width:min(60vw,34vh)}
+  .pl-meta{margin-top:12px}
+  .ctrl.big{width:62px;height:62px}
+}
+@media(prefers-reduced-motion:reduce){
+  *{animation-duration:.01ms!important;transition-duration:.01ms!important}
+}
