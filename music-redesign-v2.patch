-    fxNodes.masterGain = ctx.createGain();
-    fxNodes.masterGain.gain.value = 1;
-  }
-  // Bass boost (lowshelf)
-  if (!fxNodes.bassFilter) {
-    fxNodes.bassFilter = ctx.createBiquadFilter();
-    fxNodes.bassFilter.type = 'lowshelf';
-    fxNodes.bassFilter.frequency.value = 200;
-    fxNodes.bassFilter.gain.value = 0;
-  }
-  // Treble boost (highshelf)
-  if (!fxNodes.trebleFilter) {
-    fxNodes.trebleFilter = ctx.createBiquadFilter();
-    fxNodes.trebleFilter.type = 'highshelf';
-    fxNodes.trebleFilter.frequency.value = 5000;
-    fxNodes.trebleFilter.gain.value = 0;
-  }
-  // Delay
-  if (!fxNodes.delayNode) {
-    fxNodes.delayNode = ctx.createDelay(1.0);
-    fxNodes.delayNode.delayTime.value = 0.2;
-    fxNodes.delayGain = ctx.createGain();
-    fxNodes.delayGain.gain.value = 0;
-    fxNodes.delayNode.connect(fxNodes.delayGain);
-    fxNodes.delayGain.connect(fxNodes.delayNode); // feedback loop (capped by gain)
-  }
-  // Convolver (reverb) — use a simple synthetic impulse
-  if (!fxNodes.convolverNode) {
-    fxNodes.convolverNode = ctx.createConvolver();
-    fxNodes.convolverGain = ctx.createGain();
-    fxNodes.convolverGain.gain.value = 0;
-    fxNodes.convolverNode.connect(fxNodes.convolverGain);
-    // Generate impulse response
-    _buildReverbImpulse(ctx);
-  }
-}
-
-function _buildReverbImpulse(ctx, duration = 2.5, decay = 2.0) {
-  const len = ctx.sampleRate * duration;
-  const buf = ctx.createBuffer(2, len, ctx.sampleRate);
-  for (let ch = 0; ch < 2; ch++) {
-    const d = buf.getChannelData(ch);
-    for (let i = 0; i < len; i++) {
-      d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
-    }
-  }
-  if (fxNodes.convolverNode) fxNodes.convolverNode.buffer = buf;
-}
-
-function rebuildFxChain() {
-  // This function is called after ensureKaraokeAudioGraph() has already
-  // connected: source -> karaokeAnalyser -> destination
-  // We intercept by connecting masterGain into destination and
-  // routing the dry + wet signals through our chain.
-  // Note: since the source is already connected we manage gain values
-  // rather than rewiring the graph (avoids AudioContext errors).
-  ensureFxGraph();
-  if (!karaokeAudioCtx || !fxNodes.masterGain) return;
-  // Apply current state values to nodes
-  applyFxToNodes();
-}
-
-function applyFxToNodes() {
-  if (!fxNodes.masterGain) return;
-  // Master volume
-  fxNodes.masterGain.gain.value = fxState.volume;
-  audio.volume = Math.min(1, fxState.volume); // also set native volume as fallback
-  // Bass
-  if (fxNodes.bassFilter) {
-    fxNodes.bassFilter.gain.value = fxState.bass ? fxState.bassAmt : 0;
-  }
-  // Treble
-  if (fxNodes.trebleFilter) {
-    fxNodes.trebleFilter.gain.value = fxState.treble ? fxState.trebleAmt : 0;
-  }
-  // Delay feedback gain
-  if (fxNodes.delayGain) {
-    fxNodes.delayGain.gain.value = fxState.delay ? Math.min(0.6, fxState.delayAmt * 0.6) : 0;
-    if (fxNodes.delayNode) fxNodes.delayNode.delayTime.value = Math.max(0.05, fxState.delayAmt * 0.8);
-  }
-  // Reverb wet gain
-  if (fxNodes.convolverGain) {
-    fxNodes.convolverGain.gain.value = fxState.reverb ? fxState.reverbAmt * 1.2 : 0;
-  }
-  // Pitch via playbackRate
-  const rate = fxState.pitch ? semitoneToRate(fxState.pitchAmt) : 1;
-  if (audio.playbackRate !== rate) audio.playbackRate = rate;
-}
