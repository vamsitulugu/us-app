+/* ───────────────── 4. AI PAGE IMAGE CARDS (hero + BOTH hero) ───────────────── */
+html[data-theme="light"] #page-ai .tw-hero,
+html[data-theme="light"] #page-ai .tw-both-hero {
+  background:
+    radial-gradient(80% 90% at 85% 100%, rgba(107, 9, 58, .20), transparent 70%),
+    linear-gradient(135deg, #FBE3EF 0%, #F2C7DC 55%, #E6A9C8 100%);
+  border: 1px solid rgba(107, 9, 58, .30);
+  box-shadow: 0 12px 30px rgba(107, 9, 58, .18), inset 0 1px 0 rgba(255, 255, 255, .7);
+}
+
+/* ───────────────── 5. SETTINGS SEARCH BAR ───────────────── */
+html[data-theme="light"] .set-search {
+  background: #6B093A !important;
+  color: #fff;
+  box-shadow: 0 6px 18px rgba(107, 9, 58, .28);
+}
+html[data-theme="light"] .set-search .si,
+html[data-theme="light"] .set-search svg { color: #fff; stroke: currentColor; }
+html[data-theme="light"] .set-search input { color: #fff !important; caret-color: #fff; background: none !important; }
+html[data-theme="light"] .set-search input::placeholder { color: rgba(255, 255, 255, .72); }
+html[data-theme="light"] .set-search input::-webkit-search-cancel-button { filter: invert(1); opacity: .8; }
+
+/* ───────────────── 6. LIGHT #6B093A TINT ON THE TOP OF EVERY PAGE ─────────────────
+   One soft band behind the whole upper area, plus a slightly stronger tint on
+   each page's own header. (Dashboard already has its solid burgundy header.) */
+html[data-theme="light"] .main:not(:has(#page-dashboard.active)) {
+  background:
+    linear-gradient(180deg, rgba(107, 9, 58, .15) 0, rgba(107, 9, 58, .07) 130px, rgba(107, 9, 58, 0) 270px)
+    top / 100% 270px no-repeat;
+}
+html[data-theme="light"] .topbar {
+  background: linear-gradient(180deg, rgba(107, 9, 58, .20), rgba(107, 9, 58, .09)) !important;
+  border-bottom: 1px solid rgba(107, 9, 58, .16) !important;
+}
+#page-chat[data-theme="light"] .chat-header {
+  background: linear-gradient(180deg, rgba(107, 9, 58, .22), rgba(107, 9, 58, .09)), #FFF6FB !important;
+  border-color: rgba(107, 9, 58, .18) !important;
+  box-shadow: 0 10px 22px -12px rgba(107, 9, 58, .35);
+}
+html[data-theme="light"] #page-ai .tw-head,
+html[data-theme="light"] .lms-hdr {
+  background: linear-gradient(180deg, rgba(107, 9, 58, .18), rgba(107, 9, 58, 0));
+}
