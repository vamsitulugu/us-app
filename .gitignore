# NEVER commit these
.env
node_modules/
*.log
.DS_Store

# Android / Capacitor build artifacts — machine-specific or regenerated on build
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/captures/
android/.idea/
android/*.iml
android/app/*.iml
*.keystore
*.jks

# APK is no longer stored in git — it's uploaded to Vercel Blob
# Storage by scripts/publish-apk.js. Only the small metadata JSON
# (public/downloads/app-meta.json) stays tracked.
public/downloads/*.apk