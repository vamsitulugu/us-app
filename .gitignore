# NEVER commit these
.env
.env.local
.env.*.local
node_modules/
*.log
.DS_Store

*.keystore
*.jks

# APK is no longer stored in git — it's uploaded to Vercel Blob
# Storage by scripts/publish-apk.js. Only the small metadata JSON
# (public/downloads/app-meta.json) stays tracked.
public/downloads/*.apk

# 3D cinema: source lives in cinema/; the built copy in public/cinema/ IS committed (run: npm run build:cinema)
cinema/node_modules/
cinema/dist/
