# ════════════════════════════════════════════════════════════════
#  Twin Hearts — Environment Variables
#  Copy this file to .env and fill in your actual values.
# ════════════════════════════════════════════════════════════════

# ─── Supabase (required) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── Groq AI (optional — AI features) ──────────────────
GROQ_API_KEY=your_groq_api_key

# ─── App Config ────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_PUBLIC_URL=https://your-app.onrender.com

# ─── Security (required) ───────────────────────────────
SESSION_SECRET=your_session_secret_change_this

# ─── Admin Auth (required for Admin Control Center) ────
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_SESSION_SECRET=your_admin_session_secret_change_this
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$10$...

# ─── Web Push (VAPID) (optional — push notifications) ───
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=your-email@domain.com

# ─── Firebase (optional — native Android push) ─────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ─── Metered API (optional) ────────────────────────────
METERED_API_KEY=a09e9e61fe66f81ba1809f60a904405fbe29

# Movie search (TMDB). Set these on Render so /api/movie-search works.
TMDB_API_KEY=3ee8bb869b3fc960cf15d4753c106b03
# Optional: the long "API Read Access Token" from themoviedb.org/settings/api
# TMDB_READ_TOKEN=eyJhbGciOiJIUzI1NiJ9...