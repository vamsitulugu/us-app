-  // ── 18. Placement animations ─────────────────
-  function playPlacementAnim(obj) {
-    obj.scale.setScalar(0.01);
-    const target = 1.0;
-    let t = 0;
-    const tick = () => {
-      t += 0.06;
-      const s = target * (1 - Math.pow(1 - Math.min(t, 1), 3));
-      obj.scale.setScalar(s);
-      if (t < 1) requestAnimationFrame(tick);
-    };
-    requestAnimationFrame(tick);
-  }
