-    for (const [key, def] of eligible) {
-      r -= def.weight;
-      if (r <= 0) return { key, def };
-    }
-    return eligible[0] ? { key: eligible[0][0], def: eligible[0][1] } : null;
-  }
-
-  // ── Fire an event ───────────────────────────────
-  function _fire(key, def) {
-    HomeStateManager.setLastEvent(key);
-    try { def.trigger(); } catch (e) {
