-  // ── Boot sequence ───────────────────────────
-  async function boot() {
-    loadProgress(10);
-
-    // 1. Init Three.js scene
-    const canvas = document.getElementById('homeCanvas');
-    HomeScene.init(canvas);
-    loadProgress(30);
-
-    // 2. Build room nav
-    buildRoomNav();
-    loadProgress(45);
-
-    // 3. Load settings from server
-    const cid = HomeUtils.getCoupleId();
-    if (cid) {
-      try {
-        const s = await HomeAPI.settings.get(cid);
-        if (s) {
-          _settings.tod     = s.time_of_day  || 'day';
-          _settings.weather = s.weather      || 'clear';
-          _settings.theme   = s.theme        || 'cozy';
-          applySettingChips();
-          HomeScene.setTimeOfDay(_settings.tod);
-          HomeScene.setWeather(_settings.weather);
-          // Switch to saved room
-          if (s.active_room) switchRoom(s.active_room, true);
-        }
-      } catch(e) { /* use defaults */ }
-    }
-    loadProgress(70);
-
-    // 4. Build rooms (Phase 3) — falls back to placeholder if rooms.js failed to load
-    if (window.HomeRooms) {
-      HomeRooms.init(HomeScene.getScene());
-    } else {
-      addFloorPlane();
-    }
-    loadProgress(90);
-// ════ ADD: Phase 6 — Living World init ════
-    // Placed after rooms exist (so avatars/pets land on a real floor)
-    // and before loadProgress(100), so the loading screen doesn't
-    // disappear before avatars/pets have been added to the scene.
-    // Each module is guarded individually (same pattern as HomeRooms
-    // above) so a missing/404'd Phase-6 file degrades gracefully
-    // instead of aborting the entire boot.
-    if (window.HomeAvatars) {
-      const scn = HomeScene.getScene();
-      const cam = HomeScene.getCamera();
-      const rnd = HomeScene.getRenderer();
-
-      HomeAvatars.init(scn);
-      if (window.HomeMovement)        HomeMovement.init(cam, canvas, scn);
-      if (window.HomeInteractions)    HomeInteractions.init(scn);
-      if (window.HomePets)            HomePets.init(scn);
-      if (window.HomeAIBehavior)      HomeAIBehavior.init(scn);
-      if (window.HomeRealtimeLiving)  HomeRealtimeLiving.init();
-      if (window.HomeAudioLiving)     HomeAudioLiving.init();
-      if (window.HomePerfLiving)      HomePerfLiving.init(rnd);
-      if (window.HomeInteractionUI)   HomeInteractionUI.init(cam, canvas);
-
-      HomeAvatars.loadCustomization();
-
-      if (window.HomePerfLiving && HomePerfLiving.getIsMobile && HomePerfLiving.getIsMobile()) {
-        const joyEl = document.getElementById('homeJoystick');
-        joyEl.style.display = 'block';
-        if (window.HomeMovement) HomeMovement.initJoystick(joyEl);
-      }
