-  // ── Presence heartbeat ────────────────────────
-  // Pushed via Supabase Realtime presence (HomeEnvironmentSync's channel) instead
-  // of separate HTTP polling loops. This replaces the old sendPresence (20s) +
-  // pollPresence (25s) timers with the same channel/presence that
-  // home/realtime_living.js and environment_sync.js already maintain — one
-  // presence system instead of two. Falls back to the old HTTP polling only if
-  // the realtime channel never comes up (matches environment_sync's own
-  // polling fallback behavior).
-  function startPresenceHeartbeat() {
-    const cid  = HomeUtils.getCoupleId();
-    const role = HomeUtils.getMyRole();
-    if (!cid) return;
-
-    function renderPresence(partner) {
-      if (partner) {
-        const room  = ROOMS[partner.room]?.label || partner.room;
-        const pName = HomeUtils.getPartnerName();
-        document.getElementById('partnerPresenceText').textContent =
-          `${pName} is in the ${room}`;
-        document.getElementById('partnerPresence').classList.add('show');
-      } else {
-        document.getElementById('partnerPresence').classList.remove('show');
-      }
-    }
