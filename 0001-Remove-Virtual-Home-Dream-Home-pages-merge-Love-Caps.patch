-  // ── Floor placeholder (replaced by rooms.js in Phase 3) ──
-  function addFloorPlane() {
-    const geo = new THREE.PlaneGeometry(30, 30);
-    const mat = new THREE.MeshStandardMaterial({
-      color: 0x1a1025, roughness: 0.9, metalness: 0.05
-    });
-    const floor = new THREE.Mesh(geo, mat);
-    floor.rotation.x = -Math.PI / 2;
-    floor.receiveShadow = true;
-    floor.name = 'tempFloor';
-    HomeScene.add(floor);
-
-    // Grid helper (subtle)
-    const grid = new THREE.GridHelper(30, 30, 0x2a2040, 0x1e1830);
-    grid.name = 'tempGrid';
-    HomeScene.add(grid);
-
-    // Placeholder "coming soon" objects until rooms.js is loaded
-    addPlaceholderObjects();
-  }
-
-  function addPlaceholderObjects() {
-    const sc = HomeScene.getScene();
-    // Central glowing sphere as placeholder
-    const geo = new THREE.SphereGeometry(0.4, 24, 24);
-    const mat = new THREE.MeshStandardMaterial({
-      color: 0x6060ff, emissive: 0x3030aa,
-      emissiveIntensity: 0.8, roughness: 0.2, metalness: 0.4
-    });
-    const sphere = new THREE.Mesh(geo, mat);
-    sphere.position.set(0, 0.4, 0);
-    sphere.castShadow = true;
-    sphere.name = 'placeholder';
-    sc.add(sphere);
-
-    // Animate it a bit in scene loop
-    let t = 0;
-    const _orig = HomeScene.state;
-    const tick = () => {
-      if (!sphere.parent) return;
-      t += 0.016;
-      sphere.position.y  = 0.4 + Math.sin(t * 1.2) * 0.12;
-      sphere.rotation.y += 0.01;
-      requestAnimationFrame(tick);
-    };
-    tick();
-  }
-
-  // ── Room nav ─────────────────────────────────
-  function buildRoomNav() {
-    const nav = document.getElementById('roomNav');
