-    selfie:       { love: +3,  excitement: +5, mood: +4 },
-    watchTV:      { comfort: +3, stress: -4 },
-    listenMusic:  { comfort: +4, mood: +5, stress: -3 },
-    cookTogether: { love: +4,  trust: +3, mood: +3 },
-    playGames:    { excitement: +7, mood: +5, stress: -2 },
