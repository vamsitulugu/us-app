-    if (last > 0 && (now - last / 1000) < def.cooldown) return false;
-
-    const period  = window.HomeDailyRoutine ? HomeDailyRoutine.getPeriod() : null;
-    if (def.periodFilter && period && !def.periodFilter.includes(period)) return false;
