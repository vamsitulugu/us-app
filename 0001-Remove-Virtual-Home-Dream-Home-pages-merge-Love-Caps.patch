-      const el = document.createElement('div');
-      el.className = 'room-tab' + (key === 'living' ? ' active' : '');
-      el.dataset.room = key;
-      el.innerHTML = `<div class="rt-ico">${room.icon}</div><div class="rt-lbl">${room.label.split(' ')[0]}</div>`;
-      el.onclick = () => switchRoom(key);
-      nav.appendChild(el);
