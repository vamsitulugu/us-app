-  function animateWave(waveWrap, isPlayingFn) {
-    const bars = [...waveWrap.querySelectorAll('div')];
-    let frame = 0;
-    function tick() {
-      if (!isPlayingFn()) return;
-      frame++;
-      bars.forEach((b, i) => {
-        const h = 4 + Math.abs(Math.sin(frame * 0.15 + i * 0.4)) * 20;
-        b.style.height = h + 'px';
