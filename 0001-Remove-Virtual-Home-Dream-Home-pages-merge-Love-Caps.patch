-    if (newHover !== _state.hoveredItem) {
-      if (_state.hoveredItem) clearHoverHighlight(_state.hoveredItem);
-      if (newHover && !newHover.userData.locked) setHoverHighlight(newHover);
-      _state.hoveredItem = newHover;
-    }
-  }
