-    let usingRealtime = false;
-
-    window.addEventListener('home:partnerPresenceUpdate', (e) => {
-      usingRealtime = true;
-      renderPresence(e.detail?.presence || null);
-    });
-
-    // If HomeEnvironmentSync is already connected by the time we get here,
-    // paint the current state immediately rather than waiting for the next change.
-    if (window.HomeEnvironmentSync && HomeEnvironmentSync.isReady()) {
-      usingRealtime = true;
-      renderPresence(HomeEnvironmentSync.getPartnerPresence());
-    }
-
-    // Fallback: only kicks in if realtime never becomes ready (channel error/offline),
-    // same condition environment_sync.js itself falls back to polling under.
-    setTimeout(() => {
-      if (usingRealtime) return;
-
-      function sendPresence() {
-        const room = HomeScene.state.currentRoom;
-        HomeAPI.presence.update({ coupleId: cid, userRole: role, room }).catch(() => {});
-      }
-      sendPresence();
-      setInterval(sendPresence, 20000);
-
-      async function pollPresence() {
-        try {
-          const all = await HomeAPI.presence.get(cid);
-          const partner = all.find(p => p.user_role !== role);
-          if (partner) {
-            const since = Date.now() - new Date(partner.last_seen).getTime();
-            renderPresence(since < 35000 ? partner : null);
-          }
-        } catch(e) {}
-      }
-      pollPresence();
-      setInterval(pollPresence, 25000);
-    }, 4000);
-  }
