-      memData.pos_x || 0,
-      memData.pos_y || 0,
-      memData.pos_z || 0
-    );
-    obj3d.rotation.y = memData.rot_y || 0;
-    obj3d.userData = {
-      ...obj3d.userData,
-      memoryId:  memData.id,
-      memType:   memData.memory_type,
