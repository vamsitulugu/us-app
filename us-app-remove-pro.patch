-    } else {
-      wrap.classList.add('th-hidden');
-      if (box) box.style.display = 'none';
-      if (btn) btn.textContent = '📷 Scan QR Code';
-    }
-  }
-
-  async function toggleScanner() {
-    if (scannerActive) { await stopScanner(); return; }
-    // pause any other scanner
-    await stopScanner();
-    await startScanner();
-  }
