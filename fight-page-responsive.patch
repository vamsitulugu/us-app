+    /* ── Fight Log: laptop / desktop / tablet layouts ── */
+    .fl-col { min-width: 0 }
+    .fl-col-b .fl-section-head { margin-top: 0 }
+
+    /* Tablet + up: bigger ring, roomier cards */
+    @media (min-width: 701px) {
+      .fl-ring { width: 150px; height: 150px }
+      .fl-ring-pct { font-size: 34px }
+      .fl-metrics { gap: 16px }
