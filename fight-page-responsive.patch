+      .fl-panel { padding: 24px }
+      .fl-chips { gap: 12px }
+    }
+
+    /* Laptop / desktop: dashboard becomes two columns */
+    @media (min-width: 1000px) {
+      .fl-view[data-view="dashboard"].active {
+        display: grid;
+        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
+        gap: 24px;
+        align-items: start;
+      }
+      .fl-cta { margin-bottom: 0 }
+      .fl-col-a .fl-metrics { margin-bottom: 16px }
+      .fl-ring { width: 170px; height: 170px }
+      .fl-section-head h3 { font-size: 20px }
+
+      /* Log wizard: wide panel, steps spread out, comfortable form */
+      .fl-view[data-view="log"] .fl-panel { padding: 30px 34px }
+      .fl-view[data-view="log"] .fl-pane.active { display: grid; grid-template-columns: 1fr 1fr; gap: 26px 36px; align-items: start }
+      .fl-view[data-view="log"] .fl-group + .fl-group { margin-top: 0 }
+      .fl-view[data-view="log"] .fl-group:first-child,
+      .fl-view[data-view="log"] .fl-pane[data-step="2"] .fl-group,
+      .fl-view[data-view="log"] .fl-pane[data-step="3"] .fl-group { grid-column: 1 / -1 }
+      .fl-view[data-view="log"] .fl-area textarea { min-height: 120px }
+      #flNext { max-width: 420px; margin-left: auto; margin-right: 0 }
+
+      /* Activities: two-column card grid */
+      #flActList { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; align-items: start }
+      #flActList .fl-act { margin-bottom: 0 }
+    }
+
+    /* Large desktop / ultrawide: three activity columns, keep dashboard balanced */
+    @media (min-width: 1500px) {
+      #flActList { grid-template-columns: repeat(3, 1fr) }
+      .fl-view[data-view="dashboard"].active { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px }
+    }
