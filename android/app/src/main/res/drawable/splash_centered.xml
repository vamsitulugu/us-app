<?xml version="1.0" encoding="utf-8"?>
<!--
  Responsive launch-screen background.

  The previous windowBackground pointed straight at @drawable/splash, a
  per-density raster image. As a windowBackground, Android stretches/crops
  that bitmap to fill the entire window — on phones whose aspect ratio
  doesn't match the source image (very tall/narrow screens, foldables,
  tablets) this crops into the centered logo, making it look oversized or
  cut off and breaking the layout.

  This layer-list instead paints a flat brand-color background, then places
  the logo as a fixed-size, centered item. android:gravity="center" never
  scales the drawable beyond the width/height given below, so the logo
  keeps its proportions and can never overflow the screen, regardless of
  device size — matching what the JS-driven Capacitor SplashScreen now
  does with androidScaleType: CENTER_INSIDE.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground" />
    <item
        android:width="176dp"
        android:height="176dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
