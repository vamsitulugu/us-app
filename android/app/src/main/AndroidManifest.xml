<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <meta-data
    android:name="com.google.firebase.messaging.default_notification_icon"
    android:resource="@drawable/ic_stat_notify" />
<meta-data
    android:name="com.google.firebase.messaging.default_notification_color"
    android:resource="@color/notification_icon_color" />

        <!-- Overrides com.capacitorjs.plugins.pushnotifications.MessagingService
             (declared with the same intent-filter in that library's own
             manifest) so every push we receive goes through our own
             styled builder (channels, MessagingStyle, CallStyle, action
             buttons) instead of the library's plain auto-notification.
             tools:node="replace" is required because two <service>
             entries can't otherwise both claim the same
             MESSAGING_EVENT intent-filter during manifest merging. -->
        <service
            android:name="com.uswithlove.app.notifications.TwinHeartsMessagingService"
            android:exported="false"
            tools:node="replace">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.uswithlove.app.notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- ═══ Background Location Tracking (item 1) ═══ -->
        <!-- foregroundServiceType="location" is REQUIRED on API 34+ (Android 14)
             — omitting it makes the OS throw a MissingForegroundServiceTypeException
             at startForeground() time. -->
        <service
            android:name=".tracking.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".tracking.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Used by the existing call.js / couple-karaoke.js features, which
         already call navigator.mediaDevices.getUserMedia(). Without these,
         Android blocks the permission prompt entirely and calls/karaoke
         mic capture silently fail — no JS change needed, only this. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Used by the existing livemap.js / meetplanner.js / places.html
         features, which already call navigator.geolocation. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ═══ Background Location Tracking (item 1) — new ═══ -->
    <!-- Android 10+ (API 29+) requires this as a SEPARATE grant from the
         two above, requested only after foreground location is already
         granted (see BackgroundLocationPlugin). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required to run a foreground service at all (API 28+), and the
         location-typed variant specifically on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Lets BootReceiver restart tracking automatically after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: improves activity_type accuracy (still/walking/driving)
         beyond the speed-based heuristic already used as a fallback in
         LocationForegroundService. Requested lazily — the service works
         fine without it if the person declines. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the incoming-call notification launch full-screen over the
         lock screen, the way a real phone call does. Android treats this
         as a "special" permission the Play Store reviews on submission —
         it's already scoped correctly here since it's only used for
         CallStyle/incoming-call notifications (see
         TwinHeartsMessagingService.showIncomingCall). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
