 <html lang="en" data-theme-lock="dark">
 <head>
 <script src="/theme.js"></script>
+<script>
+/* Mobile start screen: on phones (mobile web or the Android APK) with no
+   signed-in session, skip the marketing landing page and show the app-style
+   start screen instead. Runs before first paint so there is no flash. */
+(function(){
+  try{
+    var native=!!(window.Capacitor&&window.Capacitor.isNativePlatform&&window.Capacitor.isNativePlatform());
+    var ua=/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent||'');
+    var narrow=window.matchMedia&&window.matchMedia('(max-width: 820px)').matches;
+    var s=JSON.parse(localStorage.getItem('uwl_v5')||'{}');
+    var signedIn=!!(s&&s.setupDone&&s.coupleId);
+    var forced=/[?&]desktop=1/.test(location.search);
+    if((native||ua||narrow)&&!signedIn&&!forced) document.documentElement.classList.add('ms-on');
+  }catch(e){}
+})();
+</script>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no, viewport-fit=cover">
 <title>Twin Hearts 💕 — Everything Together.</title>
@@ -290,6 +306,46 @@ footer p{font-size:11px;color:var(--text3)}
