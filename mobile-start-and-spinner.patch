 body.native-auth-only #authModal{position:fixed;background:var(--bg,#14030e)}
 body.native-auth-only #authModal .modal-close{display:none}
+
+/* ── Mobile start screen (phones: web + APK, logged-out) ─────────── */
+#mobileStart{display:none}
+html.ms-on body > *:not(#mobileStart):not(#authModal){display:none!important}
+html.ms-on #mobileStart{display:flex}
+html.ms-on.ms-auth #mobileStart{display:none}
+html.ms-on #authModal{position:fixed;background:linear-gradient(180deg,#3A0425,#14030e)}
+#mobileStart{position:fixed;inset:0;z-index:900;flex-direction:column;align-items:center;overflow:hidden;
