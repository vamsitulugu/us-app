+.ms-hero{position:relative;text-align:center;margin-top:26px}
+.ms-hero h1{font-family:var(--ff-serif);font-weight:400;font-size:clamp(34px,11vw,48px);line-height:1;margin:0;
+  background:linear-gradient(180deg,#ffb3e6,#f07bd0 55%,#d9b3ff);-webkit-background-clip:text;background-clip:text;color:transparent}
+.ms-hero p{margin:12px 0 0;font-size:11px;letter-spacing:3px;text-transform:uppercase;opacity:.9}
+.ms-art{position:relative;flex:1;min-height:0;width:100%;display:flex;align-items:flex-end;justify-content:center;margin-top:10px}
+.ms-art img{max-height:100%;max-width:100%;object-fit:contain;
+  -webkit-mask-image:linear-gradient(180deg,#000 80%,transparent);mask-image:linear-gradient(180deg,#000 80%,transparent)}
+.ms-actions{position:relative;width:100%;max-width:420px;margin-top:14px}
+.ms-start{width:100%;display:flex;align-items:center;justify-content:space-between;padding:8px 8px 8px 30px;border:none;cursor:pointer;
+  border-radius:999px;background:#fff;color:#8a0f5e;font:800 15px var(--ff-sans);letter-spacing:1.5px;text-transform:uppercase;
+  box-shadow:0 10px 34px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.4)}
+.ms-start i{width:48px;height:48px;border-radius:50%;background:#8a0f5e;color:#fff;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:20px}
+.ms-start:active{transform:scale(.98)}
+/* step 2: Sign In / Sign Up cards */
+.ms-choose{display:none;width:100%;gap:14px;flex-direction:column}
+#mobileStart.ms-step2 .ms-start{display:none}
+#mobileStart.ms-step2 .ms-choose{display:flex}
+.ms-card{display:flex;align-items:center;gap:14px;width:100%;padding:18px 18px;border-radius:22px;cursor:pointer;text-align:left;color:#fff;
+  background:rgba(20,3,14,.62);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,160,225,.35);font-family:var(--ff-sans)}
+.ms-card.primary{background:linear-gradient(135deg,#b0127a,#d6379b);border-color:rgba(255,255,255,.35)}
+.ms-card .ico{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
+.ms-card b{display:block;font-size:16px}
+.ms-card span{display:block;font-size:12px;opacity:.8;margin-top:2px}
+.ms-back{background:none;border:none;color:rgba(255,255,255,.75);font:500 13px var(--ff-sans);padding:6px;cursor:pointer}
 .mcard{background:rgba(9,4,7,.96);backdrop-filter:blur(30px);border:1px solid var(--border2);border-radius:26px;padding:36px 32px;width:100%;max-width:460px;color:var(--white);box-shadow:0 30px 90px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.06);animation:popIn .35s cubic-bezier(.34,1.56,.64,1);position:relative;max-height:88vh;overflow-y:auto}
 @keyframes popIn{from{opacity:0;transform:scale(.88) translateY(16px)}to{opacity:1;transform:scale(1) translateY(0)}}
 .modal-close{position:absolute;top:16px;right:18px;background:var(--g1);border:1px solid var(--border);border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);font-size:16px;transition:all .2s}
