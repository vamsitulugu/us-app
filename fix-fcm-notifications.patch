From 1f3d99da16322114a7d9042739e9455f4bc91104 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 31 Jul 2026 11:35:23 +0000
Subject: [PATCH] fix(notifications): stop silent FCM registration failures on
 native Android

Two real bugs found while tracing why user1's fcm_tokens row never
gets created despite OS-level notification permission being granted:

1. Listener race: PushNotifications.register() was awaited BEFORE the
   'registration' token listener was attached. If the native side
   fires that event quickly (common), the listener isn't wired up yet
   and the token is lost silently with no error on either side.

2. No error visibility anywhere in the chain: no try/catch around
   requestPermissions()/register(), and no 'registrationError'
   listener at all, so a failed native registration (bad Play
   Services, config issue, etc) produced zero trace. Also no try/catch
   around the register-fcm-token POST, so a rejected backend call was
   swallowed too.

Also fixed a narrower bug in the web auto-prompt: the
'already asked' localStorage flag was set BEFORE
Notification.requestPermission() resolved, so a dismissed
(not explicitly denied) browser dialog permanently skipped the
one-time retry with permission stuck at 'default'.

No unrelated code touched.
---
 public/index.html | 57 ++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 49 insertions(+), 8 deletions(-)

diff --git a/public/index.html b/public/index.html
index 621462c..2158200 100644
--- a/public/index.html
+++ b/public/index.html
@@ -9347,9 +9347,17 @@ if (window.Capacitor?.Plugins?.SplashScreen) {
           // permission needs a deliberate re-enable via the Settings
           // toggle, not another surprise prompt.
           if ('Notification' in window && Notification.permission === 'default' && !localStorage.getItem('notifAutoPromptShown')) {
-            localStorage.setItem('notifAutoPromptShown', '1');
             setTimeout(async () => {
               const p = await Notification.requestPermission();
+              // Only remember "already asked" once the browser actually
+              // returned a real answer (granted/denied). Some browsers
+              // resolve requestPermission() with 'default' again if the
+              // user dismissed the dialog (e.g. clicked away) without
+              // explicitly choosing Allow/Block — if we set the flag
+              // unconditionally *before* this call, that dismissal
+              // permanently prevented ever asking again, so the device
+              // was stuck with no subscription and no further prompt.
+              if (p !== 'default') localStorage.setItem('notifAutoPromptShown', '1');
               if (p === 'granted') { await registerPushSubscription(); syncNotifToggleUI(); }
             }, 4000);
           }
@@ -10226,14 +10234,47 @@ document.addEventListener('keydown', e => {
         window.setTheme = function(n, s) { _origST && _origST(n, s); setTimeout(() => ['gamesFrame','musicFrame','dreamgoalsFrame','placesFrame','lovecounterFrame','collectionFrame','meetplannerFrame'].forEach(syncThemeToFrame), 150); };
 
         async function setupNativeNotifications() {
-  if (!window.Capacitor?.isNativePlatform?.()) return; // only runs in the APK, not on web
+  if (!window.Capacitor?.isNativePlatform?.()) { console.log('[fcm] skip — not running inside the native app'); return; }
   const { PushNotifications } = window.Capacitor.Plugins;
-  const perm = await PushNotifications.requestPermissions();
-  if (perm.receive !== 'granted') return;
-  await PushNotifications.register();
-  PushNotifications.addListener('registration', async (token) => {
-    await api('POST', '/api/auth/register-fcm-token', { coupleId: S.coupleId, role: S.role, userId: S.userId, token: token.value });
-  });
+  try {
+    console.log('[fcm] requesting permission…');
+    const perm = await PushNotifications.requestPermissions();
+    console.log('[fcm] permission result:', perm.receive);
+    if (perm.receive !== 'granted') { console.warn('[fcm] STOP — permission not granted:', perm.receive); return; }
+
+    // Surface registration failures instead of dying silently. register()
+    // itself usually resolves even when the underlying FCM getToken()
+    // call fails on-device (missing/invalid google-services.json config,
+    // no Google Play Services, network issue, etc) — the real failure
+    // only ever showed up via this event, which nothing was listening
+    // for, so the whole flow looked like it "did nothing" with zero clue
+    // why no fcm_tokens row ever got created.
+    PushNotifications.addListener('registrationError', (err) => {
+      console.error('[fcm] STOP — native registration failed:', JSON.stringify(err));
+    });
+
+    // Attach the token listener BEFORE calling register() — register()
+    // can fire the native 'registration' event almost immediately, and
+    // if this listener isn't wired up yet that event is lost forever
+    // with no error on either side. This ordering bug alone would fully
+    // explain "permission granted, register() ran, nothing happened."
+    PushNotifications.addListener('registration', async (token) => {
+      console.log('[fcm] token received, length', token?.value?.length, '— sending to backend…');
+      try {
+        const res = await api('POST', '/api/auth/register-fcm-token', { coupleId: S.coupleId, role: S.role, userId: S.userId, token: token.value });
+        console.log('[fcm] backend accepted token:', JSON.stringify(res));
+      } catch (err) {
+        console.error('[fcm] STOP — backend rejected token POST:', err?.message || err);
+      }
+    });
+
+    console.log('[fcm] calling register()…');
+    await PushNotifications.register();
+    console.log('[fcm] register() resolved, waiting for token event…');
+  } catch (err) {
+    console.error('[fcm] STOP — requestPermissions()/register() threw:', err?.message || err);
+    return;
+  }
   // Fires when the user taps a native FCM notification — whether the app
   // was in the background or fully closed (cold start). The url we now
   // send in the FCM `data` payload (see sendFCMToPartner in routes/auth.js)
