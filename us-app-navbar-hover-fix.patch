+/* ── Mini Twin Orb — bottom nav (Twin is now the centered, hero
+   destination) ──
+   Reuses the exact same .twin-orb layers as the main AI page's orb
+   (to-aura / to-core / to-energy / to-highlight) rather than inventing
+   a second visual identity — only a silver energy-sweep variant and
+   smaller sizing are added on top. Pure CSS (no canvas/WebGL, no JS
+   animation loop), so running it continuously across every page the
+   navbar appears on costs nothing beyond what the rest of the navbar
+   already costs. */
+.nav-twin-ico--mini .twin-orb { width: 22px; height: 22px; }
+.twin-orb--navmini { --orb-size: 22px; }
+.twin-orb--navmini .to-aura { inset: -5px; opacity: .3; animation-duration: 4.5s; }
+.twin-orb--navmini .to-core { animation-duration: 4.5s; }
+.twin-orb--navmini .to-highlight { opacity: .45; }
+/* Silver/soft-white flowing waves — a restrained conic sweep standing in
+   for hand-drawn wave lines: cheap, GPU-composited, and reads as moving
+   light across the sphere rather than a spinning loader (it's slow and
+   the base sphere itself never rotates). */
+.to-energy--silver {
+  background: conic-gradient(from 0deg,
+    transparent 0deg, rgba(235,235,245,0.6) 45deg, transparent 110deg,
+    rgba(255,255,255,0.4) 200deg, transparent 260deg, rgba(210,215,230,0.35) 330deg, transparent 360deg);
+  animation: twinEnergySpin 10s linear infinite;
+  opacity: .5;
+}
+/* Idle breathing — very subtle, must never compete with the currently
+   active page. */
+.bot-ni--twin:not(.active) .twin-orb--navmini { opacity: .82; }
+/* Active Twin — orb becomes visibly "more alive": brighter waves, richer
+   core, slightly larger, one restrained pulse on entry. The normal red
+   active-indicator/label treatment below still applies on top of this,
+   unchanged from every other nav destination. */
+.bot-ni--twin.active .twin-orb--navmini {
+  transform: scale(1.08);
+  animation: twinNavActivate .3s ease;
+}
+.bot-ni--twin.active .to-energy--silver { opacity: .95; animation-duration: 5.5s; }
+.bot-ni--twin.active .to-aura { opacity: .6; animation-duration: 2.6s; }
+.bot-ni--twin.active .to-core { filter: saturate(1.15) brightness(1.08); animation-duration: 2.4s; }
+@keyframes twinNavActivate { 0% { transform: scale(1); } 55% { transform: scale(1.14); } 100% { transform: scale(1.08); } }
+@media (prefers-reduced-motion: reduce) {
+  .twin-orb--navmini .to-aura, .twin-orb--navmini .to-core, .twin-orb--navmini .to-energy { animation: none !important; }
+}
