+        // ── Bottom nav: route is the single source of truth ──
+        // Previously the bottom nav's active/red state was ONLY set by its
+        // own click handler (removeAll-then-add-one on that one element).
+        // goto() — the actual central router, also reachable via internal
+        // links, deep links, notification taps, and popstate/Back — never
+        // touched .bot-ni at all. So any navigation that didn't originate
+        // from tapping the bottom nav left its previous active item red
+        // forever, and the next bottom-nav tap only ever added a new active
+        // item without the stale one ever being cleared first — hence
+        // multiple red destinations accumulating over time. Fixing this
+        // requires goto() itself to own bottom-nav state, not another
+        // click-handler patch.
+        // Only these 7 page ids are actually represented in the bottom
+        // nav; anything else (e.g. Calendar, opened from a dashboard card)
+        // correctly leaves the bottom nav showing no active destination,
+        // matching its own previous state — this list intentionally exists
+        // so any subpage of a bottom-nav destination can map back to its
+        // owner in one place instead of duplicating logic per page.
+        const NAV_ROUTE_MAP = {
+          dashboard: 'dashboard', chat: 'chat', globe: 'globe', ai: 'ai',
+          games: 'games', movie: 'movie', settings: 'settings'
+        };
+        function syncBotNav(page) {
+          const owner = NAV_ROUTE_MAP[page] || null;
+          document.querySelectorAll('.bot-ni').forEach(n => n.classList.remove('active'));
+          if (owner) {
+            const el = document.querySelector('.bot-ni[data-page="' + owner + '"]');
+            if (el) el.classList.add('active');
+          }
+        }
