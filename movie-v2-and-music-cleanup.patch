+
+  // ═══════════ Add / edit ═══════════
+  function buildFormStatic() {
+    $('mcGenre').innerHTML = Object.keys(GENRES).map((n) => `<option value="${esc(n)}">${GENRES[n].e} ${esc(n)}</option>`).join('');
