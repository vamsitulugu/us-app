+  function paintStars(v) { document.querySelectorAll('#mcStars .mc-star').forEach((b) => { const on = Number(b.dataset.v) <= v; b.classList.toggle('on', on); b.textContent = on ? '★' : '☆'; }); }
+  function paintPoster(src) {
