diff --git a/public/movie-collection.css b/public/movie-collection.css
new file mode 100644
index 0000000..a4bd546
--- /dev/null
+++ b/public/movie-collection.css
@@ -0,0 +1,111 @@
+/* Movie page — tabs, banner, library grid, genres, details, forms (v1) */
+.wt-tabs { position: sticky; top: 0; z-index: 5; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 6px; margin: 0 0 4px;
+  background: rgba(14,5,9,0.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--wt-card-brd); border-radius: 18px; }
+.wt-tab { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 8px 4px; border: 0; background: transparent; color: var(--wt-muted); border-radius: 13px; font: inherit; font-size: 11px; font-weight: 700; cursor: pointer; }
+.wt-tab svg { width: 20px; height: 20px; }
+.wt-tab.is-active { background: rgba(255,59,92,0.16); color: #fff; box-shadow: 0 0 0 1px rgba(255,59,92,0.35) inset; }
+.wt-tabpane { display: flex; flex-direction: column; gap: 12px; }
+.wt-tabpane[hidden] { display: none; }
+
+/* Banner */
+.mc-banner { position: relative; min-height: 300px; border-radius: 24px; overflow: hidden; background-size: cover; background-position: center top; border: 1px solid var(--wt-card-brd); display: flex; align-items: flex-end; }
+.mc-banner-empty { background: radial-gradient(90% 120% at 50% 0%, rgba(255,59,92,0.4), rgba(255,59,92,0) 65%), linear-gradient(180deg, #3a0c1a, #14060c); }
+.mc-banner-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,2,5,0.96) 6%, rgba(8,2,5,0.35) 55%, rgba(8,2,5,0.15)); }
+.mc-banner-emoji { position: absolute; top: 18%; left: 0; right: 0; text-align: center; font-size: 64px; opacity: .9; }
+.mc-banner-more { position: absolute; top: 12px; right: 12px; z-index: 2; width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); background: rgba(0,0,0,.45); color: #fff; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
+.mc-banner-more svg { width: 20px; height: 20px; }
+.mc-banner-body { position: relative; z-index: 1; width: 100%; padding: 18px; display: flex; flex-direction: column; gap: 10px; }
+.mc-banner-title { font-size: 28px; font-weight: 800; line-height: 1.1; text-shadow: 0 2px 10px rgba(0,0,0,.6); }
+.mc-banner-sub { margin: 0; color: #e6cdd3; font-size: 13px; }
+.mc-banner-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.mc-banner-btns .wt-btn { min-height: 46px; font-size: 14px; }
+.mc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.mc-chips span { padding: 4px 10px; border-radius: 14px; font-size: 11px; font-weight: 700; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14); color: #f1e6e9; }
+
+/* Rows + cards */
+.mc-row-head { display: flex; align-items: center; justify-content: space-between; margin: 8px 2px -2px; }
+.mc-row-head h3 { margin: 0; font-size: 17px; }
+.mc-seeall { background: none; border: 0; color: var(--wt-muted); font: inherit; font-size: 12px; display: flex; align-items: center; gap: 2px; }
+.mc-seeall svg { width: 14px; height: 14px; }
+.mc-hscroll { display: flex; gap: 12px; overflow-x: auto; padding: 2px 2px 8px; scrollbar-width: none; margin: 0 -2px; }
+.mc-hscroll::-webkit-scrollbar { display: none; }
+.mc-hscroll .mc-card { flex: 0 0 112px; }
+.mc-card { display: flex; flex-direction: column; gap: 4px; text-align: left; background: none; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; min-width: 0; }
+.mc-poster { position: relative; display: block; width: 100%; aspect-ratio: 2 / 3; border-radius: 14px; overflow: hidden; background-size: cover; background-position: center; border: 1px solid var(--wt-card-brd); box-shadow: 0 6px 16px rgba(0,0,0,.35); }
+.mc-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 34px; }
+.mc-fav { position: absolute; top: 6px; right: 6px; width: 28px; height: 28px; border-radius: 50%; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; font-size: 14px; color: #fff; backdrop-filter: blur(6px); }
+.mc-fav.on { color: #ffd54a; }
+.mc-card-title { font-size: 12px; font-weight: 700; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.mc-card-meta { font-size: 10.5px; color: var(--wt-muted); }
+.mc-empty { text-align: center; padding: 26px 14px; color: var(--wt-muted); display: flex; flex-direction: column; align-items: center; gap: 8px; background: var(--wt-card); border: 1px dashed var(--wt-card-brd); border-radius: 20px; }
+.mc-empty > div { font-size: 40px; } .mc-empty p { margin: 0 0 6px; font-size: 13px; line-height: 1.5; }
+
+/* Library */
+.mc-toolbar { display: flex; gap: 10px; }
+.mc-search { flex: 1; display: flex; align-items: center; gap: 8px; padding: 0 14px; min-height: 46px; border-radius: 15px; background: var(--wt-card); border: 1px solid var(--wt-card-brd); }
+.mc-search svg { width: 18px; height: 18px; color: var(--wt-muted); flex-shrink: 0; }
+.mc-search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: #fff; font: inherit; font-size: 14px; }
+.mc-add-btn { display: flex; align-items: center; gap: 6px; padding: 0 16px; border: 0; border-radius: 15px; background: var(--wt-grad); color: #fff; font: inherit; font-weight: 800; font-size: 13px; box-shadow: 0 6px 16px rgba(214,16,42,.35); }
+.mc-add-btn svg { width: 18px; height: 18px; }
+.mc-stats { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
+.mc-stat { flex: 1 0 auto; min-width: 62px; padding: 8px 10px; border-radius: 14px; background: var(--wt-card); border: 1px solid var(--wt-card-brd); text-align: center; }
+.mc-stat b { display: block; font-size: 16px; } .mc-stat span { font-size: 9.5px; color: var(--wt-muted); text-transform: uppercase; letter-spacing: .05em; }
+.mc-chiprow { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 1px 0; }
+.mc-chiprow::-webkit-scrollbar { display: none; }
+.mc-chip { flex: 0 0 auto; padding: 8px 14px; border-radius: 20px; border: 1px solid var(--wt-card-brd); background: var(--wt-card); color: #e9dfe2; font: inherit; font-size: 12px; font-weight: 700; white-space: nowrap; }
+.mc-chip-sm { padding: 6px 12px; font-size: 11px; }
+.mc-chip.is-active { background: var(--wt-grad); border-color: transparent; color: #fff; }
+.mc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 10px; }
+@media (min-width: 480px) { .mc-grid { grid-template-columns: repeat(4, 1fr); } }
+
+/* Genres */
+.mc-section-title { font-size: 18px; font-weight: 800; margin: 2px 2px 0; }
+.mc-genre-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.mc-genre { position: relative; min-height: 104px; padding: 12px; border-radius: 18px; border: 1px solid var(--wt-card-brd); background-size: cover; background-position: center; color: #fff; text-align: left; font: inherit; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
+.mc-genre-emoji { position: absolute; top: 10px; right: 12px; font-size: 26px; }
+.mc-genre-name { font-size: 16px; font-weight: 800; text-shadow: 0 1px 6px rgba(0,0,0,.6); }
+.mc-genre-count { font-size: 11px; opacity: .85; }
+
+/* Details */
+.mc-detail { position: fixed; inset: 0; z-index: 60; overflow-y: auto; background: var(--wt-bg); }
+.mc-detail[hidden] { display: none; }
+.mc-detail-hero { position: relative; height: 340px; background-size: cover; background-position: center top; }
+.mc-d-back, .mc-d-fav { position: absolute; top: max(14px, env(safe-area-inset-top)); z-index: 2; }
+.mc-d-back { left: 14px; } .mc-d-fav { right: 14px; } .mc-d-fav.on { color: #ff3b5c; } .mc-d-fav.on svg { fill: #ff3b5c; }
+.mc-detail-body { position: relative; max-width: 560px; margin: -64px auto 0; padding: 0 18px 40px; display: flex; flex-direction: column; gap: 12px; }
+.mc-detail-body h1 { margin: 0; font-size: 28px; text-shadow: 0 2px 10px rgba(0,0,0,.6); }
+.mc-detail-body h4 { margin: 6px 0 -6px; font-size: 12px; color: var(--wt-muted); text-transform: uppercase; letter-spacing: .08em; }
+.mc-detail-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 13px; color: #e9dfe2; }
+.mc-stars-show { color: #ffd54a; letter-spacing: 1px; }
+.mc-status { padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(255,255,255,.1); }
+.mc-about, .mc-scene { margin: 0; padding: 12px 14px; border-radius: 16px; background: var(--wt-card); border: 1px solid var(--wt-card-brd); line-height: 1.6; font-size: 14px; color: #e9dfe2; }
+.mc-scene { border-color: rgba(255,59,92,.3); background: rgba(255,59,92,.07); }
+.mc-detail-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.mc-danger { color: #ff8a98; }
+
+/* Form */
+.mc-form-sheet { max-height: 92vh; overflow-y: auto; }
+.mc-form { display: flex; flex-direction: column; gap: 12px; padding: 6px 2px 8px; }
+.mc-poster-pick { align-self: center; width: 130px; aspect-ratio: 2 / 3; border-radius: 16px; border: 1.5px dashed rgba(255,59,92,.55); background: rgba(255,59,92,.05); display: flex; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; }
+.mc-poster-pick span { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--wt-muted); font-size: 12px; width: 100%; height: 100%; justify-content: center; }
+.mc-poster-pick em { font-style: normal; } .mc-poster-pick svg { width: 28px; height: 28px; color: var(--wt-red1); }
+.mc-poster-pick img { width: 100%; height: 100%; object-fit: cover; }
+.mc-field { display: flex; flex-direction: column; gap: 6px; }
+.mc-field > label { font-size: 11px; font-weight: 800; color: var(--wt-muted); text-transform: uppercase; letter-spacing: .06em; }
+.mc-field input, .mc-field select, .mc-field textarea { width: 100%; box-sizing: border-box; padding: 12px 14px; border-radius: 13px; border: 1px solid var(--wt-card-brd); background: rgba(255,255,255,.06); color: #fff; font: inherit; font-size: 14px; outline: 0; }
+.mc-field textarea { min-height: 76px; resize: vertical; }
+.mc-field input:focus, .mc-field select:focus, .mc-field textarea:focus { border-color: var(--wt-red1); }
+.mc-field select option { background: #1c0a11; color: #fff; }
+.mc-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.mc-stars { display: flex; gap: 6px; }
+.mc-star { background: none; border: 0; font-size: 30px; line-height: 1; color: #6b5a60; padding: 2px; } .mc-star.on { color: #ffd54a; }
+.mc-toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); z-index: 90; max-width: 88vw; padding: 11px 18px; border-radius: 22px; background: rgba(24,8,13,.96); border: 1px solid rgba(255,59,92,.3); color: #fff; font-size: 13px; text-align: center; }
+.mc-toast[hidden] { display: none; }
+@media (min-width: 700px) { #stateSetup .wt-tabs, #stateSetup .wt-tabpane { max-width: 560px; width: 100%; margin-left: auto; margin-right: auto; } }
+
+.mc-banner-btns .wt-btn { padding: 0 8px; font-size: 13px; white-space: nowrap; gap: 6px; }
+.mc-banner-btns .wt-btn svg { width: 16px; height: 16px; }
+.mc-row-head { margin: 12px 2px 6px; }
+.mc-form-sheet .wt-sheet-header h2 { color: #fff; }
+/* Collection sheets must sit above the full-screen details page */
+#mcFormBackdrop, #mcConfirmBackdrop, #mcActionsBackdrop { z-index: 80; }
diff --git a/public/movie-collection.js b/public/movie-collection.js
new file mode 100644
index 0000000..4ba5f93
--- /dev/null
+++ b/public/movie-collection.js
@@ -0,0 +1,391 @@
+/* ═══════════════════════════════════════════════════════════════════
+   Movie Collection — lives on the Watch Together (movie) page.
+   Moved here from the Music page. Uses the SAME localStorage key
+   ('us_movies_v2') and the SAME record shape, so every movie that was
+   added on the old Music > Movies tab appears here automatically.
+
+   Record: { id, title, year, genre, rating(0-5), status
+             ('watchlist'|'watching'|'watched'), review, scene,
+             owner ('my'|'partner'|'both'), poster (data URL), fav }
+   Pure UI/local data — no backend, no change to sync/calls/R2 code.
+   ═══════════════════════════════════════════════════════════════════ */
+(function () {
+  'use strict';
+  const $ = (id) => document.getElementById(id);
+  const KEY = 'us_movies_v2';
+
+  const GENRES = {
+    Romance:     { e: '💕', c: ['#ff6b9a', '#6e1231'] },
+    Action:      { e: '💥', c: ['#ff8a3d', '#6b1d0b'] },
+    Comedy:      { e: '😂', c: ['#ffd14a', '#7a4a06'] },
+    Drama:       { e: '🎭', c: ['#b68bff', '#3a1b73'] },
+    Thriller:    { e: '😰', c: ['#7d8aa3', '#1b2233'] },
+    Horror:      { e: '👻', c: ['#9aa0a6', '#2a0a0a'] },
+    'Sci-Fi':    { e: '🚀', c: ['#43b5ff', '#0a2a5c'] },
+    Fantasy:     { e: '🧙', c: ['#5ee0b0', '#0e4a3a'] },
+    Animation:   { e: '🎨', c: ['#ff7ad9', '#5a1a6e'] },
+    Documentary: { e: '📽️', c: ['#c9b27c', '#4a3a16'] },
+    Bollywood:   { e: '🎪', c: ['#ff5d73', '#7a1030'] },
+    Other:       { e: '🎬', c: ['#d6102a', '#3a0510'] },
+  };
+  const STATUS = {
+    watchlist: { label: '🌟 Watchlist', cls: 'st-watchlist' },
+    watching:  { label: '🍿 Watching',  cls: 'st-watching' },
+    watched:   { label: '✅ Watched',   cls: 'st-watched' },
+  };
+
+  const S = {
+    movies: [], tab: 'home',
+    filter: 'all', owner: 'all', genre: null, q: '',
+    editId: null, detailId: null, pendingPoster: '', pendingRating: 0, deleteId: null,
+  };
+
+  function load() {
+    try { const d = localStorage.getItem(KEY); S.movies = d ? (JSON.parse(d) || []) : []; } catch (e) { S.movies = []; }
+    if (!Array.isArray(S.movies)) S.movies = [];
+  }
+  function save() {
+    try { localStorage.setItem(KEY, JSON.stringify(S.movies)); return true; }
+    catch (e) { toast('Storage is full — try a smaller poster'); return false; }
+  }
+  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  const g = (name) => GENRES[name] || GENRES.Other;
+  const byRecent = (a, b) => Number(b.id) - Number(a.id);
+  function icons() { try { window.lucide && window.lucide.createIcons(); } catch (e) {} }
+  let toastT;
+  function toast(msg) {
+    const t = $('mcToast'); if (!t) return;
+    t.textContent = msg; t.hidden = false;
+    clearTimeout(toastT); toastT = setTimeout(() => { t.hidden = true; }, 2400);
+  }
+  const find = (id) => S.movies.find((m) => String(m.id) === String(id));
+
+  // ── poster art (image if present, else genre-tinted placeholder) ──
+  function posterStyle(m) {
+    if (m && m.poster) return `background-image:url('${m.poster}')`;
+    const c = g(m && m.genre).c;
+    return `background-image:linear-gradient(150deg,${c[0]},${c[1]})`;
+  }
+  const posterEmoji = (m) => (m && m.poster ? '' : `<span class="mc-ph">${g(m && m.genre).e}</span>`);
+
+  // ═══════════ Tabs ═══════════
+  function go(tab, opts) {
+    S.tab = tab;
+    ['home', 'library', 'genres', 'watch'].forEach((t) => {
+      const el = $('tab' + t.charAt(0).toUpperCase() + t.slice(1)); if (el) el.hidden = t !== tab;
+    });
+    document.querySelectorAll('#wtTabs .wt-tab').forEach((b) => b.classList.toggle('is-active', b.dataset.tab === tab));
+    if (opts && opts.reset) { S.filter = 'all'; S.owner = 'all'; S.genre = null; S.q = ''; const si = $('mcSearch'); if (si) si.value = ''; }
+    render();
+    const sc = document.scrollingElement || document.documentElement; try { sc.scrollTop = 0; } catch (e) {}
+  }
+
+  function render() {
+    if (S.tab === 'home') renderHome();
+    else if (S.tab === 'library') renderLibrary();
+    else if (S.tab === 'genres') renderGenres();
+    icons();
+  }
+
+  // ═══════════ Home ═══════════
+  function featured() {
+    if (!S.movies.length) return null;
+    const favs = S.movies.filter((m) => m.fav).sort(byRecent);
+    return favs[0] || S.movies.slice().sort(byRecent)[0];
+  }
+  function card(m) {
+    return `<button type="button" class="mc-card" data-open="${esc(m.id)}">
+      <span class="mc-poster" style="${posterStyle(m)}">${posterEmoji(m)}
+        <span class="mc-fav${m.fav ? ' on' : ''}" data-fav="${esc(m.id)}" role="button" aria-label="Favorite">${m.fav ? '★' : '☆'}</span>
+      </span>
+      <span class="mc-card-title">${esc(m.title)}</span>
+      <span class="mc-card-meta">${m.year ? esc(m.year) + ' • ' : ''}${esc(m.genre || '')}</span>
+    </button>`;
+  }
+  function row(title, list, seeAll) {
+    if (!list.length) return '';
+    return `<div class="mc-row-head"><h3>${esc(title)}</h3>${seeAll ? `<button type="button" class="mc-seeall" data-seeall="${esc(seeAll)}">See all <i data-lucide="chevron-right"></i></button>` : ''}</div>
+      <div class="mc-hscroll">${list.slice(0, 12).map(card).join('')}</div>`;
+  }
+  function renderHome() {
+    const f = featured();
+    if (f) {
+      const st = STATUS[f.status] || STATUS.watchlist;
+      $('mcBanner').innerHTML = `<div class="mc-banner" style="${posterStyle(f)}">
+        <div class="mc-banner-shade"></div>${posterEmoji(f) ? `<div class="mc-banner-emoji">${g(f.genre).e}</div>` : ''}
+        <button type="button" class="mc-banner-more" id="mcBannerMore" aria-label="More options"><i data-lucide="more-vertical"></i></button>
+        <div class="mc-banner-body">
+          <div class="mc-banner-title">${esc(f.title)}</div>
+          <div class="mc-chips"><span>${esc(f.genre || 'Movie')}</span>${f.year ? `<span>${esc(f.year)}</span>` : ''}<span>${st.label}</span></div>
+          <div class="mc-banner-btns">
+            <button type="button" class="wt-btn wt-btn-primary" id="mcBannerWatch"><i data-lucide="heart"></i><span>Watch Together</span></button>
+            <button type="button" class="wt-btn wt-btn-ghost" id="mcBannerDetails"><span>View Details</span></button>
+          </div></div></div>`;
+    } else {
+      $('mcBanner').innerHTML = `<div class="mc-banner mc-banner-empty">
+        <div class="mc-banner-shade"></div><div class="mc-banner-emoji">🎬</div>
+        <div class="mc-banner-body">
+          <div class="mc-banner-title">Watch Together</div>
+          <p class="mc-banner-sub">Different places. Same movie. Same moment. ❤️</p>
+          <div class="mc-banner-btns">
+            <button type="button" class="wt-btn wt-btn-primary" id="mcBannerWatch"><i data-lucide="heart"></i><span>Watch Together</span></button>
+            <button type="button" class="wt-btn wt-btn-ghost" id="mcBannerAdd"><i data-lucide="plus"></i><span>Add a Movie</span></button>
+          </div></div></div>`;
+    }
+    const all = S.movies.slice().sort(byRecent);
+    const html =
+      row('Currently Watching', all.filter((m) => m.status === 'watching'), 'watching') +
+      row('Your Favorites', all.filter((m) => m.fav), 'fav') +
+      row('Watched Together', all.filter((m) => m.owner === 'both'), 'both') +
+      row('Watchlist', all.filter((m) => m.status === 'watchlist'), 'watchlist') +
+      row('Recently Added', all, 'all');
+    $('mcHomeRows').innerHTML = html || `<div class="mc-empty"><div>🍿</div><p>No movies in your collection yet.<br>Add favorites and ones to watch together.</p><button type="button" class="wt-btn wt-btn-primary" id="mcEmptyAdd"><i data-lucide="plus"></i><span>Add Movie</span></button></div>`;
+  }
+
+  // ═══════════ Library ═══════════
+  const FILTERS = [['all', 'All'], ['recent', 'Recent'], ['fav', '⭐ Favorites'], ['watchlist', '🌟 Watchlist'], ['watching', '🍿 Watching'], ['watched', '✅ Watched']];
+  const OWNERS = [['all', 'Everyone'], ['my', '❤️ Mine'], ['partner', "💜 Partner's"], ['both', '💕 Together']];
+  function filtered() {
+    const q = S.q.trim().toLowerCase();
+    let list = S.movies.filter((m) => {
+      if (S.owner !== 'all' && m.owner !== S.owner) return false;
+      if (S.genre && m.genre !== S.genre) return false;
+      if (S.filter === 'fav' && !m.fav) return false;
+      if (['watchlist', 'watching', 'watched'].includes(S.filter) && m.status !== S.filter) return false;
+      if (q && !(m.title || '').toLowerCase().includes(q) && !(m.genre || '').toLowerCase().includes(q)) return false;
+      return true;
+    }).sort(byRecent);
+    if (S.filter === 'recent') list = list.slice(0, 12);
+    return list;
+  }
+  function renderLibrary() {
+    const mv = S.movies;
+    const avg = mv.length ? (mv.reduce((s, m) => s + (m.rating || 0), 0) / mv.length).toFixed(1) : '—';
+    $('mcStats').innerHTML = [
+      [mv.length, 'Total'], [mv.filter((m) => m.status === 'watched').length, 'Watched'],
