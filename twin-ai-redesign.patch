+/* ═══════════════════════════════════════════════════════════════════
+   public/twin-page.css — Twin AI page redesign (YOU + BOTH modes)
+   ───────────────────────────────────────────────────────────────────
+   Load order: this file must come AFTER index.html's inline <style>,
+   both-mode.css, composer.css, app-polish.css and glass-nav.css — it
+   deliberately overrides them, scoped to #page-ai so no other page is
+   affected.
+
+   Tuning knobs live on #page-ai (--tw-*). Change the reds there and the
+   whole page follows.
+═══════════════════════════════════════════════════════════════════ */
+
+#page-ai {
+  --tw-red: #ff2d41;
+  --tw-red-2: #d1001c;
+  --tw-red-d: #8f0013;
+  --tw-pink: #ff8ea1;
+  --tw-glow: rgba(255, 45, 65, .45);
+  --tw-line: rgba(255, 82, 98, .16);
+  --tw-line-2: rgba(255, 255, 255, .08);
+  --tw-card: rgba(255, 255, 255, .035);
+  --tw-card-2: rgba(255, 255, 255, .06);
+  --tw-text: rgba(255, 255, 255, .94);
+  --tw-muted: rgba(255, 255, 255, .58);
+  --tw-faint: rgba(255, 255, 255, .36);
+  --tw-grad: linear-gradient(135deg, #ff3b50 0%, #d1001c 100%);
+  --tw-grad-text: linear-gradient(90deg, #ff8fa3 0%, #ff3b52 100%);
+  font-family: var(--ff-sans, 'Inter', system-ui, sans-serif);
+}
+
+/* ── Layout: the topbar is replaced by Twin's own header ───────────── */
+body:has(#page-ai.active) .topbar { display: none !important; }
+
+.content:has(#page-ai.active) {
+  display: flex !important;
+  flex-direction: column;
+  min-height: 0;
+  overflow: hidden !important;
+  padding: 0 !important;
+}
+
+#page-ai.active {
+  display: flex !important;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-height: 0;
+  height: auto !important;
+  position: relative;
+  background:
+    radial-gradient(120% 55% at 0% 0%, rgba(122, 0, 18, .50), transparent 62%),
+    radial-gradient(90% 45% at 100% 100%, rgba(122, 0, 18, .38), transparent 62%),
+    linear-gradient(180deg, #0a0406 0%, #060203 100%);
+}
+
+/* old ambient layer replaced by the gradients above */
+#page-ai::before { display: none !important; }
+
+.tw-shell {
+  position: relative;
+  z-index: 1;
+  width: 100%;
+  max-width: 760px;
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-height: 0;
+}
+
+/* ── Header ─────────────────────────────────────────────────────────── */
+.tw-head {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  padding: max(12px, env(safe-area-inset-top)) 14px 8px;
+  flex: none;
+}
+.tw-logo {
+  width: 42px; height: 42px; flex: none;
+  border-radius: 14px;
+  background: #0d0305;
+  border: 1px solid var(--tw-line);
+  box-shadow: 0 0 18px rgba(255, 45, 65, .22);
+  display: grid; place-items: center; overflow: hidden;
+}
+.tw-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }
+
+.tw-icon-btn, .tw-round-btn, .tw-sync-btn {
+  border: 1px solid var(--tw-line-2);
+  background: linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .03));
+  color: var(--tw-text);
+  cursor: pointer;
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  transition: transform .15s ease, background .2s ease, border-color .2s ease;
+  -webkit-tap-highlight-color: transparent;
+  font-family: inherit;
+}
+.tw-icon-btn:active, .tw-round-btn:active, .tw-sync-btn:active { transform: scale(.94); }
+.tw-icon-btn:hover, .tw-round-btn:hover, .tw-sync-btn:hover { border-color: var(--tw-line); background: var(--tw-card-2); }
+.tw-icon-btn { width: 42px; height: 42px; border-radius: 14px; flex: none; }
+.tw-round-btn { width: 40px; height: 40px; border-radius: 50%; flex: none; }
+.tw-sync-btn { height: 40px; padding: 0 13px; border-radius: 14px; font-size: 14px; font-weight: 500; flex: none; }
+.tw-sync-btn.is-spinning svg { animation: twSpin .9s linear infinite; }
+@keyframes twSpin { to { transform: rotate(360deg); } }
+
+.tw-titles { flex: 1 1 auto; min-width: 0; margin-left: 2px; }
+.tw-title { font-size: 20px; font-weight: 600; color: var(--tw-text); line-height: 1.15; letter-spacing: -.01em; }
+.tw-sub { font-size: 13px; color: var(--tw-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+
+@media (max-width: 380px) {
+  .tw-sync-label { display: none; }
+  .tw-sync-btn { padding: 0 13px; }
+  .tw-head { gap: 7px; padding-left: 10px; padding-right: 10px; }
+}
+
+/* ── YOU / BOTH segmented control ───────────────────────────────────── */
+#page-ai .twin-mode-selector {
+  flex: none;
+  display: flex;
+  gap: 4px;
+  width: fit-content;
+  margin: 6px 14px 12px;
+  padding: 5px;
+  border-radius: 18px;
+  background: rgba(255, 255, 255, .035);
+  border: 1px solid var(--tw-line-2);
+}
+#page-ai .twin-mode-btn {
+  min-width: 112px;
+  padding: 12px 22px;
+  border-radius: 14px;
+  border: 0;
+  background: transparent;
+  color: var(--tw-faint);
+  font-family: inherit;
+  font-size: 15px; font-weight: 700; letter-spacing: .08em;
+  transition: background .25s ease, color .25s ease, box-shadow .25s ease, transform .15s ease;
+}
+#page-ai .twin-mode-btn:active { transform: scale(.96); }
+#page-ai .twin-mode-btn.active {
+  background: var(--tw-grad);
+  color: #fff;
+  box-shadow: 0 6px 20px var(--tw-glow), inset 0 1px 0 rgba(255, 255, 255, .25);
+}
+
+/* ── Shared card look ───────────────────────────────────────────────── */
+.tw-card {
+  position: relative;
+  border-radius: 26px;
+  border: 1px solid var(--tw-line);
+  background:
+    radial-gradient(70% 90% at 85% 100%, rgba(255, 45, 65, .20), transparent 70%),
+    linear-gradient(180deg, rgba(255, 255, 255, .045), rgba(255, 255, 255, .015));
+  box-shadow: 0 18px 40px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .05);
+  overflow: hidden;
+}
+.tw-grad {
+  background: var(--tw-grad-text);
+  -webkit-background-clip: text; background-clip: text;
+  -webkit-text-fill-color: transparent; color: transparent;
+}
+
+/* ═══════════════════════ YOU MODE ═══════════════════════════════════ */
+#page-ai .ai-wrap {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 0;
+  min-height: 0;
+  height: auto !important;
+}
+
+#page-ai .ai-msgs {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 4px 14px 46px;
+  gap: 14px;
+  scroll-behavior: smooth;
+  overscroll-behavior: contain;
+}
+
+/* Hero card (kept at the top of the conversation, like the reference) */
+#page-ai .ai-welcome {
+  flex: none;
+  display: block;
+  padding: 0;
+  text-align: left;
+}
+.tw-hero { padding: 24px 20px 22px; min-height: 214px; }
+.tw-hero-text { position: relative; z-index: 2; max-width: 58%; }
+.tw-hero-hi { font-size: 18px; color: var(--tw-pink); margin: 0 0 4px; font-weight: 400; }
+.tw-hero-title {
+  margin: 0 0 12px;
+  font-size: clamp(30px, 9vw, 42px);
+  line-height: 1.04; font-weight: 700; letter-spacing: -.025em; color: #fff;
+}
+.tw-hero-copy { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--tw-muted); }
+
+.tw-hero-art {
+  position: absolute; z-index: 1;
+  right: 4px; bottom: 6px;
+  width: 46%; max-width: 210px;
+  pointer-events: none;
+}
+.tw-hero-art svg { display: block; width: 100%; height: auto; overflow: visible; animation: twFloat 4.2s ease-in-out infinite; filter: drop-shadow(0 10px 22px rgba(255, 30, 55, .45)); }
+.tw-hero-ring {
+  position: absolute; inset: -12% -6% -2% -6%;
+  border-radius: 50%;
+  border: 1.5px solid transparent;
+  background: conic-gradient(from 210deg, transparent 0 20%, rgba(255, 70, 90, .85) 38%, transparent 60%) border-box;
+  -webkit-mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor; mask-composite: exclude;
+  opacity: .9;
+}
+.tw-hero-bubble {
+  position: absolute; z-index: 3;
+  left: -6%; top: -4%;
+  display: inline-flex; gap: 5px; align-items: center;
+  padding: 9px 12px; border-radius: 16px 16px 16px 4px;
+  background: linear-gradient(135deg, #ff3b50, #c4001b);
+  box-shadow: 0 6px 16px rgba(255, 30, 55, .45);
+}
+.tw-hero-bubble i { width: 6px; height: 6px; border-radius: 50%; background: #fff; opacity: .5; animation: twDots 1.3s ease-in-out infinite; }
+.tw-hero-bubble i:nth-child(2) { animation-delay: .18s; }
+.tw-hero-bubble i:nth-child(3) { animation-delay: .36s; }
+@keyframes twDots { 0%, 60%, 100% { opacity: .4; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
+@keyframes twFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
+.tw-floaty { animation: twFloaty 3.4s ease-in-out infinite; transform-box: fill-box; }
+@keyframes twFloaty { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
+
+/* compact the hero once the chat has started */
+#page-ai .ai-welcome.is-chatting .twin-sugg-row { display: none; }
+#page-ai .ai-welcome.is-chatting .tw-hero { min-height: 0; padding: 16px 18px; }
+#page-ai .ai-welcome.is-chatting .tw-hero-title { font-size: 26px; margin-bottom: 4px; }
+#page-ai .ai-welcome.is-chatting .tw-hero-copy { display: none; }
