 ═══════════════════════════════════════════════════════════ */
-.voice-waveform.playing span { background: rgba(255,255,255,.65) !important; }
\ No newline at end of file
+.voice-waveform.playing span { background: rgba(255,255,255,.65) !important; }
+
+/* ── Border / focus-ring fix (global) ─────────────────────────────────
+   Wrappers like .love-card-actions / .card-title matched [class*="-card"]
+   and showed a box/ring when tapped. Neutralise them, and remove browser
+   focus rings on mouse/touch interaction.                              */
+[class*="-card-actions"], [class*="-card-title"], [class*="-card-sub"], [class*="-card-ico"],
+[class*="-card-body"], [class*="-card-grid"], [class*="-card-row"] {
+  transform: none !important; box-shadow: none !important; outline: none !important;
+}
+* { -webkit-tap-highlight-color: transparent; }
+:focus { outline: none; }
+:focus:not(:focus-visible) { outline: none !important; box-shadow: none !important; }
+button:active, a:active, [role="button"]:active { outline: none !important; }
+/* subtle ring ONLY for real keyboard navigation */
+button:focus-visible, a:focus-visible, [role="button"]:focus-visible, [tabindex]:focus-visible {
+  outline: 2px solid rgba(255,255,255,.35) !important; outline-offset: 2px;
+}
+/* Click ripple/bloom drew a visible ring/border on tap — hide it. */
+.pm-ripple-ring, .pm-bloom { display: none !important; }
+.pm-glass-surface::before { display: none !important; }
