From 98125bdb3c5a5fd2c33705103d51b14e0e94823a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 11:13:01 +0000
Subject: [PATCH 1/2] Dark theme: neutral gray home hero (logo, quote, search,
 shortcuts)

---
 public/theme-dark-glass.css | 46 +++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/public/theme-dark-glass.css b/public/theme-dark-glass.css
index 01d05d2..dadbcc7 100644
--- a/public/theme-dark-glass.css
+++ b/public/theme-dark-glass.css
@@ -222,3 +222,49 @@ html[data-theme="dark"] .topbar { background: rgba(18,14,16,.6) !important; bord
   html[data-theme="dark"] #botNav .gn-glass { background: rgba(48,43,46,.92) !important; }
   html[data-theme="dark"] :is(.card,.set-list,.modal) { background: #2a2527 !important; }
 }
+
+/* ════════════════════════════════════════════════════════════════════
+   HOME HERO (dashboard header: logo, greeting, quote, search, shortcuts)
+   dashboard.css paints this area with a hard-coded magenta gradient,
+   so it needs its own neutral override. Dark theme only.
+   ════════════════════════════════════════════════════════════════════ */
+html[data-theme="dark"] .dh-bg {
+  background:
+    radial-gradient(90% 55% at 85% 0%, rgba(255,255,255,.07), transparent 62%),
+    linear-gradient(175deg, #2a0b1c 0%, #190912 55%, #130d10 100%);
+}
+
+/* logo: same app icon, desaturated so it matches the gray theme */
+html[data-theme="dark"] .dh-brand img {
+  filter: grayscale(1) brightness(1.25) contrast(1.05);
+  border: 1px solid rgba(255,255,255,.18);
+  box-shadow: 0 6px 18px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.2);
+}
+html[data-theme="dark"] .dh-brand span { color: #fff; }
+
+/* profile photo ring */
+html[data-theme="dark"] .dh-profile { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.4); }
+
+/* quote: white, last word italic white (was pink) */
+html[data-theme="dark"] .dh-quote, html[data-theme="dark"] .dh-greet { color: #fff; }
+html[data-theme="dark"] .dh-quote em { color: #fff; }
+
+/* search + menu: gray glass */
+html[data-theme="dark"] :is(.dh-search,.dh-menu) {
+  background: var(--gl-fill) !important; background-color: rgba(255,255,255,.04) !important;
+  border: 1px solid rgba(255,255,255,.18) !important;
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.16), inset 0 -1px 0 rgba(0,0,0,.2) !important;
+  color: rgba(255,255,255,.78) !important;
+}
+
+/* shortcut tiles (Memories / Music / Movie / …): gray glass */
+html[data-theme="dark"] .dh-chip {
+  background: var(--gl-fill); background-color: rgba(255,255,255,.04);
+  border: 1px solid rgba(255,255,255,.16); color: #fff;
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.14), inset 0 -1px 0 rgba(0,0,0,.2);
+}
+/* highlighted tile / button keep their white state, text no longer pink-tinted */
+html[data-theme="dark"] .dh-chip.is-primary { background: rgba(255,255,255,.94); border-color: #fff; color: #161214; }
+html[data-theme="dark"] .dh-act { background: var(--gl-fill-strong); border-color: rgba(255,255,255,.22); }
+html[data-theme="dark"] .dh-act.is-active { background: rgba(255,255,255,.94); border-color: #fff; color: #161214; }
+html[data-theme="dark"] .dh-card { border-color: rgba(255,255,255,.16); }
-- 
2.43.0


