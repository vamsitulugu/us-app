From ad5bf2c7aa086374e3b27526a2df1990c85a670d Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sun, 9 Aug 2026 09:24:45 +0000
Subject: [PATCH] PTR: black indicator with red spinner, faster spinner cap
 (1.2s)

---
 public/js/pull-to-refresh.js | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/public/js/pull-to-refresh.js b/public/js/pull-to-refresh.js
index 7ebd972..1fb3f0f 100644
--- a/public/js/pull-to-refresh.js
+++ b/public/js/pull-to-refresh.js
@@ -54,7 +54,7 @@
     var puck = document.createElement('div');
     puck.style.cssText = [
       'width:34px', 'height:34px', 'border-radius:50%',
-      'background:var(--card,#fff)', 'box-shadow:0 2px 10px rgba(0,0,0,.18)',
+      'background:#000', 'box-shadow:0 2px 10px rgba(0,0,0,.35)',
       'display:flex', 'align-items:center', 'justify-content:center',
       'transform:translateY(-40px) scale(.7)', 'opacity:0',
       'transition:opacity .18s ease'
@@ -63,7 +63,7 @@
     puck.innerHTML =
       '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" ' +
       'style="transform:rotate(0deg)">' +
-      '<circle cx="12" cy="12" r="9" stroke="var(--border,#e2e2e6)" stroke-width="2.5"/>' +
+      '<circle cx="12" cy="12" r="9" stroke="rgba(237,42,58,.35)" stroke-width="2.5"/>' +
       '<path d="M12 3a9 9 0 0 1 9 9" stroke="var(--brand,#ED2A3A)" stroke-width="2.5" stroke-linecap="round"/>' +
       '</svg>';
 
@@ -78,7 +78,7 @@
     this.canActivate = typeof opts.canActivate === 'function' ? opts.canActivate : function () { return true; };
     this.threshold = opts.threshold || 70;
     this.maxPull = opts.maxPull || 120;
-    this.maxWait = opts.maxWait || 2500; // don't let the spinner hang on a slow/stalled refresh
+    this.maxWait = opts.maxWait || 1200; // don't let the spinner hang on a slow/stalled refresh
 
     this._active = false;      // a touch is down and we've committed to a pull
     this._deciding = false;    // a touch is down, still inside the deadzone
-- 
2.43.0

