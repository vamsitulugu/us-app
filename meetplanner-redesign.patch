+.mp-btn-red{background:var(--mp-grad);box-shadow:0 8px 24px var(--mp-red-glow)}
+.mp-btn-ghost{background:var(--mp-card2);border:1px solid var(--mp-line2)}
+.mp-btn-danger{background:rgba(248,113,113,.14);color:#f87171;border:1px solid rgba(248,113,113,.3)}
+.mp-btn-full{width:100%}
+.mp-btn-sm{padding:8px 14px;font-size:12px;border-radius:11px}
+
+/* ══════════ 1 · HOME ══════════ */
+.mp-hero{position:relative;margin-top:6px;border-radius:26px;padding:26px 18px 22px;text-align:center;overflow:hidden;
+  background:radial-gradient(90% 120% at 50% 0%,rgba(255,45,85,.34),transparent 62%),linear-gradient(180deg,#1d0c14,#10080c);
+  border:1px solid rgba(255,45,85,.25)}
+.mp-hero::before{content:"";position:absolute;inset:0;background:
+  radial-gradient(2px 2px at 12% 30%,rgba(255,255,255,.5),transparent),radial-gradient(2px 2px at 82% 22%,rgba(255,255,255,.4),transparent),
+  radial-gradient(1.5px 1.5px at 66% 70%,rgba(255,255,255,.35),transparent),radial-gradient(1.5px 1.5px at 28% 76%,rgba(255,255,255,.3),transparent);opacity:.7}
+.mp-couple{position:relative;display:flex;align-items:center;justify-content:center;gap:0}
+.mp-av{width:84px;height:84px;border-radius:50%;border:3px solid rgba(255,255,255,.9);background:var(--mp-grad);color:#fff;font-size:30px;font-weight:800;
+  display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 8px 26px rgba(0,0,0,.45),0 0 0 6px rgba(255,45,85,.18)}
+.mp-av img{width:100%;height:100%;object-fit:cover}
+.mp-av.b{background:linear-gradient(135deg,#7c3aed,#db2777)}
+.mp-link{width:70px;display:flex;align-items:center;justify-content:center;position:relative;color:var(--mp-red);font-size:24px}
+.mp-link::before,.mp-link::after{content:"";position:absolute;top:50%;height:2px;width:22px;background:linear-gradient(90deg,transparent,var(--mp-red))}
+.mp-link::before{left:0}.mp-link::after{right:0;transform:scaleX(-1)}
+.mp-link svg{fill:currentColor;stroke:none;animation:mpBeat 1.6s ease-in-out infinite;filter:drop-shadow(0 0 8px var(--mp-red))}
+@keyframes mpBeat{0%,100%{transform:scale(1)}15%{transform:scale(1.25)}30%{transform:scale(1)}45%{transform:scale(1.18)}}
+.mp-hero-names{position:relative;margin-top:14px;font-size:20px;font-weight:800}
+.mp-hero-tag{position:relative;font-size:13px;color:var(--mp-text2);margin-top:3px}
+
+.mp-quick{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
+.mp-q{background:var(--mp-card);border:1px solid var(--mp-line);border-radius:18px;padding:15px 8px 13px;text-align:center;cursor:pointer;transition:var(--mp-t)}
+.mp-q:active{transform:scale(.95)}
+.mp-q .qi{width:40px;height:40px;border-radius:13px;margin:0 auto 8px;display:flex;align-items:center;justify-content:center;font-size:20px;background:var(--mp-card2)}
+.mp-q b{display:block;font-size:13px}
+.mp-q small{display:block;font-size:10px;color:var(--mp-text3);margin-top:2px}
+.mp-q.main{background:var(--mp-red-soft);border-color:rgba(255,45,85,.55)}
+.mp-q.main .qi{background:var(--mp-grad);box-shadow:0 6px 18px var(--mp-red-glow)}
+
+.mp-mini-stats{display:flex;gap:8px;margin-top:12px}
+.mp-mini{flex:1;background:var(--mp-card);border:1px solid var(--mp-line);border-radius:14px;padding:10px 6px;text-align:center}
+.mp-mini b{display:block;font-family:var(--mp-ff-serif);font-size:20px;font-weight:400}
+.mp-mini span{font-size:9.5px;color:var(--mp-text3);text-transform:uppercase;letter-spacing:.5px;font-weight:700}
+
+/* upcoming ticket card */
+.mp-up{display:flex;gap:0;border-radius:22px;overflow:hidden;cursor:pointer;border:1px solid rgba(255,45,85,.35);
+  background:linear-gradient(135deg,rgba(255,45,85,.22),rgba(255,255,255,.04));transition:var(--mp-t)}
+.mp-up:active{transform:scale(.985)}
+.mp-up-date{width:86px;flex-shrink:0;background:var(--mp-grad);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 6px;text-align:center}
+.mp-up-date b{font-size:32px;font-weight:800;line-height:1}
+.mp-up-date span{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;opacity:.9;margin-top:3px}
+.mp-up-body{flex:1;min-width:0;padding:14px 14px 13px;position:relative}
+.mp-up-body h3{font-size:16px;font-weight:700;padding-right:70px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.mp-up-sub{font-size:12px;color:var(--mp-text2);margin-top:3px}
+.mp-up-meta{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--mp-text2);margin-top:11px}
+.mp-up-meta span{display:flex;align-items:center;gap:5px}
+.mp-when{position:absolute;top:12px;right:12px;font-size:10.5px;font-weight:800;background:var(--mp-grad);padding:4px 10px;border-radius:99px;text-transform:uppercase;letter-spacing:.3px}
+
+.mp-empty-card{border:1.5px dashed var(--mp-line2);border-radius:22px;padding:24px 18px;text-align:center;color:var(--mp-text2);font-size:13px;cursor:pointer}
+.mp-empty-card .big{font-size:34px;margin-bottom:6px}
+.mp-draft{display:flex;align-items:center;gap:12px;background:var(--mp-amber-bg);border:1px solid rgba(251,191,36,.35);border-radius:18px;padding:13px 14px;margin-top:12px;cursor:pointer}
+.mp-draft .di{width:38px;height:38px;border-radius:12px;background:rgba(251,191,36,.2);color:var(--mp-amber);display:flex;align-items:center;justify-content:center;font-size:18px}
+.mp-draft b{font-size:13px;display:block}.mp-draft small{font-size:11px;color:var(--mp-text2)}
+.mp-draft .go{margin-left:auto;color:var(--mp-amber)}
+
+/* horizontal rails */
+.mp-rail{display:flex;gap:11px;overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x proximity;scroll-padding-left:var(--mp-gut);margin:0 calc(var(--mp-gut) * -1);padding-left:var(--mp-gut);padding-right:var(--mp-gut)}
+.mp-rail::-webkit-scrollbar{height:0}
+.mp-dest{flex:0 0 128px;height:140px;border-radius:20px;position:relative;overflow:hidden;cursor:pointer;scroll-snap-align:start;transition:var(--mp-t);border:1px solid var(--mp-line)}
+.mp-dest:active{transform:scale(.95)}
+.mp-art{position:absolute;right:-6px;top:6px;font-size:62px;opacity:.9;filter:drop-shadow(0 6px 12px rgba(0,0,0,.35))}
+.mp-dest::after,.mp-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(0,0,0,.72))}
+.mp-dest-n{position:absolute;left:11px;bottom:10px;right:6px;z-index:2;font-size:13px;font-weight:700;overflow-wrap:normal;word-break:keep-all}
+
+/* ══════════ 2 · PLAN NEW ══════════ */
+.mp-form{display:flex;flex-direction:column;gap:18px;margin-top:6px}
+.mp-lbl{font-size:12px;font-weight:700;color:var(--mp-text2);margin-bottom:7px;display:block}
+.mp-lbl i{font-style:normal;font-weight:500;color:var(--mp-text3)}
+.mp-input{width:100%;background:var(--mp-card);border:1px solid var(--mp-line);border-radius:14px;padding:13px 14px;font-size:14px;color:#fff;
+  font-family:var(--mp-ff);outline:none;transition:var(--mp-t)}
+.mp-input::placeholder{color:var(--mp-text3)}
+.mp-input:focus{border-color:var(--mp-red);box-shadow:0 0 0 3px var(--mp-red-soft)}
+textarea.mp-input{resize:vertical;min-height:84px;line-height:1.6}
+.mp-with-ico{position:relative}
+.mp-with-ico>svg.i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mp-text3);font-size:17px;pointer-events:none}
+.mp-with-ico .mp-input{padding-left:42px}
+.mp-row{display:flex;gap:10px}.mp-row>*{flex:1;min-width:0}
+.mp-geo{width:48px;flex:0 0 48px!important;border-radius:14px;border:1px solid var(--mp-red);background:var(--mp-red-soft);color:var(--mp-red);display:flex;align-items:center;justify-content:center;font-size:19px;cursor:pointer}
+.mp-field{position:relative}
+.mp-results{position:absolute;top:100%;left:0;right:0;background:#1a0d12;border:1px solid var(--mp-line2);border-radius:14px;margin-top:6px;max-height:250px;overflow-y:auto;z-index:50;display:none;box-shadow:0 14px 34px rgba(0,0,0,.55)}
+.mp-results.show{display:block}
+.mp-res{padding:11px 14px;cursor:pointer;border-bottom:1px solid var(--mp-line);font-size:13px}
+.mp-res:last-child{border-bottom:none}.mp-res:hover{background:var(--mp-card2)}
+.mp-res b{display:block;font-weight:600}.mp-res small{display:block;color:var(--mp-text3);font-size:10.5px;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.mp-citychip{display:none;align-items:center;gap:10px;background:var(--mp-red-soft);border:1px solid rgba(255,45,85,.4);border-radius:14px;padding:11px 14px;margin-top:9px}
+.mp-citychip.show{display:flex}
+.mp-citychip b{flex:1;font-size:14px}.mp-citychip a{font-size:12px;font-weight:700;color:var(--mp-red);cursor:pointer}
+.mp-citychip svg.i{color:var(--mp-red);font-size:18px}
+.mp-seg{display:flex;gap:6px;background:var(--mp-card);border:1px solid var(--mp-line);border-radius:15px;padding:5px}
+.mp-seg div{flex:1;text-align:center;padding:10px 4px;border-radius:11px;font-size:13px;font-weight:700;color:var(--mp-text2);cursor:pointer;transition:var(--mp-t)}
+.mp-seg div.on{background:var(--mp-red-soft);color:#fff;box-shadow:inset 0 0 0 1.5px var(--mp-red)}
+.mp-modes{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
+.mp-mode{padding:12px 4px 9px;border-radius:15px;background:var(--mp-card);border:1px solid var(--mp-line);text-align:center;cursor:pointer;transition:var(--mp-t)}
+.mp-mode .me{font-size:22px;display:block;margin-bottom:4px}
+.mp-mode small{font-size:10.5px;font-weight:700;color:var(--mp-text2)}
+.mp-mode.on{background:var(--mp-red-soft);border-color:var(--mp-red);box-shadow:0 0 18px var(--mp-red-soft)}
+.mp-mode.on small{color:#fff}
+.mp-rupee{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-weight:700;color:var(--mp-text2);font-size:15px}
+.mp-with-ico.rp .mp-input{padding-left:32px}
+
+/* ══════════ 3 · FIND PLACES ══════════ */
+.mp-chips{display:flex;gap:8px;overflow-x:auto;padding:3px 0 6px;margin:10px calc(var(--mp-gut) * -1) 0;padding-left:var(--mp-gut);padding-right:var(--mp-gut)}
+.mp-chips::-webkit-scrollbar{height:0}
+.mp-chip{flex-shrink:0;padding:9px 15px;border-radius:99px;font-size:12px;font-weight:700;cursor:pointer;background:var(--mp-card);border:1px solid var(--mp-line);color:var(--mp-text2);white-space:nowrap;transition:var(--mp-t)}
+.mp-chip.on{background:var(--mp-grad);border-color:transparent;color:#fff;box-shadow:0 6px 16px var(--mp-red-glow)}
+@media(min-width:900px){.mp-chips{flex-wrap:wrap;overflow:visible}}
+.mp-tile{flex:0 0 138px;height:168px;border-radius:20px;position:relative;overflow:hidden;cursor:pointer;scroll-snap-align:start;border:1px solid var(--mp-line);transition:var(--mp-t)}
+.mp-tile:active{transform:scale(.96)}
+.mp-tile .mp-art{font-size:70px;right:-4px;top:12px}
+.mp-tile-t{position:absolute;left:11px;right:9px;bottom:10px;z-index:2}
+.mp-tile-t b{display:block;font-size:13px;font-weight:700;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
+.mp-tile-t small{font-size:11px;color:rgba(255,255,255,.75)}
+.mp-tile-add{position:absolute;top:9px;left:9px;z-index:3;width:30px;height:30px;border-radius:50%;background:rgba(0,0,0,.45);border:1.5px solid rgba(255,255,255,.7);color:#fff;display:flex;align-items:center;justify-content:center;font-size:15px;backdrop-filter:blur(6px)}
+.mp-tile.sel .mp-tile-add{background:var(--mp-grad);border-color:#fff}
+.mp-tile.sel{border-color:var(--mp-red);box-shadow:0 0 0 2px var(--mp-red)}
+.mp-poi{display:flex;align-items:center;gap:12px;padding:10px;border-radius:18px;background:var(--mp-card);border:1px solid var(--mp-line);margin-bottom:9px;cursor:pointer;transition:var(--mp-t)}
+.mp-poi.sel{border-color:rgba(255,45,85,.6);background:var(--mp-red-soft)}
+.mp-thumb{width:56px;height:56px;border-radius:15px;display:flex;align-items:center;justify-content:center;font-size:27px;flex-shrink:0;position:relative;overflow:hidden}
+.mp-poi-b{flex:1;min-width:0}
+.mp-poi-b b{display:block;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.mp-poi-b small{display:block;font-size:11.5px;color:var(--mp-text3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.mp-plus{width:36px;height:36px;border-radius:12px;flex-shrink:0;background:var(--mp-grad);color:#fff;display:flex;align-items:center;justify-content:center;font-size:19px;cursor:pointer;box-shadow:0 5px 14px var(--mp-red-glow);transition:var(--mp-t)}
+.mp-poi.sel .mp-plus{background:var(--mp-card2);box-shadow:none;border:1px solid var(--mp-line2)}
+@media(min-width:760px){#mpPoiRows{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}}
+.mp-note{text-align:center;padding:26px 14px;color:var(--mp-text3);font-size:13px;line-height:1.7}
+.mp-spin{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.25);border-top-color:#fff;animation:mpSpin .7s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px}
+@keyframes mpSpin{to{transform:rotate(360deg)}}
+
+/* sticky bottom bar (sits above the app's bottom nav) */
+.mp-dock{position:sticky;bottom:calc(var(--mp-nav) + env(safe-area-inset-bottom,0px));z-index:40;margin-top:14px;display:none}
+.mp-dock.show{display:flex}
+.mp-dock-in{flex:1;display:flex;align-items:center;gap:12px;padding:10px 10px 10px 16px;border-radius:20px;background:rgba(20,10,14,.92);
+  backdrop-filter:blur(18px);border:1px solid rgba(255,45,85,.4);box-shadow:0 14px 36px rgba(0,0,0,.55)}
+.mp-dock-in div{flex:1;min-width:0;font-size:13px;font-weight:700}.mp-dock-in small{display:block;font-size:11px;color:var(--mp-text3);font-weight:500}
+
+/* ══════════ 4 · STOPS ══════════ */
+.mp-stop{display:flex;align-items:center;gap:11px;padding:10px 10px 10px 12px;border-radius:17px;background:var(--mp-card);border:1px solid var(--mp-line);margin-bottom:8px}
+.mp-num{width:30px;height:30px;border-radius:50%;background:var(--mp-grad);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0;box-shadow:0 4px 12px var(--mp-red-glow)}
+.mp-stop-b{flex:1;min-width:0;cursor:pointer}
+.mp-stop-b b{display:flex;align-items:center;gap:6px;font-size:13.5px;font-weight:600;min-width:0}.mp-stop-b b>span:first-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
+.mp-stop-b small{font-size:11px;color:var(--mp-text3)}
+.mp-anchor{font-size:9px;font-weight:800;background:var(--mp-amber-bg);color:var(--mp-amber);border-radius:8px;padding:2px 7px;text-transform:uppercase;white-space:nowrap;flex-shrink:0}
+.mp-acts{display:flex;gap:5px}
+.mp-act{width:30px;height:30px;border-radius:10px;background:var(--mp-card2);border:1px solid var(--mp-line);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer}
+.mp-act.del:active{background:rgba(248,113,113,.2);color:#f87171}
+.mp-map{height:clamp(240px,40vh,420px);border-radius:22px;overflow:hidden;border:1px solid var(--mp-line);margin:16px 0 12px;background:#1a1114}
+.mp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}
+.mp-st{background:var(--mp-card);border:1px solid var(--mp-line);border-radius:16px;padding:13px 6px;text-align:center}
+.mp-st b{display:block;font-size:18px;font-weight:800}
+.mp-st small{font-size:10px;color:var(--mp-text3);font-weight:600}
+
+/* ══════════ 5 · ITINERARY ══════════ */
+.mp-time-row{display:flex;align-items:center;gap:10px;margin:14px 0 4px}
+.mp-time-row label{font-size:12px;font-weight:700;color:var(--mp-text2)}
+.mp-time-row input{background:var(--mp-card);border:1px solid var(--mp-line);color:#fff;border-radius:11px;padding:7px 10px;font-size:13px;font-family:var(--mp-ff);outline:none;color-scheme:dark}
+.mp-tl{margin-top:12px}
+.mp-tl-row{display:flex;gap:11px}
+.mp-tl-time{width:64px;flex-shrink:0;white-space:nowrap;font-size:11.5px;font-weight:700;color:var(--mp-text2);padding-top:14px;text-align:right}
+.mp-tl-rail{width:16px;flex-shrink:0;display:flex;flex-direction:column;align-items:center}
+.mp-tl-dot{width:13px;height:13px;border-radius:50%;background:var(--mp-red);box-shadow:0 0 0 4px var(--mp-red-soft),0 0 14px var(--mp-red);margin-top:17px;flex-shrink:0}
+.mp-tl-line{flex:1;width:2px;background:repeating-linear-gradient(180deg,rgba(255,45,85,.55) 0 5px,transparent 5px 9px);margin-top:4px}
+.mp-tl-row:last-child .mp-tl-line{display:none}
+.mp-tl-card{flex:1;min-width:0;display:flex;gap:12px;align-items:center;padding:10px;border-radius:18px;background:var(--mp-card);border:1px solid var(--mp-line);margin-bottom:8px;cursor:pointer}
+.mp-tl-leg{font-size:10.5px;color:var(--mp-text3);margin:-2px 0 6px 0;display:flex;align-items:center;gap:6px}
+.mp-cl-add{display:flex;gap:8px;margin-bottom:8px}
+.mp-cl-add .mp-input{padding:11px 13px;font-size:13px}.mp-cl-add .mp-btn{white-space:nowrap;flex-shrink:0}
+.mp-cl{display:flex;align-items:center;gap:11px;padding:11px 2px;border-bottom:1px solid var(--mp-line);font-size:13.5px}
+.mp-cl:last-child{border-bottom:none}
+.mp-cb{width:23px;height:23px;border-radius:50%;border:2px solid var(--mp-line2);display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;font-size:12px;color:#fff;transition:var(--mp-t)}
+.mp-cb.done{background:var(--mp-grad);border-color:transparent}
+.mp-cl span{flex:1}.mp-cl span.done{text-decoration:line-through;color:var(--mp-text3)}
+.mp-cl em{font-style:normal;color:var(--mp-text3);cursor:pointer;padding:3px 7px;font-size:13px}
+.mp-panel{background:var(--mp-card);border:1px solid var(--mp-line);border-radius:20px;padding:16px;margin-top:14px}
+.mp-panel>h4{font-size:14px;font-weight:700;margin-bottom:10px}
+
+/* ══════════ 6 · ROUTE (full map) ══════════ */
+#v-route.active{display:flex;flex-direction:column;height:100%}
+#v-route .mp-bar{padding:12px var(--mp-gut) 8px}
+.mp-routebox{position:relative;flex:1;min-height:300px;margin:0 var(--mp-gut) calc(var(--mp-nav) + env(safe-area-inset-bottom,0px) + 8px);border-radius:24px;overflow:hidden;border:1px solid var(--mp-line)}
+#mpRouteMap{position:absolute;inset:0;background:#1a1114}
+.mp-routeinfo{position:absolute;left:10px;right:10px;bottom:10px;z-index:500;display:flex;flex-direction:column;gap:9px}
+.mp-routestats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:rgba(15,8,11,.9);backdrop-filter:blur(16px);border:1px solid var(--mp-line2);border-radius:18px;padding:11px 6px}
+.mp-routestats div{text-align:center}.mp-routestats b{display:block;font-size:16px;font-weight:800}.mp-routestats small{font-size:10px;color:var(--mp-text3);font-weight:600}
+
+/* ══════════ 7 · SAVED ══════════ */
+.mp-tabs{display:flex;gap:6px;background:var(--mp-card);border:1px solid var(--mp-line);border-radius:16px;padding:5px;margin:6px 0 14px}
+.mp-tabs div{flex:1;text-align:center;padding:10px 4px;border-radius:12px;font-size:12.5px;font-weight:700;color:var(--mp-text2);cursor:pointer;transition:var(--mp-t)}
+.mp-tabs div.on{background:var(--mp-grad);color:#fff;box-shadow:0 6px 16px var(--mp-red-glow)}
+#mpSavedList{display:grid;grid-template-columns:1fr;gap:12px}
+@media(min-width:760px){#mpSavedList{grid-template-columns:1fr 1fr}}
+.mp-plan{display:flex;border-radius:22px;overflow:hidden;background:var(--mp-card);border:1px solid var(--mp-line);cursor:pointer;position:relative;transition:var(--mp-t)}
+.mp-plan:active{transform:scale(.985)}
+.mp-plan-d{width:74px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px 4px;text-align:center;background:var(--mp-grad)}
