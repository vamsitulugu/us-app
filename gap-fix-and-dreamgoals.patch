+
+/* Mobile: iframe pages (Meet Planner, Music, Movie, Dream Goals, Games,
+   Love Counter, ...) now run all the way to the bottom of the screen and
+   scroll BEHIND the floating nav pill instead of stopping ~110px above it
+   (that cut-off edge was the visible "gap"). The pages themselves add
+   bottom clearance via /iframe-nav-clearance.css so the last item and any
+   bottom sheets stay reachable. Immersive pages (nav hidden) unchanged. */
+@media (max-width:700px){
+body:not([data-immersive="1"]) .iframe-page-wrap{height:calc(100dvh - var(--topbar-h-mobile))!important}
+}
