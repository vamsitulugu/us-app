{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd cinema && npm install",
  "buildCommand": "cd cinema && npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://us-app-av6d.onrender.com/api/:path*"
    }
  ]
}
