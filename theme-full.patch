index 0000000..224ae98
--- /dev/null
+++ b/css-src/theme-ui.css
@@ -0,0 +1,49 @@
+/* ============================================================
+   theme-ui.css — shared component skin for the blue Light/Dark
+   design (header bands, sheets, cards, buttons, tabs, chips…).
+   Loaded AFTER theme-tokens.css. Everything here is token-driven,
+   so it follows <html data-theme="dark|light"> automatically.
+   ============================================================ */
+
+/* ── 1. "Band" scope: anything sitting on the blue header gradient
+      gets white text in BOTH themes. Tokens are re-declared locally
+      so every var(--fg…) / var(--text…) inside the band flips to white. */
+.dh-top, .dh-intro, .dh-search-row, .topbar, .hdr-band, .ui-band {
+  --fg: #fff;  --fg-2: rgba(255,255,255,.80);  --fg-3: rgba(255,255,255,.58);
+  --white: #fff;  --text: #fff;  --text2: rgba(255,255,255,.80);  --text3: rgba(255,255,255,.58);
+  --line: rgba(255,255,255,.22);  --line-2: rgba(255,255,255,.34);
+  --border: rgba(255,255,255,.22);  --border2: rgba(255,255,255,.34);
+  --ov-1: rgba(255,255,255,.10);  --ov-2: rgba(255,255,255,.16);  --ov-3: rgba(255,255,255,.24);
+  --g1: rgba(255,255,255,.10);  --g2: rgba(255,255,255,.16);  --g3: rgba(255,255,255,.24);
+  --gb: rgba(255,255,255,.16);  --gd: rgba(255,255,255,.10);
+  --ov-rgb: 255,255,255;  --shadow-rgb: 0,12,50;
+  color: #fff}
+
+/* ── 2. Top bar = blue band (all in-app pages) ── */
+.topbar {
+  background: var(--hdr-grad) !important;
+  border-bottom: 0 !important;
+  box-shadow: 0 6px 22px rgba(0, 40, 120, .22);
+  -webkit-backdrop-filter: none !important; backdrop-filter: none !important}
+.topbar .tb-title { color: #fff; font-weight: 700}
+.topbar .ic-btn, .topbar .btn-glass, .topbar .tb-back {
+  background: rgba(255,255,255,.14) !important;
+  border: 1px solid rgba(255,255,255,.28) !important;
+  color: #fff !important}
+
+/* ── 3. Sheet: content area slides up under the band with rounded top ── */
+/* The band is taller than the bar's content; the sheet overlaps it. */
+.topbar { height: auto !important; min-height: 58px; padding-bottom: 18px !important; position: relative; z-index: 2}
+.main .content {
+  position: relative; z-index: 3;
+  margin-top: -16px;
+  background: var(--bg);
+  border-radius: 24px 24px 0 0;
+  box-shadow: 0 -4px 18px rgba(var(--shadow-rgb), .10)}
+
+/* ── 4. Dashboard hero (inside .dh) ── */
+.dh-quote em, .dh-intro em { color: #CFE3FF !important}
+
+/* ── 5. Typography: the reference design is all-sans (Inter). The old
+      serif display face is mapped to Inter so every heading matches. */
+:root[data-theme] { --ff-serif: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; --ff-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif}
