index 0000000..c3f924b
--- /dev/null
+++ b/public/theme-switcher.js
@@ -0,0 +1,102 @@
+/* theme-switcher.js — runtime theme control (Light / Dark / System).
+   Loaded (deferred) on index.html and every iframe page.
+   API:  UsTheme.set('light'|'dark'|'system')  UsTheme.pref()  UsTheme.get()
+         UsTheme.barColor()   → colour for <meta theme-color> / native status bar
+   Event: window 'us-theme-change'  { detail: { theme, pref } }
+          (JS-drawn colours — map markers, orb canvas, globe — can listen to it)
+   Sync:  parent ↔ iframes via 'storage' event + postMessage. */
+(function () {
+  'use strict';
+  if (window.UsTheme) return;
+  var KEY = 'us_theme_pref';
+  var BAR = { dark: '#060910', light: '#F7F9FC' };   // keep in sync with --bar in theme-tokens.css
+  var root = document.documentElement;
+  var mq = window.matchMedia ? matchMedia('(prefers-color-scheme: light)') : null;
+
+  function readPref() {
+    var p = null; try { p = localStorage.getItem(KEY); } catch (e) {}
+    return (p === 'light' || p === 'dark' || p === 'system') ? p : 'dark';
+  }
+  function resolve(pref) {
+    return pref === 'system' ? ((mq && mq.matches) ? 'light' : 'dark') : pref;
+  }
+  function barColor() {
+    var v = '';
+    try { v = getComputedStyle(root).getPropertyValue('--bar').trim(); } catch (e) {}
+    return v || BAR[root.getAttribute('data-theme')] || BAR.dark;
+  }
+  function syncChrome(theme) {
+    var c = barColor();
+    var metas = document.querySelectorAll('meta[name="theme-color"]');
+    for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', c);
+    // Native Android shell (Capacitor StatusBar plugin) — silently skipped on web
+    try {
+      var SB = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.StatusBar;
+      if (SB) {
+        if (SB.setBackgroundColor) SB.setBackgroundColor({ color: c });
+        if (SB.setStyle) SB.setStyle({ style: theme === 'light' ? 'LIGHT' : 'DARK' }); // LIGHT = dark icons
+      }
+    } catch (e) {}
+  }
+  function syncControls() {
+    var pref = root.getAttribute('data-theme-pref');
+    var btns = document.querySelectorAll('[data-theme-choice]');
+    for (var i = 0; i < btns.length; i++) {
+      var on = btns[i].getAttribute('data-theme-choice') === pref;
+      btns[i].classList.toggle('on', on);
+      btns[i].setAttribute('aria-checked', on ? 'true' : 'false');
+    }
+  }
+  function apply(pref, opts) {
+    opts = opts || {};
+    var theme = resolve(pref);
+    root.setAttribute('data-theme', theme);
+    root.setAttribute('data-theme-pref', pref);
+    syncChrome(theme);
+    syncControls();
+    if (!opts.silent) {
+      try { window.dispatchEvent(new CustomEvent('us-theme-change', { detail: { theme: theme, pref: pref } })); } catch (e) {}
+    }
+    return theme;
+  }
+  function broadcast(pref) {
+    var frames = document.getElementsByTagName('iframe');
+    for (var i = 0; i < frames.length; i++) {
+      try { frames[i].contentWindow.postMessage({ type: 'us-theme', pref: pref }, location.origin); } catch (e) {}
+    }
+  }
+  function set(pref) {
+    if (pref !== 'light' && pref !== 'dark' && pref !== 'system') pref = 'dark';
+    try { localStorage.setItem(KEY, pref); } catch (e) {}
+    apply(pref);
+    broadcast(pref);
+  }
+
+  window.UsTheme = {
+    set: set,
+    pref: function () { return root.getAttribute('data-theme-pref') || readPref(); },
+    get: function () { return root.getAttribute('data-theme') || 'dark'; },
+    barColor: barColor
+  };
+
+  // other documents (iframes / other tabs) changed it
+  window.addEventListener('storage', function (e) { if (e.key === KEY) apply(readPref()); });
+  window.addEventListener('message', function (e) {
+    if (e.origin !== location.origin) return;
+    var d = e.data;
+    if (d && d.type === 'us-theme' && (d.pref === 'light' || d.pref === 'dark' || d.pref === 'system')) apply(d.pref);
+  });
+  // "System" follows the OS live
+  if (mq) {
+    var onSys = function () { if (readPref() === 'system') apply('system'); };
+    if (mq.addEventListener) mq.addEventListener('change', onSys); else if (mq.addListener) mq.addListener(onSys);
+  }
+  // segmented controls (Settings → Appearance) are wired by delegation
+  document.addEventListener('click', function (e) {
+    var b = e.target && e.target.closest && e.target.closest('[data-theme-choice]');
+    if (b) { e.preventDefault(); set(b.getAttribute('data-theme-choice')); }
+  });
+
+  function ready() { apply(readPref(), { silent: true }); }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready); else ready();
+})();
