--- /dev/null
+++ b/public/theme-init.js
@@ -0,0 +1,26 @@
+/* theme-init.js — runs synchronously in <head>, BEFORE first paint.
+   Reads the saved preference ('light' | 'dark' | 'system'; default 'dark'),
+   resolves it to a real theme and stamps <html data-theme="…"> so the very
+   first frame is already in the right colours (no dark→light flash).
+   Full token palette lives in /theme-tokens.css; only the two page-level
+   colours needed for the first paint are inlined here. */
+(function () {
+  var KEY = 'us_theme_pref';
+  var pref = null;
+  try { pref = localStorage.getItem(KEY); } catch (e) {}
+  if (pref !== 'light' && pref !== 'dark' && pref !== 'system') pref = 'dark';
+  var theme = pref;
+  if (pref === 'system') {
+    theme = (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
+  }
+  var root = document.documentElement;
+  root.setAttribute('data-theme', theme);
+  root.setAttribute('data-theme-pref', pref);
+  var st = document.createElement('style');
+  st.id = 'themeCritical';
+  st.textContent =
+    ':root[data-theme="dark"]{--bg:#060910;--fg:#fff;color-scheme:dark}' +
+    ':root[data-theme="light"]{--bg:#F7F9FC;--fg:#0F1B3D;color-scheme:light}' +
+    'html{background:var(--bg)}';
+  (document.head || root).appendChild(st);
+})();
