--- /dev/null
+++ b/css-src/theme-tokens.css
@@ -0,0 +1,273 @@
+/* ============================================================
+   theme-tokens.css — Twin Hearts colour system (Light + Dark)
+   ------------------------------------------------------------
+   SINGLE SOURCE OF TRUTH for every colour in the app.
+   Palette sampled from the two reference sheets (dark-blue and
+   light-blue "Watch Together" mockups).
+
+   Theme is chosen by <html data-theme="dark|light">, set before
+   first paint by /theme-init.js and changed by /theme-switcher.js
+   (Settings → Appearance → Theme).
+
+   Specificity note: selectors are  :root[data-theme="…"]  (0,2,0)
+   so they beat every page's own  :root{…}  block no matter what
+   order the stylesheets load in. Do NOT add !important here.
+
+   Layout of this file
+     1. Brand + semantic tokens         (what you edit to re-colour)
+     2. Legacy aliases                  (old variable names → tokens,
+                                         so un-migrated CSS follows
+                                         the theme automatically)
+     3. Per-module palette aliases      (--mx-*, --mp-*, --wt-*, --pm-*)
+     4. Base element behaviour          (bg, scrollbars, form fields)
+   ============================================================ */
+
+/* ───────────── 1a. DARK (default) ───────────── */
+:root,
+:root[data-theme="dark"] {
+  color-scheme: dark;
+
+  /* brand blue (primary buttons, active tabs, toggles) */
+  --brand:        #0574FF;
+  --brand-d:      #0352FD;
+  --brand-l:      #6EA9FE;
+  --brand-rgb:    5, 116, 255;
+  --brand-glow:   rgba(5, 116, 255, .38);
+  --brand-grad:   linear-gradient(135deg, #0574FF 0%, #0352FD 100%);
+  --brand-soft:   rgba(5, 116, 255, .16);      /* tinted chip / selected row */
+  --brand-soft-b: rgba(5, 116, 255, .45);      /* its border */
+
+  /* secondary (gradient partner for brand, avatars) */
+  --brand2:       #3DA5FF;
+  --brand2-d:     #0B5FD6;
+  --brand2-glow:  rgba(61, 165, 255, .32);
+
+  /* relationship / emotional actions only (hearts, miss-you) */
+  --love:         #FF4D6D;
+  --love-rgb:     255, 77, 109;
+  --love-soft:    rgba(255, 77, 109, .16);
+
+  /* page + surfaces */
+  --bg:           #060910;     /* page background */
+  --bg-2:         #0A0F18;     /* behind sheets / modals */
+  --surface:      #12171E;     /* cards */
+  --surface-2:    #1A2028;     /* raised card, tab bar, chips */
+  --field:        #141A21;     /* inputs, search box */
+  --panel-navy:   #021C4E;     /* highlighted room / selection panels */
+  --scrim:        rgba(2, 6, 14, .66);
+  --bg-glass:     rgba(6, 9, 16, .86);     /* translucent top bars */
+  --modal-glass:  rgba(14, 20, 30, .92);   /* modals / auth card */
+
+  /* blue header band (top bars) */
+  --hdr-grad:     linear-gradient(180deg, #0052BC 0%, #003B89 48%, #00245A 100%);
+  --hdr-solid:    #003B89;
+  --on-hdr:       #FFFFFF;
+  --nav-bg:       rgba(10, 16, 28, .84);
+  --nav-border:   rgba(120, 160, 255, .22);
+  --nav-fg:       rgba(255, 255, 255, .58);
+  --nav-active:   #2F86FF;
+  --nav-shadow:   0 12px 32px rgba(0, 0, 0, .55), 0 0 0 1px rgba(47, 134, 255, .10);
+  --bar:          #060910;     /* status bar / <meta theme-color> (set to header colour once headers are blue) */
+
+  /* text */
+  --fg:           #FFFFFF;
+  --fg-2:         rgba(255, 255, 255, .66);
+  --fg-3:         rgba(255, 255, 255, .42);
+  --on-brand:     #FFFFFF;     /* text on brand-coloured buttons: ALWAYS white */
+
+  /* lines + glass overlays */
+  --line:         rgba(255, 255, 255, .09);
+  --line-2:       rgba(255, 255, 255, .16);
+  --ov-1:         rgba(255, 255, 255, .04);
+  --ov-2:         rgba(255, 255, 255, .08);
+  --ov-3:         rgba(255, 255, 255, .13);
+  --shadow-rgb:   0, 0, 0;
+  --ov-rgb:       255, 255, 255;      /* tint colour for glass overlays */
+  --panel-rgb:    10, 14, 22;         /* translucent panels */
+  --well-rgb:     0, 0, 0;            /* inset wells / dim layers */
+  --shadow-card:  0 6px 22px rgba(0, 0, 0, .45);
+  --shadow-pop:   0 14px 40px rgba(0, 0, 0, .6);
+
+  /* status colours */
+  --ok:           #34D399;  --ok-bg:   rgba(52, 211, 153, .15);
+  --warn:         #FBBF24;  --warn-bg: rgba(251, 191, 36, .15);
+  --danger:       #FD4157;  --danger-bg: rgba(253, 65, 87, .15);  --danger-rgb: 253, 65, 87;
+  --gold:         #FFC94A;  --gold-glow: rgba(255, 201, 74, .40);
+  --star:         #FBBF24;
+}
+
+/* ───────────── 1b. LIGHT ───────────── */
+:root[data-theme="light"] {
+  color-scheme: light;
+
+  --brand:        #0575FE;
+  --brand-d:      #0059D6;
+  --brand-l:      #5AA2FF;
+  --brand-rgb:    5, 117, 254;
+  --brand-glow:   rgba(5, 117, 254, .28);
+  --brand-grad:   linear-gradient(135deg, #1A82FF 0%, #0059D6 100%);
+  --brand-soft:   #E3EFFE;
+  --brand-soft-b: rgba(5, 117, 254, .35);
+
+  --brand2:       #0A8CFF;
+  --brand2-d:     #0B5FD6;
+  --brand2-glow:  rgba(10, 140, 255, .24);
+
+  --love:         #F43F5E;
+  --love-rgb:     244, 63, 94;
+  --love-soft:    rgba(244, 63, 94, .12);
+
+  --bg:           #F7F9FC;
+  --bg-2:         #EEF3FA;
+  --surface:      #FFFFFF;
+  --surface-2:    #F0F6FE;
+  --field:        #EAF0F8;
+  --panel-navy:   #E3EFFE;
+  --scrim:        rgba(15, 27, 61, .42);
+  --bg-glass:     rgba(247, 249, 252, .88);
+  --modal-glass:  rgba(255, 255, 255, .96);
+
+  --hdr-grad:     linear-gradient(180deg, #0A6BE0 0%, #005ED0 100%);
+  --hdr-solid:    #005ED0;
+  --on-hdr:       #FFFFFF;
+  --nav-bg:       rgba(255, 255, 255, .95);
+  --nav-border:   #E1E8F3;
+  --nav-fg:       #7A89A8;
+  --nav-active:   #0575FE;
+  --nav-shadow:   0 10px 28px rgba(16, 56, 120, .16);
+  --bar:          #F7F9FC;
+
+  --fg:           #0F1B3D;
+  --fg-2:         rgba(15, 27, 61, .68);
+  --fg-3:         rgba(15, 27, 61, .44);
+  --on-brand:     #FFFFFF;
+
+  --line:         #E1E8F3;
+  --line-2:       #CFD9EA;
+  --ov-1:         rgba(15, 27, 61, .035);
+  --ov-2:         rgba(15, 27, 61, .06);
+  --ov-3:         rgba(15, 27, 61, .10);
+  --shadow-rgb:   16, 56, 120;
+  --ov-rgb:       15, 27, 61;
+  --panel-rgb:    255, 255, 255;
+  --well-rgb:     15, 27, 61;
+  --shadow-card:  0 4px 18px rgba(16, 56, 120, .09);
+  --shadow-pop:   0 14px 36px rgba(16, 56, 120, .18);
+
+  --ok:           #10A874;  --ok-bg:   rgba(16, 168, 116, .12);
+  --warn:         #E89A0C;  --warn-bg: rgba(232, 154, 12, .14);
+  --danger:       #E5304A;  --danger-bg: rgba(229, 48, 74, .10);  --danger-rgb: 229, 48, 74;
+  --gold:         #E6A100;  --gold-glow: rgba(230, 161, 0, .30);
+  --star:         #F5A623;
+}
+
+/* ───────────── 2. LEGACY ALIASES ─────────────
+   Every page (index.html + each iframe page) defines its own
+   --accent / --g1 / --text … in an inline :root. These aliases
+   override those, so all ~600 existing var(--accent…) usages
+   follow the active theme with zero markup changes. */
+:root[data-theme] {
+  --accent:        var(--brand);
+  --accent-d:      var(--brand-d);
+  --accent-l:      var(--brand-l);
+  --accent-glow:   var(--brand-glow);
+  --accent-rgb:    var(--brand-rgb);
+  --accent2:       var(--brand2);
+  --accent2-d:     var(--brand2-d);
+  --accent2-glow:  var(--brand2-glow);
+  --blue:          var(--brand);
+  --blue-bg:       var(--brand-glow);
+
+  --g1: var(--ov-1);  --g2: var(--ov-2);  --g3: var(--ov-3);
+  --gb: var(--ov-2);  --gd: var(--ov-1);
+  --border:  var(--line);
+  --border2: var(--line-2);
+
+  --white: var(--fg);      /* "white" was used as the main text colour */
+  --text:  var(--fg);
+  --text2: var(--fg-2);
+  --text3: var(--fg-3);
+
+  --green: var(--ok);     --green-bg:  var(--ok-bg);
+  --red:   var(--danger); --red-bg:    var(--danger-bg);
+  --yellow: var(--warn);  --yellow-bg: var(--warn-bg);
+}
+
+/* ───────────── 3. PER-MODULE PALETTE ALIASES ───────────── */
+:root[data-theme] {
+  /* premium-motion (press blooms, glows) */
+  --pm-red:        var(--brand);
+  --pm-red-deep:   var(--brand-d);
+  --pm-red-bright: var(--brand-l);
+  --pm-glow:       var(--brand-glow);
+  --pm-bg-glow:    var(--brand-soft);
+  --pm-glass-border: var(--line);
+
+  /* Music */
+  --mx-bg:      var(--bg);
+  --mx-surface: var(--surface);
+  --mx-card:    var(--ov-1);
+  --mx-card2:   var(--ov-2);
+  --mx-line:    var(--line);
+  --mx-line2:   var(--line-2);
+  --mx-text:    var(--fg);
+  --mx-text2:   var(--fg-2);
+  --mx-text3:   var(--fg-3);
+  --mx-red:     var(--brand);
+  --mx-red-d:   var(--brand-d);
+  --mx-glow:    var(--brand-glow);
+  --mx-ok:      var(--ok);
+  --mx-warn:    var(--warn);
+  --mx-bad:     var(--danger);
+
+  /* Meet planner */
+  --mp-bg:       var(--bg);
+  --mp-bg2:      var(--bg-2);
+  --mp-card:     var(--ov-1);
+  --mp-card2:    var(--ov-2);
+  --mp-line:     var(--line);
+  --mp-line2:    var(--line-2);
+  --mp-text:     var(--fg);
+  --mp-text2:    var(--fg-2);
+  --mp-text3:    var(--fg-3);
+  --mp-red:      var(--brand);
+  --mp-red2:     var(--brand-d);
+  --mp-red-soft: var(--brand-soft);
+  --mp-red-glow: var(--brand-glow);
+  --mp-grad:     var(--brand-grad);
+  --mp-green:    var(--ok);    --mp-green-bg: var(--ok-bg);
+  --mp-amber:    var(--warn);  --mp-amber-bg: var(--warn-bg);
+
+  /* Watch Together / Movie */
+  --wt-bg:       var(--bg);
+  --wt-card:     var(--ov-1);
+  --wt-card-brd: var(--line);
+  --wt-red1:     var(--brand-l);
+  --wt-red2:     var(--brand);
+  --wt-grad:     var(--brand-grad);
+  --wt-muted:    var(--fg-3);
+  /* --wt-chat-yellow stays yellow (design decision) */
+}
+
+/* ───────────── 4. BASE ELEMENT BEHAVIOUR ───────────── */
+:root[data-theme] body {
+  background-color: var(--bg);
+  color: var(--fg);
+}
+:root[data-theme="light"] ::selection { background: rgba(var(--brand-rgb), .22); }
+:root[data-theme="dark"]  ::selection { background: rgba(var(--brand-rgb), .45); }
+
+:root[data-theme="light"] input,
+:root[data-theme="light"] textarea,
+:root[data-theme="light"] select { color: var(--fg); }
+:root[data-theme="light"] input::placeholder,
+:root[data-theme="light"] textarea::placeholder { color: var(--fg-3); }
+:root[data-theme="light"] select option { background: #fff; color: var(--fg); }
+:root[data-theme="dark"]  select option { background: #0D1118; color: #fff; }
+
+/* buttons that sit on the brand colour keep white text in BOTH themes
+   (--white now means "main text colour", which is navy in light mode) */
+:root[data-theme] .btn-accent,
+:root[data-theme] .ic-btn.accent,
+:root[data-theme] .btn-primary,
+:root[data-theme] .toggle.on::after { color: var(--on-brand); }
