   width: 100%; height: 100%;
   border: none; display: block; background: transparent;
 }
+
+/* ── Instant iframe pages ─────────────────────────────────────────
+   .page is display:none when inactive. An iframe inside a display:none
+   ancestor is never laid out or painted, so on first open it had to
+   build layout + paint from scratch -> a blank flash. For the iframe
+   pages below we keep them laid out at their real size while inactive
+   (zero-height, clipped, invisible), so opening one only flips
+   visibility. Globe is excluded: Cesium/WebGL would keep rendering
+   hidden and drain battery. */
+#page-music:not(.active), #page-movie:not(.active), #page-games:not(.active),
+#page-dreamgoals:not(.active), #page-places:not(.active), #page-meetplanner:not(.active),
+#page-dailyroutine:not(.active), #page-lovecounter:not(.active), #page-collection:not(.active) {
+  display: block !important;
+  height: 0 !important;
+  min-height: 0 !important;
+  padding: 0 !important;
+  overflow: hidden !important;
+  visibility: hidden !important;
+  pointer-events: none !important;
+}
+/* Cover shown only until an iframe has finished its first load, so a
+   not-yet-loaded page shows the themed background instead of black. */
+.us-frame-cover {
+  position: absolute; inset: 0; z-index: 2;
+  background: var(--bg, #14030e);
+  display: flex; align-items: center; justify-content: center;
+  transition: opacity .18s ease; pointer-events: none;
+}
+.us-frame-cover::after {
+  content: ''; width: 26px; height: 26px; border-radius: 50%;
+  border: 2px solid transparent; border-top-color: var(--accent, #B0127A);
+  border-right-color: var(--accent, #B0127A);
+  animation: usFrameSpin .8s linear infinite;
+}
+.us-frame-cover.done { opacity: 0; }
+@keyframes usFrameSpin { to { transform: rotate(360deg); } }
 @media(max-width: 700px) {
