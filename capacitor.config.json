{
  "appId": "com.uswithlove.app",
  "appName": "Twin Hearts",
  "webDir": "public",
  "backgroundColor": "#14030e",
  "server": {
    "url": "https://twinhearts.vercel.app",
    "androidScheme": "https",
    "allowNavigation": [
      "useverythingtogether.vercel.app",
      "us-app-av6d.onrender.com",
      "*.supabase.co"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#14030e",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#14030e",
      "overlaysWebView": true
    },
    "BiometricAuth": {
      "title": "Unlock Twin Hearts",
      "subtitle": "Use your fingerprint or face",
      "description": "Biometric authentication required to access your private vault",
      "negativeButtonText": "Cancel"
    },
    "LocalNotifications": {
      "channelId": "twin_hearts_local",
      "channelName": "Twin Hearts Reminders",
      "channelDescription": "Anniversary, birthday, and reminder notifications"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  }
}