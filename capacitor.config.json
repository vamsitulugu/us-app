{
  "appId": "com.uswithlove.app",
  "appName": "Twin Hearts",
  "webDir": "public",
  "server": {
    "url": "https://twinhearts.vercel.app",
    "androidScheme": "https",
    "allowNavigation": [
      "useverythingtogether.vercel.app",
      "us-app-av6d.onrender.com",
      "*.supabase.co"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#06122E",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#030816",
      "overlaysWebView": true
    }
  }
}