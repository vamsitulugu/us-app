diff --git a/public/theme-dark-glass.css b/public/theme-dark-glass.css
new file mode 100644
index 0000000..01d05d2
--- /dev/null
+++ b/public/theme-dark-glass.css
@@ -0,0 +1,224 @@
+/* ════════════════════════════════════════════════════════════════════
+   THEME DARK GLASS — neutral gray "frosted glass" for the dark theme.
+   Linked LAST (after theme-dark-v2.css / dashboard-burgundy.css).
+   Only touches html[data-theme="dark"]; the light theme is unchanged.
+
+   What changes (and only this):
+     • cards, panels, modals, menus  → gray glass
+     • search bars + type bars       → gray glass
+     • buttons, chips, toggles       → gray glass
+     • text                          → white / soft white (no pink)
+     • chat: partner bubbles         → black
+     • bottom nav                    → fully glass
+   The page background keeps its deep burgundy-black gradient.
+   ════════════════════════════════════════════════════════════════════ */
+
+html[data-theme="dark"] {
+  /* ── glass recipe (reused everywhere below) ── */
+  --gl-fill: linear-gradient(180deg, rgba(255,255,255,.115) 0%, rgba(255,255,255,.045) 100%);
+  --gl-fill-strong: linear-gradient(180deg, rgba(255,255,255,.20) 0%, rgba(255,255,255,.09) 100%);
+  --gl-line: rgba(255,255,255,.14);
+  --gl-line-2: rgba(255,255,255,.24);
+  --gl-shadow: 0 10px 30px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.16), inset 0 -1px 0 rgba(0,0,0,.22);
+  --gl-blur: blur(18px) saturate(140%);
+
+  /* ── neutral accent (replaces the pink/magenta accent) ── */
+  --accent:#8a8a92 !important; --accent-d:#55555c !important; --accent-l:#c4c4ca !important;
+  --accent-glow:rgba(255,255,255,.16) !important;
+  --accent2:#8a8a92 !important; --accent2-d:#55555c !important; --accent2-glow:rgba(255,255,255,.14) !important;
+  --brand:#8a8a92; --brand-d:#55555c; --brand-l:#c4c4ca; --brand-glow:rgba(255,255,255,.16);
+  --brand2:#8a8a92; --brand2-glow:rgba(255,255,255,.14);
+  --blue:#8a8a92 !important; --blue-bg:rgba(255,255,255,.14) !important;
+  --pm-red:#8a8a92 !important; --pm-red-deep:#55555c !important; --pm-red-bright:#c4c4ca !important;
+  --pm-glow:rgba(255,255,255,.16) !important; --pm-bg-glow:rgba(255,255,255,.05) !important;
+  --mx-red:#c4c4ca !important; --mx-red-d:#8a8a92 !important;
+  --mp-red:#8a8a92 !important; --mp-red2:#55555c !important;
+  --wt-red1:#c4c4ca !important; --wt-red2:#8a8a92 !important;
+
+  /* ── neutral surfaces + glass tints (were pink) ── */
+  --surface:#1f1b1d !important; --surface-2:#2a2527 !important;
+  --g1:rgba(255,255,255,.05) !important; --g2:rgba(255,255,255,.09) !important; --g3:rgba(255,255,255,.14) !important;
+  --gb:rgba(255,255,255,.07) !important; --gd:rgba(255,255,255,.035) !important;
+  --border:rgba(255,255,255,.12) !important; --border2:rgba(255,255,255,.22) !important;
+  --text:rgba(255,255,255,.95) !important; --text2:rgba(255,255,255,.72) !important; --text3:rgba(255,255,255,.52) !important;
+
+  /* variables owned by theme-dark-v2.css */
+  --d-card: rgba(255,255,255,.075); --d-card-2: rgba(255,255,255,.10); --d-card-solid: rgba(255,255,255,.11);
+  --d-line: rgba(255,255,255,.13); --d-line-2: rgba(255,255,255,.22);
+  --d-ink:#ffffff; --d-ink-2: rgba(255,255,255,.74); --d-ink-3: rgba(255,255,255,.52);
+  --d-blue: rgba(255,255,255,.34); --d-blue-soft: rgba(255,255,255,.10);
+  --d-btn: linear-gradient(180deg, rgba(255,255,255,.26) 0%, rgba(255,255,255,.11) 100%);
+  --d-btn-shadow: 0 8px 20px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.30);
+  --d-shadow: 0 10px 30px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.14);
+  --d-danger:#f87171; --d-danger-bg: rgba(248,113,113,.14);
+  --blue-text:#ffffff;
+  --mp-text3: rgba(255,255,255,.52); --mx-text3: rgba(255,255,255,.52); --wt-muted: rgba(255,255,255,.52);
+  --mx-text2: rgba(255,255,255,.74); --mp-text2: rgba(255,255,255,.74);
+  --mx-line: rgba(255,255,255,.13); --mp-line: rgba(255,255,255,.13);
+  --dh-burgundy: rgba(255,255,255,.10);
+}
+
+/* ───────── Background glows: soft + neutral (no pink wash) ───────── */
+html[data-theme="dark"], html[data-theme="dark"] body {
+  background: linear-gradient(180deg, #230415 0%, #0e0209 60%) fixed !important;
+  background-color: #0e0209 !important;
+}
+html[data-theme="dark"] #bg::before {
+  background: radial-gradient(circle at 15% 12%, rgba(255,255,255,.04), transparent 50%),
+              radial-gradient(circle at 85% 8%, rgba(255,255,255,.03), transparent 50%) !important;
+}
+html[data-theme="dark"] .fheart { opacity: .25; }
+
+/* ═════════════ CARDS / PANELS → gray glass ═════════════ */
+html[data-theme="dark"] :is(.card,.metric,.m-card,.pstat,.period-hero,.storage-hero),
+html[data-theme="dark"] :is(.col-stat,.dg-stat,.pm-stat,.lc-time-card,.lc-card,.lc-bday-card,.mc-stat,.pf-stat,.lv-card,.pf-list,.pf-ms,.pf-act,.set-list,.gcard,.rank-card,.cat-list),
+html[data-theme="dark"] :is(.dw-ev,.dw-mood,.dw-q1,.th-opt,.wp-option-row) {
+  background: var(--gl-fill) !important; background-color: transparent !important;
+  border: 1px solid var(--gl-line) !important;
+  box-shadow: var(--gl-shadow) !important;
+  -webkit-backdrop-filter: var(--gl-blur); backdrop-filter: var(--gl-blur);
+}
+html[data-theme="dark"] .lc-bday-card { background: var(--gl-fill-strong) !important; }
+html[data-theme="dark"] :is(.set-row) { background: transparent; }
+html[data-theme="dark"] :is(.set-row,.cat-row):hover { background: rgba(255,255,255,.06); }
+html[data-theme="dark"] .cat-row { border-bottom-color: rgba(255,255,255,.09); }
+
+/* today's event keeps its white highlight, text goes dark-neutral (not burgundy) */
+html[data-theme="dark"] .dw-ev.is-today { background: rgba(255,255,255,.94) !important; color: #161214; border-color: #fff !important; }
+html[data-theme="dark"] .dw-ev.is-today .dw-ev-d { color: #161214 !important; }
+html[data-theme="dark"] .dw-ev.is-today .dw-ev-ico { background: rgba(0,0,0,.08); }
+html[data-theme="dark"] .dw-ev .dw-ev-d { color: #fff !important; }
+html[data-theme="dark"] .dw-ev .dw-ev-ico { background: rgba(255,255,255,.12); }
+html[data-theme="dark"] .dh-quote em { color: #fff; }
+
+/* big neutral panels (were deep pink) */
+html[data-theme="dark"] .dh-sheet { background: #130e10 !important; border-top: 1px solid var(--gl-line); }
+html[data-theme="dark"] :is(.dw-overlay,.dw-foot,.dw-panel) { background: #130e10; }
+
+/* modals + menus */
+html[data-theme="dark"] :is(.modal,.auth-card,.wp-modal,.chat-header-menu) {
+  background: linear-gradient(180deg, rgba(60,55,58,.88), rgba(28,24,26,.92)) !important;
+  border: 1px solid var(--gl-line-2) !important;
+  box-shadow: 0 24px 60px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.14) !important;
+  -webkit-backdrop-filter: blur(24px) saturate(150%); backdrop-filter: blur(24px) saturate(150%);
+}
+html[data-theme="dark"] .modal-bg, html[data-theme="dark"] .wp-modal-overlay { background: rgba(8,4,6,.72); }
+html[data-theme="dark"] .th-opt[data-v="dark"] .th-sw { background: linear-gradient(160deg,#2b2628,#0c0709 75%); box-shadow: inset 0 0 0 3px rgba(255,255,255,.28); }
+html[data-theme="dark"] .th-opt.on { border-color: rgba(255,255,255,.55) !important; box-shadow: 0 0 0 3px rgba(255,255,255,.14) !important; }
+
+/* ═════════════ SEARCH BARS + TYPE BARS → gray glass ═════════════ */
+html[data-theme="dark"] :is(.set-search,.dh-search,.mc-search,.uc-input-wrap),
+html[data-theme="dark"] :is(input[type=text],input[type=password],input[type=email],input[type=number],input[type=date],input[type=time],input[type=search],input[type=tel],input[type=url],textarea,select,.chat-in),
+html[data-theme="dark"] .chat-search-bar input {
+  background: rgba(255,255,255,.075) !important; background-image: none !important;
+  border: 1px solid var(--gl-line) !important; color: #fff !important;
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.10), inset 0 -1px 0 rgba(0,0,0,.18) !important;
+  -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%);
+}
+html[data-theme="dark"] :is(.set-search,.dh-search,.mc-search,.uc-input-wrap) :is(input,textarea),
+html[data-theme="dark"] .uc-input {
+  background: transparent !important; border: 0 !important; box-shadow: none !important;
+  -webkit-backdrop-filter: none; backdrop-filter: none; color: #fff !important;
+}
+html[data-theme="dark"] :is(.set-search,.dh-search) { color: rgba(255,255,255,.6); }
+html[data-theme="dark"] .dh-search :is(span,svg) { color: rgba(255,255,255,.72); }
+html[data-theme="dark"] input::placeholder, html[data-theme="dark"] textarea::placeholder { color: rgba(255,255,255,.45) !important; opacity: 1; }
+html[data-theme="dark"] :is(input,textarea,select):focus,
+html[data-theme="dark"] :is(.set-search,.mc-search,.uc-input-wrap):focus-within {
+  background: rgba(255,255,255,.11) !important; border-color: rgba(255,255,255,.38) !important;
+  box-shadow: 0 0 0 3px rgba(255,255,255,.11) !important;
+}
+html[data-theme="dark"] :is(.set-search,.mc-search,.uc-input-wrap) :is(input,textarea):focus { background: transparent !important; box-shadow: none !important; }
+html[data-theme="dark"] select option { background: #2a2527; color: #fff; }
+
+/* ═════════════ BUTTONS / CHIPS / TOGGLES → gray glass ═════════════ */
+html[data-theme="dark"] :is(.btn-accent,.ic-btn.accent,.gplay-btn,.wt-btn-primary,.wt-btn-start,.auth-btn,.dw-btn.primary,.pf-btn.is-primary,.pf-act.is-primary,.set-save,.tile.accent),
+html[data-theme="dark"] :is(.btn-glass,.ic-btn,.dw-btn,.dw-mc,.pf-btn,.tb-back,.cat-back-btn,.set-back,.wt-page:not(.is-watching) .wt-btn-ghost) {
+  background: var(--d-btn) !important; background-color: transparent !important; color: #fff !important;
+  border: 1px solid rgba(255,255,255,.22) !important;
+  box-shadow: var(--d-btn-shadow) !important;
+  -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%);
+}
+html[data-theme="dark"] :is(.btn-glass,.ic-btn):hover,
+html[data-theme="dark"] :is(.btn-accent,.auth-btn):hover { background: var(--gl-fill-strong) !important; filter: none; }
+html[data-theme="dark"] .btn-danger { background: var(--d-danger-bg) !important; color: #fca5a5 !important; border: 1px solid rgba(248,113,113,.35) !important; }
+html[data-theme="dark"] .btn-ghost:hover { background: rgba(255,255,255,.08); color: #fff; }
+html[data-theme="dark"] .tile.accent .tile-ico svg { color: #fff !important; }
+html[data-theme="dark"] .quick .tile-ico { background: rgba(255,255,255,.08); }
+
+html[data-theme="dark"] :is(.chip,.pill,.fchip,.col-chip,.pm-chip,.dg-chip,.filter-chip,.mc-chip) {
+  background: rgba(255,255,255,.07); color: rgba(255,255,255,.78) !important; border: 1px solid var(--gl-line);
+  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
+}
+html[data-theme="dark"] :is(.chip,.pill,.fchip,.col-chip,.pm-chip,.dg-chip,.filter-chip,.mc-chip):is(.active,.on,.is-active),
+html[data-theme="dark"] .wt-tab.is-active, html[data-theme="dark"] .dw-seg button.is-on {
+  background: var(--d-btn) !important; color: #fff !important; border-color: rgba(255,255,255,.3); box-shadow: var(--d-btn-shadow);
+}
+html[data-theme="dark"] :is(.wt-tabs) { background: rgba(255,255,255,.06); border: 1px solid var(--gl-line); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
+html[data-theme="dark"] .toggle { background: rgba(255,255,255,.16) !important; }
+html[data-theme="dark"] .toggle.on { background: rgba(255,255,255,.42) !important; }
+html[data-theme="dark"] :is(.gbadge.new,.feat-badge,.badge) { background: #55555c !important; color: #fff !important; }
+html[data-theme="dark"] .gcard-art,
+html[data-theme="dark"] .gcard:nth-child(3n+2) .gcard-art,
+html[data-theme="dark"] .gcard:nth-child(3n) .gcard-art { background-image: linear-gradient(135deg,#4c4a4f,#27242a) !important; }
+
+/* ═════════════ TEXT → white (no pink) ═════════════ */
+html[data-theme="dark"] :is(.section-tag,.hero-eyebrow,.dw-link,.dw-ev-d,.dw-mood-streak,.dw-reset,.mp-h2 a,a.mp-view-all,.mp-sec-h a) { color: rgba(255,255,255,.85) !important; }
+html[data-theme="dark"] :is(.set-sec-t,.set-s,.set-val,.set-chev,.set-hero-sub) { color: rgba(255,255,255,.58); }
+html[data-theme="dark"] .chat-call-log svg { color: #fff; }
+html[data-theme="dark"] .dw-graph .g-grid { stroke: rgba(255,255,255,.10); }
+html[data-theme="dark"] .set-hero-av > span { border-color: rgba(255,255,255,.4); }
+
+/* ═════════════ CHAT ═════════════ */
+html[data-theme="dark"] #page-chat { --text2: rgba(255,255,255,.72); --text3: rgba(255,255,255,.52); --border: rgba(255,255,255,.12); --border2: rgba(255,255,255,.22); }
+/* partner (left) bubbles → black */
+html[data-theme="dark"] #page-chat :is(.chat-bubble.theirs,.msg-row.them .bubble) {
+  background: #000 !important; color: #fff !important; border: 1px solid rgba(255,255,255,.10) !important;
+}
+html[data-theme="dark"] #page-chat :is(.chat-bubble.theirs,.msg-row.them .bubble) :is(.chat-time,.msg-time,time,.chat-meta,small,.bubble-meta) { color: rgba(255,255,255,.5) !important; }
+/* my (right) bubbles → gray glass */
+html[data-theme="dark"] #page-chat :is(.chat-bubble.mine,.msg-row.me .bubble) {
+  background: linear-gradient(135deg, rgba(120,120,128,.92), rgba(70,70,77,.92)) !important; color: #fff !important;
+  border: 1px solid rgba(255,255,255,.16) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.22);
+}
