+    }).eq('id', row.couple_id);
+    if (uErr) throw uErr;
+  } catch (e) {
+    // Undo the "paid" mark so a retry (or the webhook) can grant it.
+    await supabase.from('pro_payments').update({ status: 'created', paid_at: null })
+      .eq('razorpay_order_id', orderId);
+    throw e;
+  }
+  return { found: true, granted: true, row };
