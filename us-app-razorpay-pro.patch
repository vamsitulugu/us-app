diff --git a/lib/pro-plans.js b/lib/pro-plans.js
new file mode 100644
index 0000000..cc7b698
--- /dev/null
+++ b/lib/pro-plans.js
@@ -0,0 +1,47 @@
+// ════════════════════════════════════════════════════════════════
+//  lib/pro-plans.js — Pro plans + entitlement maths (pure, no I/O)
+//  The server is the ONLY place that decides prices and durations.
+//  The apps just send a plan id ('monthly' | 'yearly' | 'lifetime').
+// ════════════════════════════════════════════════════════════════
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+const PLANS = {
+  monthly:  { id: 'monthly',  label: 'Monthly',  amountPaise: 99 * 100,  days: 30,   rank: 1 },
+  yearly:   { id: 'yearly',   label: 'Yearly',   amountPaise: 499 * 100, days: 365,  rank: 2 },
+  lifetime: { id: 'lifetime', label: 'Lifetime', amountPaise: 999 * 100, days: null, rank: 3 }
+};
+
+function isValidPlan(id) {
+  return typeof id === 'string' && Object.prototype.hasOwnProperty.call(PLANS, id);
+}
+
+/** { isPro, plan, expiresAt } from a `couples` row's pro_* columns. */
+function statusFromCouple(couple, now = new Date()) {
+  if (!couple) return { isPro: false, plan: null, expiresAt: null };
+  if (couple.pro_plan === 'lifetime') return { isPro: true, plan: 'lifetime', expiresAt: null };
+  if ((couple.pro_plan === 'monthly' || couple.pro_plan === 'yearly') && couple.pro_expires_at &&
+      new Date(couple.pro_expires_at) > now) {
+    return { isPro: true, plan: couple.pro_plan, expiresAt: new Date(couple.pro_expires_at).toISOString() };
+  }
+  return { isPro: false, plan: null, expiresAt: null };
+}
+
+/**
+ * The couple's new pro_* values after paying for `planId`.
+ *  - Paying while still active EXTENDS from the current expiry (no lost days).
+ *  - A lower plan never replaces a higher one that is still active.
+ *  - Lifetime never expires and can never be downgraded.
+ */
+function applyPurchase(couple, planId, now = new Date()) {
+  const plan = PLANS[planId];
+  if (!plan) throw new Error('Unknown plan');
+  const cur = statusFromCouple(couple, now);
+  if (cur.plan === 'lifetime') return { pro_plan: 'lifetime', pro_expires_at: null };
+  if (plan.id === 'lifetime') return { pro_plan: 'lifetime', pro_expires_at: null };
+  const base = cur.isPro && cur.expiresAt ? new Date(cur.expiresAt) : now;
+  const expires = new Date(base.getTime() + plan.days * DAY_MS).toISOString();
+  const keepPlan = cur.isPro && PLANS[cur.plan].rank > plan.rank ? cur.plan : plan.id;
+  return { pro_plan: keepPlan, pro_expires_at: expires };
+}
+
+module.exports = { PLANS, DAY_MS, isValidPlan, statusFromCouple, applyPurchase };
diff --git a/lib/razorpay.js b/lib/razorpay.js
new file mode 100644
index 0000000..0d2adc4
--- /dev/null
+++ b/lib/razorpay.js
@@ -0,0 +1,68 @@
+// ════════════════════════════════════════════════════════════════
+//  lib/razorpay.js — tiny Razorpay client (no SDK dependency)
+//  Env vars (set on Render, never commit them):
+//    RAZORPAY_KEY_ID          rzp_test_xxx / rzp_live_xxx   (public)
+//    RAZORPAY_KEY_SECRET      secret — signs/verifies payments
+//    RAZORPAY_WEBHOOK_SECRET  secret you type in the Razorpay dashboard
+// ════════════════════════════════════════════════════════════════
+const https = require('https');
+const crypto = require('crypto');
+
+const keyId = () => process.env.RAZORPAY_KEY_ID || '';
+const keySecret = () => process.env.RAZORPAY_KEY_SECRET || '';
+const webhookSecret = () => process.env.RAZORPAY_WEBHOOK_SECRET || '';
+
+function isConfigured() { return !!(keyId() && keySecret()); }
+
+function safeEqualHex(a, b) {
+  try {
+    const x = Buffer.from(String(a || ''), 'hex');
+    const y = Buffer.from(String(b || ''), 'hex');
+    return x.length > 0 && x.length === y.length && crypto.timingSafeEqual(x, y);
+  } catch (e) { return false; }
+}
+
+/** Razorpay Orders API: POST /v1/orders */
+function createOrder({ amountPaise, receipt, notes }) {
+  return new Promise((resolve, reject) => {
+    const body = JSON.stringify({ amount: amountPaise, currency: 'INR', receipt, notes: notes || {} });
+    const req = https.request({
+      hostname: 'api.razorpay.com',
+      path: '/v1/orders',
+      method: 'POST',
+      auth: `${keyId()}:${keySecret()}`,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) },
+      timeout: 15000
+    }, (res) => {
+      let data = '';
+      res.on('data', (c) => { data += c; });
+      res.on('end', () => {
+        let json = null;
+        try { json = JSON.parse(data); } catch (e) { /* non-JSON error page */ }
+        if (res.statusCode >= 200 && res.statusCode < 300 && json && json.id) return resolve(json);
+        const msg = (json && json.error && json.error.description) || `Razorpay error ${res.statusCode}`;
+        reject(new Error(msg));
+      });
+    });
+    req.on('timeout', () => req.destroy(new Error('Razorpay request timed out')));
+    req.on('error', reject);
+    req.write(body);
+    req.end();
+  });
+}
+
+/** Checkout signature: HMAC_SHA256(order_id + "|" + payment_id, key_secret) */
+function verifyPaymentSignature(orderId, paymentId, signature) {
+  if (!orderId || !paymentId || !signature || !keySecret()) return false;
+  const expected = crypto.createHmac('sha256', keySecret()).update(`${orderId}|${paymentId}`).digest('hex');
+  return safeEqualHex(expected, signature);
+}
+
+/** Webhook signature: HMAC_SHA256(raw request body, webhook_secret) */
+function verifyWebhookSignature(rawBody, signature) {
+  if (!rawBody || !signature || !webhookSecret()) return false;
+  const expected = crypto.createHmac('sha256', webhookSecret()).update(rawBody).digest('hex');
+  return safeEqualHex(expected, signature);
+}
+
+module.exports = { keyId, isConfigured, createOrder, verifyPaymentSignature, verifyWebhookSignature };
diff --git a/middleware/pro.js b/middleware/pro.js
new file mode 100644
index 0000000..3095ab1
--- /dev/null
+++ b/middleware/pro.js
@@ -0,0 +1,52 @@
+// ════════════════════════════════════════════════════════════════
+//  middleware/pro.js — Pro lookups + server-side feature gate
+//  The apps hide Pro features for free couples, but the server is what
+//  really enforces it: requirePro() answers 402 when the couple is not Pro.
+// ════════════════════════════════════════════════════════════════
+const supabase = require('./supabase');
+const { statusFromCouple } = require('../lib/pro-plans');
+
+/** { isPro, plan, expiresAt } for a couple. Throws on a database error. */
+async function getProStatus(coupleId) {
+  const { data, error } = await supabase
+    .from('couples').select('id, pro_plan, pro_expires_at').eq('id', coupleId).maybeSingle();
+  if (error) throw error;
+  return statusFromCouple(data);
+}
+
+/**
+ * Express middleware. `pick(req)` returns the coupleId for this request.
+ * Missing coupleId → 400. Not Pro → 402 { code: 'PRO_REQUIRED' }.
+ * If Pro cannot be checked (database down) → 503, so a free couple is
+ * never let through by accident and a Pro couple just retries.
+ */
+function requirePro(pick) {
+  return async (req, res, next) => {
+    try {
+      const coupleId = pick(req);
+      if (!coupleId) return res.status(400).json({ error: 'coupleId required' });
+      const st = await getProStatus(coupleId);
+      if (!st.isPro) {
+        return res.status(402).json({ error: 'This is a Pro feature.', code: 'PRO_REQUIRED' });
+      }
+      next();
+    } catch (e) {
+      console.error('[pro] gate check failed:', e.message);
+      res.status(503).json({ error: 'Could not verify Pro right now. Please try again.' });
+    }
+  };
+}
+
+/** The signed-in user (x-user-id header, or userId in body/query) must belong to this couple. */
+async function loadMember(req, coupleId) {
+  const userId = req.get('x-user-id') || (req.body && req.body.userId) || (req.query && req.query.userId);
+  if (!userId || !coupleId) return null;
+  const { data: user, error } = await supabase
+    .from('users').select('id, name, phone_number, couple_id, account_status').eq('id', userId).maybeSingle();
+  if (error || !user) return null;
+  if (user.account_status === 'suspended' || user.account_status === 'disabled') return null;
+  if (!user.couple_id || String(user.couple_id) !== String(coupleId)) return null;
+  return user;
+}
+
+module.exports = { getProStatus, requirePro, loadMember };
diff --git a/migrations/pro_razorpay.sql b/migrations/pro_razorpay.sql
new file mode 100644
index 0000000..29bde48
--- /dev/null
+++ b/migrations/pro_razorpay.sql
@@ -0,0 +1,44 @@
+-- ════════════════════════════════════════════════════════════════
+--  Pro via Razorpay — Twin Hearts
+--  Run in the Supabase SQL editor BEFORE deploying the backend.
+--  Safe to run more than once. Builds on migrations/pro_subscription.sql
+--  (the pro_* columns on `couples`).
+--
+--  Plans (prices live in lib/pro-plans.js, never in the browser):
+--    monthly  ₹99   → 30 days, one-time payment (no auto-renew)
+--    yearly   ₹499  → 365 days, one-time payment
+--    lifetime ₹999  → never expires
+-- ════════════════════════════════════════════════════════════════
+
+-- 'yearly' is a new plan value, so widen the old CHECK constraint.
+alter table couples drop constraint if exists couples_pro_plan_check;
+alter table couples add constraint couples_pro_plan_check
+  check (pro_plan is null or pro_plan in ('monthly','yearly','lifetime'));
+
+-- One row per Razorpay order. Pro is only granted when a row flips
+-- from 'created' to 'paid' after the payment signature is verified.
+create table if not exists pro_payments (
+  id                   uuid primary key default gen_random_uuid(),
+  couple_id            text not null,
+  user_id              text,
+  plan                 text not null check (plan in ('monthly','yearly','lifetime')),
+  amount_paise         integer not null,
+  currency             text not null default 'INR',
+  status               text not null default 'created' check (status in ('created','paid','failed')),
+  razorpay_order_id    text not null unique,
+  razorpay_payment_id  text,
+  source               text,               -- 'verify' (app/web) or 'webhook'
+  created_at           timestamptz not null default now(),
+  paid_at              timestamptz
+);
+
+create index if not exists idx_pro_payments_couple on pro_payments(couple_id, created_at desc);
+create index if not exists idx_pro_payments_status on pro_payments(status);
+
+-- Block direct browser access; only the Express API (service role) reads/writes.
+alter table pro_payments enable row level security;
+drop policy if exists "no_direct_access_pro_payments" on pro_payments;
+create policy "no_direct_access_pro_payments" on pro_payments
+  for all to anon, authenticated using (false) with check (false);
+
+comment on table pro_payments is 'Razorpay orders/payments for Pro (verified server-side)';
