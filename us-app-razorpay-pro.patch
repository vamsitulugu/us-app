+  @keyframes sh { to { background-position: -200% 0; } }
+</style>
+</head>
+<body>
+<div class="wrap" id="wrap">
+  <div class="hero">
+    <div class="gem">💎</div>
+    <h1>Twin Hearts Pro</h1>
+    <p>One payment unlocks Pro for both of you. Everything else in the app stays free.</p>
+  </div>
+
+  <div class="card status" id="statusCard"><div class="skel" style="flex:1"></div></div>
+
+  <div class="eyebrow">Choose your plan</div>
+  <div class="plans" id="plans"></div>
+  <div class="err" id="err"></div>
+  <div class="secure">🔒 Payments are processed securely by Razorpay — UPI, cards, netbanking &amp; wallets.<br>Monthly and Yearly are one-time payments: nothing renews automatically.</div>
+
+  <div class="eyebrow">What Pro unlocks</div>
+  <div class="feat">
+    <div class="f"><span class="i">🤖</span><div><h4>Twin AI — Both mode</h4><p>Answer separately, get one shared result from Twin AI.</p></div></div>
+    <div class="f"><span class="i">🌍</span><div><h4>Memory Globe — Pin a memory</h4><p>Pin trips, dates and moments on your shared globe.</p></div></div>
+    <div class="f"><span class="i">🎵</span><div><h4>Music — Add songs</h4><p>Build your own shared library and playlists.</p></div></div>
+    <div class="f"><span class="i">🎬</span><div><h4>Watch Together — Cloud upload</h4><p>Upload a movie once and stream it in sync for both.</p></div></div>
+  </div>
+  <p class="free">Chat, calls, Live Map, Vault, Calendar and the rest stay free. Existing memories, songs and movies are never deleted if Pro ends.</p>
+
+  <div id="histWrap" style="display:none">
+    <div class="eyebrow">Payment history</div>
+    <div class="card"><table class="hist" id="hist"></table></div>
+  </div>
+
+  <div class="eyebrow">Questions</div>
+  <div class="card">
+    <details><summary>Do both of us need to pay?</summary><p>No. Pro belongs to your couple — when either of you pays, both get it.</p></details>
+    <details><summary>What happens when Monthly or Yearly ends?</summary><p>Pro features lock again; nothing is deleted. Buy again any time — days are added on top of what's left.</p></details>
+    <details><summary>I paid but Pro isn't showing</summary><p>It usually appears within a minute. Tap “Refresh status” above; if it still doesn't show, contact support from Settings and share your payment ID.</p></details>
+  </div>
+</div>
+
+<script src="/js/pro-card.js"></script>
+<script>
+(function () {
+  var $ = function (id) { return document.getElementById(id); };
+  var busy = false;
+  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+  function fmtDate(iso) { try { return new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }); } catch (e) { return ''; } }
+
+  function renderPlans(st) {
+    var lifetime = st && st.isPro && st.plan === 'lifetime';
+    $('plans').innerHTML = ProCard.PLANS.map(function (p) {
+      var label = lifetime ? 'You have Lifetime' : (st && st.isPro && p.id !== 'lifetime' ? 'Extend with ' + p.label : 'Get ' + p.label);
+      return '<div class="plan' + (p.id === 'yearly' ? ' best' : '') + '">' +
+        (p.badge ? '<span class="tag">' + esc(p.badge) + '</span>' : '') +
+        '<h3>' + esc(p.label) + '</h3><div class="price">₹' + p.price + '</div><div class="per">' + esc(p.per) + '</div>' +
+        '<div class="note">' + esc(p.note) + '</div>' +
+        '<button class="btn" data-plan="' + p.id + '"' + (lifetime ? ' disabled' : '') + '>' + esc(label) + '</button></div>';
+    }).join('');
+  }
+
+  function renderStatus(st) {
+    var c = $('statusCard');
+    if (st && st.isPro) {
+      c.className = 'card status pro';
+      var line = st.plan === 'lifetime' ? 'Lifetime — never expires' : (st.plan === 'yearly' ? 'Yearly' : 'Monthly') + ' · active until ' + fmtDate(st.expiresAt);
+      c.innerHTML = '<div class="dot">✅</div><div style="flex:1"><h3>Pro is active for you both</h3><p>' + esc(line) + '</p></div>';
+    } else {
+      c.className = 'card status';
+      c.innerHTML = '<div class="dot">🔓</div><div style="flex:1"><h3>You\'re on the free plan</h3><p>Pick a plan below to unlock Pro.</p></div>' +
+        '<button class="btn ghost" id="refresh" style="width:auto;padding:9px 14px">Refresh status</button>';
+      var r = $('refresh'); if (r) r.onclick = function () { load(true); };
+    }
+    renderPlans(st);
+  }
+
+  async function loadHistory() {
+    try {
+      var s = ProCard.session(); if (!s) return;
+      var d = await ProCard.call('GET', '/api/pro/history?coupleId=' + encodeURIComponent(s.coupleId));
+      if (!d.payments || !d.payments.length) { $('histWrap').style.display = 'none'; return; }
+      $('histWrap').style.display = '';
+      $('hist').innerHTML = d.payments.map(function (p) {
+        return '<tr><td>' + esc(p.plan.charAt(0).toUpperCase() + p.plan.slice(1)) + '<br><span style="font-size:11px;color:var(--t3)">' + esc(fmtDate(p.paidAt)) + ' · ' + esc(p.paymentId || '') + '</span></td><td>₹' + esc(p.amount) + '</td></tr>';
+      }).join('');
+    } catch (e) { /* history is optional */ }
+  }
+
+  async function load(force) {
+    $('err').textContent = '';
+    try { renderStatus(await ProCard.status(!!force)); }
+    catch (e) { renderStatus({ isPro: false }); $('err').textContent = 'Could not check your Pro status. Check your internet and tap Refresh.'; }
+    loadHistory();
+  }
+
+  $('plans').addEventListener('click', async function (e) {
+    var b = e.target.closest('button[data-plan]'); if (!b || busy || b.disabled) return;
+    busy = true; $('err').textContent = ''; var old = b.textContent; b.textContent = 'Opening secure payment…'; b.disabled = true;
+    try {
+      var r = await ProCard.pay(b.getAttribute('data-plan'));
+      if (r.ok) { $('err').className = 'err ok'; $('err').textContent = '🎉 You\'re Pro! Thank you.'; renderStatus(r.status); loadHistory(); }
+    } catch (err) { $('err').className = 'err'; $('err').textContent = err.message; }
+    busy = false; b.textContent = old; b.disabled = false;
+  });
+
+  ProCard.onChange(function (st) { renderStatus(st); loadHistory(); });
+  renderPlans(null);
+  load(true);
+})();
+</script>
+</body>
+</html>
